---
// Client-side tool finder. Tool list comes from tools.js at build time; matching strips Vietnamese
// diacritics (NFD + remove U+0300–U+036F, đ→d) so "tien dien" finds "Tính tiền điện".
import { TOOLS, toolUrl, getTool, marketBadge } from '../data/tools.js';

interface Props { lang?: 'vi' | 'en'; popular?: string[]; id?: string; }
const { lang = 'vi', popular, id = 'tool-search' } = Astro.props;
const vi = lang === 'vi';
const defaultPop = vi
  ? ['portfolio', 'documents', 'compress', 'salary', 'pitannual', 'lunar', 'electric', 'qr']
  : ['portfolio', 'documents', 'compress', 'fire', 'mortgage', 'loan', 'bmi', 'gpa'];
const popList = (popular && popular.length ? popular : defaultPop).filter((p) => getTool(p));
const fold = (s: string) => String(s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'D').toLowerCase();

const items = TOOLS.map((tl: any) => {
  const b = marketBadge(tl, lang);
  const rank = popList.indexOf(tl.id);
  const marketPenalty = !vi && tl.market === 'vn' ? 500 : vi && tl.market === 'intl' ? 200 : 0;
  return {
    id: tl.id,
    href: toolUrl(tl, lang),
    icon: tl.icon,
    title: tl.title[lang],
    desc: tl.desc?.[lang] || '',
    badgeLabel: b.label,
    badgeCls: b.cls,
    key: fold([tl.title.vi, tl.title.en, tl.seo?.vi, tl.seo?.en, tl.desc?.vi, tl.desc?.en, tl.slug?.vi, tl.slug?.en].join(' ').replace(/-/g, ' ')),
    rank,
    sortScore: (rank < 0 ? 100 : rank) + marketPenalty
  };
}).sort((a, b) => a.sortScore - b.sortScore);
---
<div class="tool-search" data-tool-search>
  <label for={id} class="label">{vi ? '🔍 Tìm kiếm nhanh trong 40+ công cụ (Việt Nam & Quốc tế)' : '🔍 Search 40+ Global & Regional Tools'}</label>
  <input id={id} type="search" class="input" autocomplete="off" enterkeyhint="search"
    placeholder={vi ? 'Gõ từ khóa: portfolio, cv, ảnh thẻ, lương, thuế, lịch âm, vay…' : 'Type a keyword: portfolio, resume, id photo, fire, mortgage, bmi, gpa…'} aria-controls={`${id}-list`} />
  <p class="mt-2 text-xs text-slate-500" data-ts-status aria-live="polite">{vi ? '🔥 Công cụ nổi bật được dùng nhiều nhất' : '🔥 Most popular global studios & calculators'}</p>
  <ul id={`${id}-list`} class="mt-2 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
    {items.map((it) => (
      <li data-k={it.key} data-pop={it.rank >= 0 ? '1' : undefined} hidden={it.rank < 0}>
        <a href={it.href} class="flex min-h-11 items-start gap-3 rounded-xl border border-slate-200 bg-white px-3 py-2.5 transition hover:border-brand-400 hover:shadow-xs">
          <span class="mt-0.5 text-xl" aria-hidden="true">{it.icon}</span>
          <span class="min-w-0 flex-1">
            <span class={`mb-0.5 inline-block rounded-full px-1.5 py-0.2 text-[9px] font-bold ${it.badgeCls}`}>{it.badgeLabel}</span>
            <span class="block truncate font-semibold text-slate-900">{it.title}</span>
            <span class="block truncate text-xs text-slate-500">{it.desc}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
  <p class="mt-2 text-sm text-slate-500" data-ts-empty hidden>{vi ? 'Không tìm thấy công cụ phù hợp.' : 'No matching tool.'}</p>
</div>

<script>
  const fold = (s: string) => String(s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'D').toLowerCase();
  document.querySelectorAll<HTMLElement>('[data-tool-search]').forEach((root) => {
    const input = root.querySelector('input')!;
    const items = Array.from(root.querySelectorAll<HTMLLIElement>('li[data-k]'));
    const empty = root.querySelector<HTMLElement>('[data-ts-empty]')!;
    const status = root.querySelector<HTMLElement>('[data-ts-status]')!;
    const popLabel = status.textContent || '';
    const vi = document.documentElement.lang !== 'en';
    const MAX = 12;
    const run = () => {
      const words = fold(input.value).trim().slice(0, 80).split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const li of items) {
        const ok = words.length ? words.every((w) => (li.dataset.k || '').includes(w)) : li.dataset.pop === '1';
        const show = ok && shown < MAX;
        li.hidden = !show;
        if (show) shown++;
      }
      empty.hidden = shown > 0;
      status.textContent = words.length ? (vi ? `${shown} kết quả` : `${shown} result${shown === 1 ? '' : 's'}`) : popLabel;
    };
    input.addEventListener('input', run);
    if (input.value) run();
  });
</script>
