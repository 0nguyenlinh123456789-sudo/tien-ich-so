---
/**
 * DonateBox – voluntary support via a static VietQR code (no fees, no sign-up, no third party).
 * Renders nothing until monetization.json -> donate.account is filled in.
 */
import { donateInfo, donateUrl } from '../lib/monetize.js';
interface Props { lang?: 'vi' | 'en'; compact?: boolean; }
const { lang = 'vi', compact = true } = Astro.props;
const d = donateInfo();
const ext = donateUrl();
const vi = lang === 'vi';
const fmt = (n: number) => n.toLocaleString('vi-VN') + 'đ';
---
{(d || ext) && (
  <div class="mt-4 rounded-2xl border border-amber-200 bg-amber-50 p-5" data-donate>
    <div class="flex flex-wrap items-start gap-4">
      {d && (
        <div class="w-28 shrink-0 rounded-xl bg-white p-1.5 shadow-sm" data-donate-qr set:html={d.svg} />
      )}
      <div class="min-w-0 flex-1">
        <div class="font-semibold text-slate-900">☕ {vi ? 'Ủng hộ để web luôn miễn phí' : 'Support this free site'}</div>
        <p class="mt-1 text-sm text-slate-600">
          {vi
            ? 'Mọi công cụ ở đây miễn phí và không có quảng cáo bật lên. Một ly cà phê giúp trang duy trì và cập nhật số liệu pháp luật mới.'
            : 'Every tool here is free with no pop-ups. A coffee keeps the site running and its legal data current.'}
        </p>
        {d && (
          <div class="mt-2 text-sm text-slate-700">
            <div><span class="text-slate-500">{vi ? 'Ngân hàng' : 'Bank'}:</span> <b>{d.bankName}</b></div>
            <div><span class="text-slate-500">{vi ? 'Số TK' : 'Account'}:</span> <b class="select-all">{d.account}</b>{d.name && <> · {d.name}</>}</div>
            <div class="text-xs text-slate-500">{vi ? 'Nội dung' : 'Memo'}: {d.memo}</div>
          </div>
        )}
        <div class="mt-3 flex flex-wrap gap-2">
          {d && d.amountSvgs.map((a) => (
            <button type="button" class="btn-ghost py-1.5 text-sm" data-donate-amount data-svg={a.svg}>{fmt(a.amount)}</button>
          ))}
          {ext && <a class="btn-ghost py-1.5 text-sm" href={ext} target="_blank" rel="noopener nofollow">{vi ? 'Ủng hộ qua thẻ / PayPal' : 'Card / PayPal'}</a>}
          {!compact && <a class="btn-ghost py-1.5 text-sm" href={vi ? '/ung-ho' : '/en/support'}>{vi ? 'Xem trang ủng hộ' : 'Support page'}</a>}
        </div>
      </div>
    </div>
  </div>
)}

<script>
  // Tapping an amount swaps in the QR that already carries that amount (VietQR dynamic code).
  document.querySelectorAll<HTMLElement>('[data-donate]').forEach((box) => {
    const qr = box.querySelector<HTMLElement>('[data-donate-qr]');
    box.querySelectorAll<HTMLButtonElement>('[data-donate-amount]').forEach((b) => {
      b.addEventListener('click', () => {
        if (qr && b.dataset.svg) qr.innerHTML = b.dataset.svg; // build-time SVG from our own config, not user input
        box.querySelectorAll('[data-donate-amount]').forEach((x) => x.classList.remove('ring-2', 'ring-amber-400'));
        b.classList.add('ring-2', 'ring-amber-400');
      });
    });
  });
</script>
