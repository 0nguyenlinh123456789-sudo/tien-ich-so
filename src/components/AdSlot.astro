---
// In-content display ad slot. Paste the network's banner HTML into monetization.json -> inContentAdHtml.
import { MONETIZATION } from '../lib/monetize.js';
import { t } from '../i18n/ui.js';
interface Props { lang?: 'vi' | 'en'; }
const { lang = 'vi' } = Astro.props;
const html = (MONETIZATION.inContentAdHtml || '').trim();
---
{html && (
  <div class="my-6 text-center">
    <div class="mb-1 text-[10px] tracking-widest text-slate-400 uppercase">{t(lang).ad}</div>
    <div class="flex min-h-[100px] items-center justify-center overflow-hidden rounded-xl bg-slate-100" set:html={html} />
  </div>
)}

