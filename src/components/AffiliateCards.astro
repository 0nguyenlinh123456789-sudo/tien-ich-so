---
// Contextual affiliate offers – rendered at build time from src/config/monetization.json
import { offersFor } from '../lib/monetize.js';
import { TOOLS } from '../data/tools.js';
import { t } from '../i18n/ui.js';

interface Props { context: string; lang?: 'vi' | 'en'; limit?: number; tool?: string; }
const { context, lang = 'vi', limit = 2, tool } = Astro.props;
const path = Astro.url?.pathname || '';
const detectedTool = tool || TOOLS.find((tl: any) => path.includes(`/${tl.slug?.vi}`) || path.includes(`/${tl.slug?.en}`))?.id || null;
const offers = offersFor(context, lang, limit, detectedTool);
const L = t(lang);
---
{offers.length > 0 && (
  <aside class="my-5 grid gap-3 sm:grid-cols-2" aria-label={L.sponsored}>
    {offers.map((o: any) => (
      <a href={o.href} target="_blank" rel="sponsored noopener nofollow"
        class="group flex items-center gap-3.5 rounded-2xl border border-amber-200/90 bg-gradient-to-r from-amber-50/90 via-white to-orange-50/40 p-3.5 shadow-2xs transition hover:-translate-y-0.5 hover:border-amber-400 hover:shadow-md">
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-amber-100/80 text-2xl transition group-hover:scale-110">{o.icon}</span>
        <span class="min-w-0 flex-1">
          <span class="block truncate text-sm font-extrabold text-slate-900 group-hover:text-brand-700">{o.title}</span>
          <span class="mt-0.5 block truncate text-xs text-slate-500">{o.description}</span>
        </span>
        <span class="shrink-0 rounded-xl bg-amber-500/15 px-3 py-1.5 text-xs font-extrabold text-amber-900 transition group-hover:bg-amber-500 group-hover:text-white">{o.cta} →</span>
      </a>
    ))}
  </aside>
)}
