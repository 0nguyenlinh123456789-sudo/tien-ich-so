---
import Layout from '../layouts/Layout.astro';
import AffiliateCards from './AffiliateCards.astro';
import ToolSearch from './ToolSearch.astro';
import DonateBox from './DonateBox.astro';
import { TOOLS, primaryToolsIn, secondaryToolsIn, marketBadge, toolUrl, recordUrl, getTool, VN_ONLY_TOOL_IDS } from '../data/tools.js';
import { getAllRecords } from '../lib/routes.js';
import site from '../config/site.json';

interface Props { lang: 'vi' | 'en'; }
const { lang } = Astro.props;
const vi = lang === 'vi';

const allLangRecords = getAllRecords().filter((r) => r.lang === lang);
const latest = (vi
  ? allLangRecords
  : allLangRecords.filter((r) => !VN_ONLY_TOOL_IDS.has(r.tool))
).slice(-6).reverse();

const title = vi
  ? `Tạo Portfolio, CV 108 mẫu, Tính lương Gross Net, Lịch âm – ${site.siteName}`
  : `Portfolio Builder, 108-Style CV, FIRE & Everyday Calculators – ${site.siteNameEn}`;
const description = vi
  ? 'Hệ sinh thái tiện ích 1 chạm: Tạo Portfolio 108 mẫu tự dàn trang, CV & Hợp đồng 108 mẫu, Ảnh thẻ 3×4 AI, Lương Gross Net 2026, Thuế TNCN, BHXH, Lịch âm.'
  : '1-click visual studios & calculators: 108-template Portfolio Builder, 108-layout Resume/CV & Contracts, ID Photo AI studio, US Mortgage, FIRE, BMI & GPA.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: vi ? site.siteName : site.siteNameEn, url: site.siteUrl };

const salaryUrl = toolUrl(getTool('salary'), lang);
const fireUrl = toolUrl(getTool('fire'), lang);
const portfolioUrl = toolUrl(getTool('portfolio'), lang);
const cvUrl = toolUrl(getTool('documents'), lang);
const photoUrl = toolUrl(getTool('compress'), lang);

// Curated visual personas so lazy readers see only what matches their taste (9 cards default instead of 50+)
const PERSONAS_VI = [
  { id: 'top', icon: '🔥', label: 'Nổi bật nhất', tools: ['portfolio', 'documents', 'compress', 'salary', 'loan', 'lunar', 'qr', 'pitannual', 'tarot'] },
  { id: 'studio', icon: '🎨', label: 'Hồ sơ, CV & Sáng tạo', tools: ['portfolio', 'documents', 'compress', 'qr', 'forms', 'moneywords', 'textcount'] },
  { id: 'career', icon: '💵', label: 'Lương, Thuế & BHXH', tools: ['salary', 'pitannual', 'lumpsum', 'pension', 'maternity', 'severance', 'hkd', 'vat'] },
  { id: 'wealth', icon: '🏦', label: 'Vay, Tiết kiệm & Đầu tư', tools: ['loan', 'savings', 'fire', 'fx', 'truocba', 'mortgage'] },
  { id: 'life', icon: '🌙', label: 'Lịch âm, Tarot & Đời sống', tools: ['lunar', 'goodday', 'numerology', 'tarot', 'electric', 'water', 'bmi', 'address', 'countdown'] },
  { id: 'intl', icon: '🌍', label: 'Quốc tế (US / Global)', tools: ['gpa', 'ielts', 'mortgage', 'tip', 'convert', 'fx', 'datediff', 'age', 'pregnancy', 'percent'] }
];

const PERSONAS_EN = [
  { id: 'top', icon: '🔥', label: 'Top Picks', tools: ['portfolio', 'documents', 'compress', 'fire', 'mortgage', 'loan', 'qr', 'bmi', 'tarot'] },
  { id: 'studio', icon: '🎨', label: 'Portfolio, CV & Studio', tools: ['portfolio', 'documents', 'compress', 'qr', 'forms', 'moneywords', 'textcount'] },
  { id: 'wealth', icon: '💰', label: 'Wealth, Mortgage & FIRE', tools: ['fire', 'mortgage', 'loan', 'savings', 'fx', 'vat'] },
  { id: 'life', icon: '🌿', label: 'Health, Study & Units', tools: ['bmi', 'pregnancy', 'gpa', 'ielts', 'convert', 'tip', 'datediff', 'age', 'countdown', 'percent'] },
  { id: 'destiny', icon: '🔮', label: 'Tarot & Numerology', tools: ['numerology', 'tarot', 'goodday'] }
];

const personas = vi ? PERSONAS_VI : PERSONAS_EN;
const defaultSet = new Set(personas[0].tools);

// Micro-highlights (max 2-3 words) for instant visual scanning
const quickTagVi: Record<string, string> = {
  portfolio: '108 mẫu · Tự xếp SP',
  documents: '108 CV · Hợp đồng',
  compress: 'Đổi nền AI · Ép KB',
  salary: 'Luật mới 2026',
  pitannual: 'Hoàn thuế & Tết',
  lumpsum: 'Luật BHXH 2024',
  loan: 'Lịch trả góp',
  savings: 'Lãi đơn & kép',
  fire: 'Tự do tài chính',
  lunar: 'Âm dương · Giờ tốt',
  goodday: 'Cưới hỏi · Khai trương',
  qr: 'VietQR · WiFi · Link',
  tarot: '78 lá · 1 chạm',
  numerology: 'Pitago ngày sinh',
  electric: '6 bậc EVN',
  bmi: 'Chuẩn châu Á'
};
const quickTagEn: Record<string, string> = {
  portfolio: '108 Styles · AI Grid',
  documents: '108 CVs · Contracts',
  compress: 'AI Backdrop · Exact KB',
  fire: '4% Rule & Growth',
  mortgage: 'US PITI & PMI',
  loan: 'Amortization',
  savings: 'Compound Yield',
  qr: 'SVG & PNG Instant',
  tarot: '78-Card Spread',
  numerology: 'Life Path Chart',
  bmi: 'BMI & Daily TDEE',
  gpa: '4.0 Scale'
};

// Build deduplicated list of tools with persona memberships
const allToolsList = TOOLS.map((tl) => {
  const cats = personas.filter((p) => p.tools.includes(tl.id)).map((p) => p.id);
  if (!cats.length) cats.push(vi ? 'life' : 'life');
  const tag = (vi ? quickTagVi[tl.id] : quickTagEn[tl.id]) || marketBadge(tl, lang).label;
  return {
    ...tl,
    href: toolUrl(tl, lang),
    cats: cats.join(' '),
    isTop: defaultSet.has(tl.id),
    tag
  };
});
---
<Layout title={title} description={description} lang={lang} alternate={vi ? '/en' : '/'} jsonLd={jsonLd}>
  <!-- COMPACT VISUAL HERO: Zero walls of text, instant action -->
  <section class="relative overflow-hidden rounded-[2rem] bg-slate-950 px-6 py-8 text-white md:px-10 md:py-11">
    <div class="pointer-events-none absolute -top-32 -right-24 h-96 w-96 rounded-full bg-brand-500/35 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-40 -left-20 h-96 w-96 rounded-full bg-violet-600/25 blur-3xl"></div>

    <div class="relative grid items-center gap-8 lg:grid-cols-[1.1fr_1fr]">
      <div>
        <div class="inline-flex flex-wrap items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs font-semibold text-white/85">
          <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
          <span>{vi ? '⚡ Chọn 1 chạm · Không đăng ký · Tải file ngay' : '⚡ 1-Click Studio · No Sign-up · Instant Export'}</span>
        </div>

        <h1 class="mt-4 text-3xl leading-[1.12] font-black tracking-tight text-white md:text-5xl">
          {vi
            ? <>Hồ sơ <span class="bg-gradient-to-r from-amber-300 via-rose-300 to-sky-300 bg-clip-text text-transparent">Độc Bản 108 Mẫu</span> & Tính Nhanh 10 Giây.</>
            : <>108 Bespoke <span class="bg-gradient-to-r from-amber-300 via-rose-300 to-sky-300 bg-clip-text text-transparent">Portfolios, CVs</span> & Smart Calculators.</>}
        </h1>

        <!-- 3 Visual Flagship Cards (Icon + Bold Name + 3-word badge) -->
        <div class="mt-6 grid gap-3 sm:grid-cols-3">
          <a href={portfolioUrl} data-track-tool="portfolio" data-track-cat="studio" class="group relative overflow-hidden rounded-2xl border border-amber-400/40 bg-gradient-to-br from-amber-500/25 to-rose-500/10 p-4 transition hover:-translate-y-1 hover:border-amber-300 hover:shadow-xl hover:shadow-amber-500/20">
            <div class="flex items-center justify-between">
              <span class="text-2xl">🎨</span>
              <span class="rounded-full bg-amber-400/25 px-2 py-0.5 text-[10px] font-extrabold text-amber-200">108 {vi ? 'Mẫu' : 'Styles'}</span>
            </div>
            <div class="mt-2.5 text-base font-extrabold text-white group-hover:text-amber-200">{vi ? 'Tạo Portfolio' : 'Portfolio Studio'}</div>
            <div class="mt-0.5 text-xs font-medium text-white/70">{vi ? 'Tải ảnh tự dàn trang' : 'Auto-layout & Booking'}</div>
          </a>

          <a href={cvUrl} data-track-tool="documents" data-track-cat="studio" class="group relative overflow-hidden rounded-2xl border border-sky-400/40 bg-gradient-to-br from-sky-500/25 to-indigo-500/10 p-4 transition hover:-translate-y-1 hover:border-sky-300 hover:shadow-xl hover:shadow-sky-500/20">
            <div class="flex items-center justify-between">
              <span class="text-2xl">📄</span>
              <span class="rounded-full bg-sky-400/25 px-2 py-0.5 text-[10px] font-extrabold text-sky-200">108 {vi ? 'Mẫu' : 'Layouts'}</span>
            </div>
            <div class="mt-2.5 text-base font-extrabold text-white group-hover:text-sky-200">{vi ? 'CV & Hợp Đồng' : 'Resume & Contracts'}</div>
            <div class="mt-0.5 text-xs font-medium text-white/70">{vi ? 'Chuẩn ATS · Xuất PDF' : 'ATS PDF & Word'}</div>
          </a>

          <a href={photoUrl} data-track-tool="compress" data-track-cat="studio" class="group relative overflow-hidden rounded-2xl border border-emerald-400/40 bg-gradient-to-br from-emerald-500/25 to-teal-500/10 p-4 transition hover:-translate-y-1 hover:border-emerald-300 hover:shadow-xl hover:shadow-emerald-500/20">
            <div class="flex items-center justify-between">
              <span class="text-2xl">🪪</span>
              <span class="rounded-full bg-emerald-400/25 px-2 py-0.5 text-[10px] font-extrabold text-emerald-200">AI Studio</span>
            </div>
            <div class="mt-2.5 text-base font-extrabold text-white group-hover:text-emerald-200">{vi ? 'Ảnh Thẻ 3×4, 4×6' : 'ID Photo & KB'}</div>
            <div class="mt-0.5 text-xs font-medium text-white/70">{vi ? 'Đổi nền Trắng/Xanh' : 'White/Blue Backdrop'}</div>
          </a>
        </div>

        <!-- Minimal 1-line Search Bar inside Hero -->
        <div class="mt-5">
          <ToolSearch lang={lang} id="home-tool-search" />
        </div>
      </div>

      <!-- Right Column: Instant Live Calculator -->
      {vi ? (
        <form id="quick-salary" action={salaryUrl} class="rounded-3xl bg-white p-5 text-slate-800 shadow-2xl md:p-6" data-lang="vi">
          <input type="hidden" name="mode" value="gross" />
          <div class="flex items-center justify-between">
            <h2 class="text-base font-extrabold text-slate-900">💵 Lương Gross → Net 2026</h2>
            <span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-bold text-emerald-700">🇻🇳 Chuẩn mới</span>
          </div>
          <div class="mt-3 grid grid-cols-[1fr_auto] gap-2.5">
            <div>
              <label class="text-xs font-semibold text-slate-500" for="qs-amount">Lương Gross (VNĐ)</label>
              <input id="qs-amount" name="amount" inputmode="numeric" class="input mt-1 text-xl font-extrabold tabular-nums" value="25.000.000" autocomplete="off" />
            </div>
            <div>
              <label class="text-xs font-semibold text-slate-500" for="qs-dep">Người phụ thuộc</label>
              <div class="mt-1 flex items-center gap-1">
                <button type="button" data-step="-1" class="h-10 w-9 rounded-xl border border-slate-300 font-bold" aria-label="-">−</button>
                <input id="qs-dep" name="dependents" type="number" min="0" max="20" value="0" class="input w-12 px-1 text-center font-bold" />
                <button type="button" data-step="1" class="h-10 w-9 rounded-xl border border-slate-300 font-bold" aria-label="+">+</button>
              </div>
            </div>
          </div>
          <div class="mt-2 flex flex-wrap gap-1.5">
            {[15, 20, 25, 35, 50].map((m) => <button type="button" data-preset={m * 1e6} class="rounded-lg border border-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-600 hover:border-brand-500 hover:text-brand-700">{m} tr</button>)}
          </div>

          <div class="mt-4 rounded-2xl bg-slate-50 p-3.5">
            <div class="flex items-baseline justify-between">
              <span class="text-xs font-bold text-slate-500 uppercase">Thực nhận (Net)</span>
              <div id="qs-net" class="text-2xl font-black text-emerald-600 tabular-nums md:text-3xl">–</div>
            </div>
            <div class="mt-2.5 flex h-2 overflow-hidden rounded-full bg-slate-200" aria-hidden="true">
              <div id="qs-bar-net" class="bg-emerald-500 transition-all"></div>
              <div id="qs-bar-ins" class="bg-sky-400 transition-all"></div>
              <div id="qs-bar-tax" class="bg-rose-400 transition-all"></div>
            </div>
            <div class="mt-2 flex justify-between text-xs text-slate-600">
              <span>BHXH: <b id="qs-ins" class="text-slate-900 tabular-nums"></b></span>
              <span>Thuế TNCN: <b id="qs-tax" class="text-rose-600 tabular-nums"></b></span>
            </div>
          </div>
          <button class="btn-primary mt-3.5 w-full py-2.5 text-sm">Xem chi tiết bảng lương →</button>
        </form>
      ) : (
        <div id="quick-global-fire" class="rounded-3xl bg-white p-5 text-slate-800 shadow-2xl md:p-6">
          <div class="flex items-center justify-between">
            <h2 class="text-base font-extrabold text-slate-900">🔥 Compound Wealth & FIRE</h2>
            <span class="rounded-full bg-indigo-50 px-2.5 py-0.5 text-[11px] font-bold text-indigo-700">🌐 USD</span>
          </div>
          <div class="mt-3 grid grid-cols-2 gap-2.5">
            <div>
              <label class="text-xs font-semibold text-slate-500" for="qf-init">Initial ($)</label>
              <input id="qf-init" type="number" min="0" step="1000" class="input mt-1 font-bold tabular-nums" value="25000" />
            </div>
            <div>
              <label class="text-xs font-semibold text-slate-500" for="qf-mo">Monthly ($)</label>
              <input id="qf-mo" type="number" min="0" step="100" class="input mt-1 font-bold tabular-nums" value="1500" />
            </div>
            <div>
              <label class="text-xs font-semibold text-slate-500" for="qf-rate">Return (%)</label>
              <input id="qf-rate" type="number" min="1" max="30" step="0.5" class="input mt-1 font-semibold tabular-nums" value="9" />
            </div>
            <div>
              <label class="text-xs font-semibold text-slate-500" for="qf-yrs">Years</label>
              <input id="qf-yrs" type="number" min="1" max="50" step="1" class="input mt-1 font-semibold tabular-nums" value="20" />
            </div>
          </div>
          <div class="mt-3 rounded-2xl bg-slate-50 p-3.5">
            <div class="flex items-baseline justify-between">
              <span class="text-xs font-bold text-slate-500 uppercase">Projected Wealth</span>
              <div id="qf-total" class="text-2xl font-black text-emerald-600 tabular-nums md:text-3xl">$1,148,000</div>
            </div>
            <div class="mt-1.5 flex justify-between text-xs text-slate-600">
              <span>Gain: <b id="qf-gain" class="text-emerald-700 tabular-nums">+$763,000</b></span>
              <span>4% SWR: <b id="qf-swr" class="text-brand-700 tabular-nums">$3,826/mo</b></span>
            </div>
            <span id="qf-contrib" class="hidden"></span>
          </div>
          <div class="mt-3 grid grid-cols-2 gap-2">
            <a href={fireUrl} class="btn-primary py-2 text-center text-xs">Full FIRE Simulator →</a>
            <a href={toolUrl(getTool('mortgage'), 'en')} class="btn-ghost py-2 text-center text-xs">🏡 US Mortgage →</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- SMART PERSONALIZED STRIP (Auto-surfaces when client has interacted with tools) -->
  <section id="client-memory-bar" hidden class="mt-6 rounded-2xl border border-indigo-200/80 bg-gradient-to-r from-indigo-50/90 via-white to-amber-50/70 px-4 py-3 shadow-2xs">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2 text-xs font-extrabold text-indigo-950">
        <span class="rounded-full bg-indigo-600 px-2 py-0.5 text-[10px] text-white">✨ {vi ? 'ĐÚNG GU CỦA BẠN' : 'FOR YOU'}</span>
        <span>{vi ? 'Lối tắt các công cụ bạn vừa quan tâm:' : 'Quick access to your recent tools:'}</span>
      </div>
      <div id="client-memory-list" class="flex flex-wrap gap-2"></div>
    </div>
  </section>

  <!-- ONE SINGLE VISUAL STUDIO & TOOL EXPLORER (Replaces duplicate lists & walls of text) -->
  <section class="mt-8" data-taste-root>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <h2 class="text-xl font-black text-slate-900 md:text-2xl">
          {vi ? '🎯 Chọn đúng việc bạn cần' : '🎯 Pick what you need'}
        </h2>
        <span class="hidden rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600 sm:inline-block">
          {vi ? 'Tự động ghi nhớ sở thích của bạn' : 'Adapts to your preference'}
        </span>
      </div>

      <!-- Market Edition Quick Switch -->
      <a href={vi ? '/en' : '/'} class="rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-bold text-slate-600 transition hover:border-brand-400 hover:text-brand-700">
        {vi ? '🌐 Bản Quốc tế (English) →' : '🇻🇳 Bản Việt Nam →'}
      </a>
    </div>

    <!-- Visual Persona / Taste Pills -->
    <div class="mt-3 flex gap-2 overflow-x-auto pb-1" role="tablist">
      {personas.map((p, idx) => (
        <button
          type="button"
          data-taste-btn={p.id}
          class={idx === 0
            ? 'inline-flex shrink-0 items-center gap-1.5 rounded-2xl bg-slate-900 px-4 py-2.5 text-xs font-extrabold text-white shadow-sm transition'
            : 'inline-flex shrink-0 items-center gap-1.5 rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 transition hover:border-brand-400 hover:text-brand-700'}
        >
          <span class="text-base">{p.icon}</span>
          <span>{p.label}</span>
        </button>
      ))}
      <button
        type="button"
        data-taste-btn="all"
        class="inline-flex shrink-0 items-center gap-1.5 rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 transition hover:border-brand-400 hover:text-brand-700"
      >
        <span>⊞</span>
        <span>{vi ? `Tất cả (${allToolsList.length})` : `All (${allToolsList.length})`}</span>
      </button>
    </div>

    <!-- Clean Visual Bento Grid: Big Icon + Short Title + 3-word Tag (Zero Clutter) -->
    <div class="mt-5 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3" data-taste-grid>
      {allToolsList.map((tl) => (
        <a
          href={tl.href}
          data-tool-card={tl.id}
          data-tool-cats={tl.cats}
          data-tool-title={tl.title[lang]}
          data-tool-icon={tl.icon}
          hidden={!tl.isTop}
          class="group flex items-center gap-4 rounded-2xl border border-slate-200/90 bg-white p-4 shadow-2xs transition hover:-translate-y-0.5 hover:border-brand-400 hover:shadow-lg hover:shadow-brand-100/50"
        >
          <span class="grid h-13 w-13 shrink-0 place-items-center rounded-2xl bg-slate-100 text-2xl transition group-hover:scale-110 group-hover:bg-brand-50">
            {tl.icon}
          </span>
          <span class="min-w-0 flex-1">
            <span class="inline-block rounded-md bg-slate-100 px-2 py-0.5 text-[10px] font-extrabold text-slate-600 group-hover:bg-brand-50 group-hover:text-brand-700">
              {tl.tag}
            </span>
            <span class="mt-1 block truncate text-base font-extrabold text-slate-900 group-hover:text-brand-700">
              {tl.title[lang]}
            </span>
            <span class="block truncate text-xs text-slate-500">
              {tl.desc[lang]}
            </span>
          </span>
          <span class="text-lg font-bold text-slate-300 transition group-hover:translate-x-1 group-hover:text-brand-600">→</span>
        </a>
      ))}
    </div>

    <div class="mt-4 text-center" data-taste-more-wrap>
      <button type="button" data-taste-show-all class="rounded-full border border-slate-300 bg-white px-5 py-2 text-xs font-extrabold text-slate-700 shadow-2xs transition hover:border-brand-500 hover:text-brand-700">
        {vi ? `Xem toàn bộ ${allToolsList.length} công cụ ⌄` : `View all ${allToolsList.length} tools ⌄`}
      </button>
    </div>
  </section>

  <!-- SLEEK PARTNER DEALS (Limited to 2 visual cards so it's never spammy) -->
  <div class="mt-10">
    <AffiliateCards context="tools" lang={lang} limit={2} />
    <div class="mt-4 rounded-2xl border border-slate-200 bg-gradient-to-br from-slate-900 via-slate-900 to-indigo-950 p-4 text-white shadow-md">
      <div class="mb-2.5 flex flex-wrap items-center justify-between gap-2">
        <span class="inline-block rounded-full bg-amber-400/20 px-2.5 py-0.5 text-[10px] font-extrabold tracking-wider text-amber-300 uppercase">
          💎 {vi ? 'DỊCH VỤ VIP & HỢP TÁC 24/7' : '24/7 VIP STUDIO & SPONSORSHIP'}
        </span>
        <a href={vi ? '/ung-ho' : '/en/support'} class="text-xs font-extrabold text-amber-300 hover:underline">{vi ? 'Xem bảng giá & Quét QR →' : 'View pricing & QR →'}</a>
      </div>
      <div class="grid gap-2.5 sm:grid-cols-3">
        <a href={vi ? '/ung-ho' : '/en/support'} class="flex items-center justify-between rounded-xl border border-white/15 bg-white/5 p-3 transition hover:border-amber-300/60 hover:bg-white/10">
          <div><div class="text-xs font-extrabold text-white">🌐 {vi ? 'Gắn Tên Miền Riêng (.com/.vn)' : 'Custom Domain Setup'}</div><div class="text-[11px] text-white/70">{vi ? 'Đưa Portfolio lên web riêng + SSL' : 'Portfolio + Lifetime SSL'}</div></div>
          <span class="rounded-full bg-emerald-400/20 px-2.5 py-1 text-xs font-extrabold text-emerald-300">{vi ? '199k' : '$9'}</span>
        </a>
        <a href={vi ? '/ung-ho' : '/en/support'} class="flex items-center justify-between rounded-xl border border-white/15 bg-white/5 p-3 transition hover:border-amber-300/60 hover:bg-white/10">
          <div><div class="text-xs font-extrabold text-white">🎨 {vi ? 'Thiết Kế Portfolio + CV 1-1' : '1-on-1 Portfolio + Resume'}</div><div class="text-[11px] text-white/70">{vi ? 'Chỉnh độc bản chuẩn ATS & VietQR' : 'Bespoke ATS + Booking QR'}</div></div>
          <span class="rounded-full bg-emerald-400/20 px-2.5 py-1 text-xs font-extrabold text-emerald-300">{vi ? '499k' : '$22'}</span>
        </a>
        <a href={vi ? '/ung-ho' : '/en/support'} class="flex items-center justify-between rounded-xl border border-white/15 bg-white/5 p-3 transition hover:border-amber-300/60 hover:bg-white/10">
          <div><div class="text-xs font-extrabold text-white">📣 {vi ? 'Đặt Banner / Thẻ Tài Trợ' : 'Sponsored Placement'}</div><div class="text-[11px] text-white/70">{vi ? 'Quảng bá dịch vụ toàn trang' : 'Site-wide brand feature'}</div></div>
          <span class="rounded-full bg-emerald-400/20 px-2.5 py-1 text-xs font-extrabold text-emerald-300">{vi ? '990k' : '$45'}</span>
        </a>
      </div>
    </div>
    <DonateBox lang={lang} compact={false} />
  </div>

  {latest.length > 0 && (
    <section class="mt-8 border-t border-slate-200/70 pt-6">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-extrabold text-slate-500 uppercase">{vi ? 'Tra cứu nhanh:' : 'Quick lookups:'}</span>
        {latest.map((r) => <a href={recordUrl(r)} class="rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-600 transition hover:border-brand-300 hover:text-brand-700">{r.title}</a>)}
      </div>
    </section>
  )}
</Layout>

<script>
  import { grossToNet } from '../lib/salary.js';
  import { parseNum } from '../lib/format.js';

  // 1) Vietnamese Hero Salary Calculator
  const form = document.getElementById('quick-salary') as HTMLFormElement | null;
  if (form) {
    const amount = form.querySelector<HTMLInputElement>('#qs-amount')!;
    const dep = form.querySelector<HTMLInputElement>('#qs-dep')!;
    const $ = (id: string) => document.getElementById(id)!;
    const fmt = (n: number) => new Intl.NumberFormat('vi-VN').format(Math.round(n));
    const vnd = (n: number) => fmt(n) + ' đ';

    const run = () => {
      const gross = parseNum(amount.value);
      const r = grossToNet({ gross, dependents: Number(dep.value) || 0 });
      $('qs-net').textContent = gross ? vnd(r.net) : '–';
      $('qs-ins').textContent = vnd(r.insurance);
      $('qs-tax').textContent = vnd(r.pit);
      const pct = (x: number) => (gross ? (x / gross) * 100 : 0) + '%';
      $('qs-bar-net').style.width = pct(r.net);
      $('qs-bar-ins').style.width = pct(r.insurance);
      $('qs-bar-tax').style.width = pct(r.pit);
    };

    amount.addEventListener('input', () => {
      const raw = amount.value.replace(/\D/g, '');
      amount.value = raw ? fmt(Number(raw)) : '';
      run();
    });
    dep.addEventListener('input', run);
    form.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) =>
      b.addEventListener('click', () => { amount.value = fmt(Number(b.dataset.preset)); run(); }));
    form.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => { dep.value = String(Math.max(0, Math.min(20, (Number(dep.value) || 0) + Number(b.dataset.step)))); run(); }));
    form.addEventListener('submit', () => { amount.value = String(parseNum(amount.value)); });
    run();
  }

  // 2) Global English Hero Compound / FIRE Estimator (USD)
  const fireBox = document.getElementById('quick-global-fire');
  if (fireBox) {
    const initIn = fireBox.querySelector<HTMLInputElement>('#qf-init')!;
    const moIn = fireBox.querySelector<HTMLInputElement>('#qf-mo')!;
    const rateIn = fireBox.querySelector<HTMLInputElement>('#qf-rate')!;
    const yrsIn = fireBox.querySelector<HTMLInputElement>('#qf-yrs')!;
    const usd = (n: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(Math.round(n));
    const calcFire = () => {
      const init = Math.max(0, Number(initIn.value) || 0);
      const mo = Math.max(0, Number(moIn.value) || 0);
      const r = Math.max(0, Number(rateIn.value) || 0) / 100 / 12;
      const months = Math.max(1, Math.min(60, Number(yrsIn.value) || 20)) * 12;
      let bal = init;
      for (let i = 0; i < months; i++) bal = bal * (1 + r) + mo;
      const contrib = init + mo * months;
      const gain = Math.max(0, bal - contrib);
      const swrMo = (bal * 0.04) / 12;
      document.getElementById('qf-total')!.textContent = usd(bal);
      document.getElementById('qf-gain')!.textContent = '+' + usd(gain);
      document.getElementById('qf-swr')!.textContent = usd(swrMo) + '/mo';
    };
    [initIn, moIn, rateIn, yrsIn].forEach((el) => el.addEventListener('input', calcFire));
    calcFire();
  }

  // 3) Smart Client Preference & Taste Engine (remembers what the client likes & keeps UI clutter-free)
  const TASTE_KEY = 'tis_client_taste_v1';
  const RECENT_KEY = 'tis_recent_tools_v1';

  const root = document.querySelector<HTMLElement>('[data-taste-root]');
  if (root) {
    const btns = root.querySelectorAll<HTMLButtonElement>('[data-taste-btn]');
    const cards = root.querySelectorAll<HTMLAnchorElement>('[data-tool-card]');
    const moreWrap = root.querySelector<HTMLElement>('[data-taste-more-wrap]');
    const showAllBtn = root.querySelector<HTMLButtonElement>('[data-taste-show-all]');

    const applyTaste = (cat: string, save = true) => {
      btns.forEach((b) => {
        const active = b.dataset.tasteBtn === cat;
        b.className = active
          ? 'inline-flex shrink-0 items-center gap-1.5 rounded-2xl bg-slate-900 px-4 py-2.5 text-xs font-extrabold text-white shadow-sm transition'
          : 'inline-flex shrink-0 items-center gap-1.5 rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 transition hover:border-brand-400 hover:text-brand-700';
      });
      cards.forEach((c) => {
        const cats = (c.dataset.toolCats || '').split(' ');
        c.hidden = cat !== 'all' && !cats.includes(cat);
      });
      if (moreWrap) moreWrap.hidden = cat === 'all';
      if (save && cat !== 'all') {
        try { localStorage.setItem(TASTE_KEY, cat); } catch {}
      }
    };

    btns.forEach((btn) => {
      btn.addEventListener('click', () => applyTaste(btn.dataset.tasteBtn || 'top', true));
    });

    showAllBtn?.addEventListener('click', () => applyTaste('all', false));

    // Restore client's preferred category if previously chosen
    try {
      const savedTaste = localStorage.getItem(TASTE_KEY);
      if (savedTaste && Array.from(btns).some((b) => b.dataset.tasteBtn === savedTaste)) {
        applyTaste(savedTaste, false);
      }
    } catch {}

    // Track clicked tools to build the personalized "Đúng gu của bạn" strip
    const recordToolClick = (id: string, cat?: string) => {
      try {
        const raw = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
        const next = [id, ...raw.filter((x: string) => x !== id)].slice(0, 4);
        localStorage.setItem(RECENT_KEY, JSON.stringify(next));
        if (cat) localStorage.setItem(TASTE_KEY, cat);
      } catch {}
    };

    cards.forEach((c) => {
      c.addEventListener('click', () => {
        const id = c.dataset.toolCard || '';
        const firstCat = (c.dataset.toolCats || '').split(' ').find((x) => x && x !== 'top');
        if (id) recordToolClick(id, firstCat);
      });
    });

    document.querySelectorAll<HTMLAnchorElement>('[data-track-tool]').forEach((a) => {
      a.addEventListener('click', () => {
        recordToolClick(a.dataset.trackTool || '', a.dataset.trackCat);
      });
    });

    // Render personalized recent bar if client has history
    try {
      const recentIds: string[] = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
      const memBar = document.getElementById('client-memory-bar');
      const memList = document.getElementById('client-memory-list');
      if (memBar && memList && recentIds.length > 0) {
        const matched = recentIds
          .map((id) => Array.from(cards).find((c) => c.dataset.toolCard === id))
          .filter(Boolean) as HTMLAnchorElement[];
        if (matched.length > 0) {
          memList.innerHTML = matched
            .map(
              (c) =>
                `<a href="${c.getAttribute('href')}" class="inline-flex items-center gap-1.5 rounded-full border border-indigo-200 bg-white px-3 py-1 text-xs font-bold text-slate-800 shadow-2xs transition hover:border-indigo-500 hover:text-indigo-700"><span>${c.dataset.toolIcon}</span><span>${c.dataset.toolTitle}</span></a>`
            )
            .join('');
          memBar.hidden = false;
        }
      }
    } catch {}
  }
</script>
