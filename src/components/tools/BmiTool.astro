---
interface Props { lang?: 'vi' | 'en'; }
const { lang = 'vi' } = Astro.props;
const vi = lang === 'vi';
const acts = vi
  ? [['1.2', 'Ít vận động'], ['1.375', 'Tập 1–3 buổi/tuần'], ['1.55', 'Tập 3–5 buổi/tuần'], ['1.725', 'Tập 6–7 buổi/tuần'], ['1.9', 'Lao động nặng']]
  : [['1.2', 'Sedentary'], ['1.375', '1–3 workouts/week'], ['1.55', '3–5 workouts/week'], ['1.725', '6–7 workouts/week'], ['1.9', 'Very heavy work']];
---
<div data-tool="bmi" data-lang={lang} class="grid gap-5 lg:grid-cols-2">
  <form class="card grid min-w-0 content-start gap-3 sm:grid-cols-2" data-f>
    <svg class="viz-art sm:col-span-2" viewBox="0 0 240 56" aria-hidden="true" focusable="false"><rect x="4" y="30" width="56" height="24" rx="6" fill="#d9eaff"/><rect x="12" y="34" width="40" height="12" rx="3" fill="#fff" stroke="#2f6bff" stroke-width="2"/><path d="M32 46v-8" stroke="#e11d48" stroke-width="2" stroke-linecap="round"/><circle cx="32" cy="10" r="6" fill="#2f6bff"/><path d="M32 17v10M24 22h16" stroke="#2f6bff" stroke-width="4" stroke-linecap="round"/><path d="M72 30h18m-6-6 6 6-6 6" stroke="#94a3b8" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/><rect x="100" y="26" width="24" height="10" rx="5" fill="#0ea5e9"/><rect x="124" y="26" width="34" height="10" fill="#16a34a"/><rect x="158" y="26" width="18" height="10" fill="#f59e0b"/><rect x="176" y="26" width="28" height="10" fill="#ea580c"/><rect x="204" y="26" width="32" height="10" rx="5" fill="#dc2626"/><path d="M140 14v30" stroke="#0f172a" stroke-width="3" stroke-linecap="round"/><path d="M134 10h12l-6 7z" fill="#0f172a"/></svg>
    <div><label class="label">{vi ? 'Chiều cao (cm)' : 'Height (cm)'}</label><input class="input" name="h" type="number" step="0.1" value="165" /></div>
    <div><label class="label">{vi ? 'Cân nặng (kg)' : 'Weight (kg)'}</label><input class="input" name="w" type="number" step="0.1" value="60" /></div>
    <div><label class="label">{vi ? 'Tuổi' : 'Age'}</label><input class="input" name="a" type="number" value="28" /></div>
    <div><label class="label">{vi ? 'Giới tính' : 'Sex'}</label><select class="input" name="s"><option value="m">{vi ? 'Nam' : 'Male'}</option><option value="f">{vi ? 'Nữ' : 'Female'}</option></select></div>
    <div class="sm:col-span-2"><label class="label">{vi ? 'Vận động' : 'Activity'}</label><select class="input" name="act">{acts.map(([v, l], i) => <option value={v} selected={i === 1}>{l}</option>)}</select></div>
  </form>
  <div class="card min-w-0" data-out></div>
</div>

<script>
  import { scale } from '../../lib/viz.js';
  document.querySelectorAll<HTMLElement>('[data-tool="bmi"]').forEach((root) => {
    const vi = root.dataset.lang !== 'en';
    const form = root.querySelector<HTMLFormElement>('[data-f]')!;
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    // WHO WPRO (2000) Asia-Pacific cut-offs.
    const BANDS = [
      { max: 18.5, vi: 'Thiếu cân', en: 'Underweight', c: '#0ea5e9' },
      { max: 23, vi: 'Bình thường', en: 'Normal', c: '#16a34a' },
      { max: 25, vi: 'Thừa cân', en: 'Overweight', c: '#f59e0b' },
      { max: 30, vi: 'Béo phì độ I', en: 'Obese I', c: '#ea580c' },
      { max: 99, vi: 'Béo phì độ II', en: 'Obese II', c: '#dc2626' }
    ];
    const n = (x: number) => Math.round(x).toLocaleString(vi ? 'vi-VN' : 'en-US');
    const calc = () => {
      const f = new FormData(form);
      const h = Number(f.get('h')) / 100, w = Number(f.get('w')), a = Number(f.get('a')), act = Number(f.get('act'));
      if (!h || !w) { out.innerHTML = ''; return; }
      const bmi = w / (h * h);
      const band = BANDS.find((b) => bmi < b.max)!;
      const bmr = 10 * w + 625 * h - 5 * a + (f.get('s') === 'm' ? 5 : -161);
      const tdee = bmr * act;
      const lo = 18.5 * h * h, hi = 22.9 * h * h;
      out.innerHTML = `
        <div class="text-sm text-slate-500">BMI</div>
        <div class="text-5xl font-extrabold" style="color:${band.c}">${bmi.toFixed(1)}</div>
        <div class="mt-1 text-lg font-semibold" style="color:${band.c}">${vi ? band.vi : band.en}</div>
        ${scale(BANDS.map((b) => ({ to: b.max, label: vi ? b.vi : b.en, color: b.c })), bmi, { min: 15, max: 35, valueText: bmi.toFixed(1), ariaLabel: `BMI ${bmi.toFixed(1)}: ${vi ? band.vi : band.en}`, title: vi ? 'Thang BMI châu Á (WHO WPRO)' : 'Asian BMI scale (WHO WPRO)' })}
        <div class="mt-5 grid grid-cols-2 gap-3 text-sm">
          <div class="rounded-xl bg-slate-50 p-3"><div class="text-slate-500">${vi ? 'Cân nặng chuẩn' : 'Healthy weight'}</div><div class="text-lg font-bold">${lo.toFixed(0)}–${hi.toFixed(0)} kg</div></div>
          <div class="rounded-xl bg-slate-50 p-3"><div class="text-slate-500">${vi ? 'Calo giữ cân' : 'Maintain'}</div><div class="text-lg font-bold">${n(tdee)} kcal</div></div>
          <div class="rounded-xl bg-slate-50 p-3"><div class="text-slate-500">${vi ? 'Giảm cân' : 'Lose weight'}</div><div class="text-lg font-bold">${n(tdee - 500)} kcal</div></div>
          <div class="rounded-xl bg-slate-50 p-3"><div class="text-slate-500">${vi ? 'Tăng cân' : 'Gain weight'}</div><div class="text-lg font-bold">${n(tdee + 300)} kcal</div></div>
        </div>
        <p class="mt-4 text-xs text-slate-500">${vi ? 'Ngưỡng BMI châu Á (WHO WPRO 2000). BMR theo Mifflin–St Jeor. Chỉ để tham khảo, không thay tư vấn bác sĩ.' : 'Asian BMI cut-offs (WHO WPRO 2000). BMR by Mifflin–St Jeor. For reference only, not medical advice.'}</p>`;
    };
    form.addEventListener('input', calc);
    calc();
  });
</script>
