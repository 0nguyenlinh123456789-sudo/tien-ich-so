---
import MonetizedResult from '../MonetizedResult.astro';
import { t } from '../../i18n/ui.js';
import { CV_FILTERS } from '../../lib/cv-templates.js';
interface Props { lang?: 'vi' | 'en'; }
const { lang = 'vi' } = Astro.props;
const vi = lang === 'vi';
const L = t(lang);
const filters = CV_FILTERS[lang];
const chip = 'rounded-full border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:border-brand-500';
---
<div data-tool="documents" data-lang={lang}>
  <!-- Kind switch -->
  <div class="mb-4 inline-flex rounded-2xl bg-white p-1 shadow-sm ring-1 ring-slate-200" role="tablist">
    <button type="button" data-kind="cv" class="rounded-xl px-4 py-2 text-sm font-semibold data-[on=true]:bg-brand-600 data-[on=true]:text-white">📄 {vi ? 'Mẫu CV' : 'CV templates'} <span data-count="cv" class="opacity-70"></span></button>
    <button type="button" data-kind="vn" class="rounded-xl px-4 py-2 text-sm font-semibold data-[on=true]:bg-brand-600 data-[on=true]:text-white">⚖️ {vi ? 'Hợp đồng – Luật Việt Nam' : 'Contracts – Vietnamese law'} <span data-count="vn" class="opacity-70"></span></button>
    <button type="button" data-kind="intl" class="rounded-xl px-4 py-2 text-sm font-semibold data-[on=true]:bg-brand-600 data-[on=true]:text-white">🌐 {vi ? 'Hợp đồng – Luật nước ngoài' : 'Contracts – Foreign law'} <span data-count="intl" class="opacity-70"></span></button>
  </div>

  <!-- CV gallery -->
  <div class="card mb-6" data-pane="cv">
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" class={chip} data-tag="">{vi ? 'Tất cả' : 'All'}</button>
      {Object.entries(filters).map(([k, label]) => <button type="button" class={chip} data-tag={k}>{label}</button>)}
    </div>
    <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
      <span class="font-medium text-slate-600">{vi ? 'Màu:' : 'Colour:'}</span>
      <div class="flex flex-wrap gap-1.5" data-palettes></div>
      <select data-f="cols" class="input w-auto py-1.5 text-sm">
        <option value="">{vi ? '1 hoặc 2 cột' : '1 or 2 columns'}</option><option value="1">{vi ? '1 cột' : '1 column'}</option><option value="2">{vi ? '2 cột' : '2 columns'}</option>
      </select>
      <select data-f="photo" class="input w-auto py-1.5 text-sm">
        <option value="">{vi ? 'Có/không ảnh' : 'Photo or not'}</option><option value="1">{vi ? 'Có ảnh' : 'With photo'}</option><option value="0">{vi ? 'Không ảnh' : 'No photo'}</option>
      </select>
      <span class="ml-auto text-slate-500" data-cv-total></span>
    </div>
    <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6" data-cv-grid></div>
    <div class="mt-4 text-center"><button type="button" class="btn-ghost text-sm" data-cv-more>{vi ? 'Xem thêm mẫu' : 'Show more'}</button></div>
  </div>

  <!-- Contract galleries -->
  {['vn', 'intl'].map((g) => (
    <div class="card mb-6 hidden" data-pane={g}>
      <div class="mb-3 rounded-xl bg-amber-50 p-3 text-sm text-amber-900 ring-1 ring-amber-200">
        {g === 'vn'
          ? (vi ? '⚖️ Pháp luật Việt Nam hầu như không ban hành mẫu hợp đồng bắt buộc cho các giao dịch này, mà quy định nội dung phải có. Các mẫu dưới đây là mẫu tham khảo soạn theo đúng nội dung luật yêu cầu; mỗi mẫu ghi rõ căn cứ pháp lý. Với giao dịch giá trị lớn, nên nhờ luật sư hoặc công chứng viên rà soát. Mẫu đơn, tờ khai hành chính của Nhà nước: xem trang Biểu mẫu nhà nước (/bieu-mau-nha-nuoc).'
                : '⚖️ Vietnamese law generally prescribes required contents rather than mandatory forms. These are reference templates drafted to those requirements, each showing its legal basis. Have significant deals reviewed by a lawyer.')
          : (vi ? '🌐 Hợp đồng tiếng Anh, chọn luật áp dụng (Anh & xứ Wales, Singapore, New York, California, Delaware); tiền tệ đổi theo luật áp dụng. Đây là mẫu tham khảo, không thay thế tư vấn của luật sư tại nước sở tại.'
                : '🌐 Choose the governing law (England & Wales, Singapore, New York, California, Delaware); currency follows it. Reference templates only — not a substitute for local legal advice.')}
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-contract-grid={g}></div>
    </div>
  ))}

  <div class="grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
    <form class="card self-start" data-doc-form onsubmit="return false">
      <h2 class="mb-1 text-lg font-bold" data-doc-title></h2>
      <p class="mb-3 text-xs text-slate-500" data-doc-law></p>
      <div data-doc-fields class="grid gap-3"></div>
      <p class="mt-3 text-xs text-slate-500">🔒 {vi ? 'Dữ liệu và ảnh chỉ lưu trên trình duyệt của bạn, không tải lên máy chủ.' : 'Your data and photo stay in your browser only.'}</p>
    </form>

    <div class="lg:sticky lg:top-20 lg:self-start">
      <div class="mb-3 flex flex-wrap items-center gap-2">
        <h2 class="mr-auto text-lg font-bold">{vi ? 'Xem trước & tải về' : 'Preview & download'}</h2>
        <button type="button" class="btn-primary py-2 text-sm" data-action="print">⬇ PDF</button>
        <button type="button" class="btn-ghost py-2 text-sm" data-action="html">⬇ Word</button>
        <button type="button" class="btn-ghost py-2 text-sm" data-action="reset">↺ {vi ? 'Mẫu ví dụ' : 'Sample'}</button>
      </div>
      <div data-doc-frame class="overflow-hidden rounded-xl bg-slate-200/60 p-3 ring-1 ring-slate-200">
        <div data-doc-scaler style="transform-origin:top left">
          <div class="print-area bg-white shadow-xl" style="width:794px;min-height:1123px;box-sizing:border-box" data-doc-preview></div>
        </div>
      </div>
      <p class="mt-2 text-xs text-slate-500">{vi ? 'Mẹo: trong hộp thoại in, chọn "Lưu dưới dạng PDF", khổ A4, lề "Không có", bật "Đồ họa nền".' : 'Tip: in the print dialog choose "Save as PDF", A4, margins "None", enable "Background graphics".'}</p>
    </div>
  </div>

  <MonetizedResult context="tools" lang={lang} visible share={false} title={vi ? 'Gợi ý cho bạn' : 'Recommended'}>
    <p class="text-sm text-slate-600">{vi ? 'CV 1 trang, có số liệu cụ thể (%, doanh số, số dự án) được nhà tuyển dụng phản hồi nhiều hơn rõ rệt.' : 'One-page CVs with concrete numbers get noticeably more replies.'}</p>
  </MonetizedResult>
</div>

<style is:global>
  @media print {
    @page { size: A4; margin: 0; }
    [data-doc-scaler] { transform: none !important; height: auto !important; }
    [data-doc-preview] { box-shadow: none !important; }
    [data-doc-preview], [data-doc-preview] * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>

<script>
  import { getTemplates } from '../../lib/doc-templates.js';
  import { resolveCvId } from '../../lib/cv-templates.js';
  import { downloadBlob, escapeHtml } from '../../lib/format.js';
  import { gate } from '../../scripts/download-gate.js';

  const A4 = 794;
  const PAGE = 24;

  // Downscale an uploaded photo to a small square JPEG data URL (keeps localStorage small).
  function readPhoto(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const img = new Image();
      img.onload = () => {
        const size = 320;
        const s = Math.min(img.width, img.height);
        const cv = document.createElement('canvas');
        cv.width = cv.height = size;
        cv.getContext('2d')!.drawImage(img, (img.width - s) / 2, (img.height - s) / 2, s, s, 0, 0, size, size);
        URL.revokeObjectURL(img.src);
        resolve(cv.toDataURL('image/jpeg', 0.85));
      };
      img.onerror = reject;
      img.src = URL.createObjectURL(file);
    });
  }

  document.querySelectorAll<HTMLElement>('[data-tool="documents"]').forEach((root) => {
    const lang = (root.dataset.lang === 'en' ? 'en' : 'vi') as 'vi' | 'en';
    const vi = lang === 'vi';
    const templates: any[] = getTemplates(lang);
    const cvs = templates.filter((tp) => tp.group === 'cv');
    // The gallery shows one card per distinct layout; colour is a separate choice.
    const layouts = [...new Map(cvs.map((c) => [c.layout, c])).values()];
    const palettes = [...new Map(cvs.map((c) => [c.palette, c])).values()].map((c) => ({ key: c.palette, name: c.paletteName, c: c.accent }));
    const cvFor = (layout: string, palette: string) => cvs.find((c) => c.layout === layout && c.palette === palette)!;
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const fieldsEl = q('[data-doc-fields]');
    const preview = q('[data-doc-preview]');
    const frame = q('[data-doc-frame]');
    const scaler = q('[data-doc-scaler]');
    const grid = q('[data-cv-grid]');
    // CVs share one data set; each contract keeps its own.
    const storeKey = (tp: any) => `mp:doc:${lang}:${tp.group === 'cv' ? 'cv' : tp.id}`;
    const defaults = (tp: any) => Object.fromEntries(tp.fields.map((f: any) => [f.name, f.default ?? '']));
    const sample = defaults(cvs[0]);
    const firstCv = templates.find((tp) => tp.group === 'cv');

    const params = new URLSearchParams(location.search);
    const wanted = resolveCvId(params.get('template'));
    let currentId = templates.some((tp) => tp.id === wanted) ? wanted! : firstCv.id;
    let photo = '';
    const current = () => templates.find((tp) => tp.id === currentId)!;

    for (const g of ['cv', 'vn', 'intl']) q(`[data-count="${g}"]`).textContent = `(${templates.filter((tp) => tp.group === g).length})`;

    // ---------- Kind tabs ----------
    let kind = current().group;
    const showKind = (k: string) => {
      kind = k;
      root.querySelectorAll<HTMLElement>('[data-kind]').forEach((b) => (b.dataset.on = String(b.dataset.kind === k)));
      root.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => p.classList.toggle('hidden', p.dataset.pane !== k));
    };

    // ---------- CV gallery: filters, paging, lazy thumbnails ----------
    const f = { tag: '', cols: '', photo: '' };
    let shown = PAGE;
    let palette = current().group === 'cv' ? current().palette : palettes[0].key;
    const filtered = () => layouts.filter((c) =>
      (!f.tag || c.tags.includes(f.tag)) && (!f.cols || String(c.cols) === f.cols) && (!f.photo || String(Number(c.photo)) === f.photo));

    // Chips: toggle real classes (no data-variant) so the active label is always readable.
    const ON = ['!bg-brand-600', '!text-white', '!border-brand-600'];
    const setOn = (el: Element, on: boolean) => ON.forEach((c) => el.classList.toggle(c, on));
    root.querySelectorAll('[data-tag]').forEach((b) => setOn(b, (b as HTMLElement).dataset.tag === ''));

    const paletteBox = q('[data-palettes]');
    const drawPalettes = () => {
      paletteBox.innerHTML = palettes.map((p) => `<button type="button" data-palette="${p.key}" title="${escapeHtml(p.name)}" aria-label="${escapeHtml(p.name)}"
        class="h-7 w-7 rounded-full ring-offset-2 transition ${p.key === palette ? 'ring-2 ring-slate-900' : 'ring-1 ring-slate-200'}" style="background:${p.c}"></button>`).join('');
    };

    const io = new IntersectionObserver((entries) => entries.forEach((en) => {
      if (!en.isIntersecting) return;
      const box = en.target as HTMLElement;
      io.unobserve(box);
      const tp = cvs.find((c) => c.id === box.dataset.thumb)!;
      box.innerHTML = `<div style="width:${A4}px;transform:scale(${box.clientWidth / A4});transform-origin:top left;pointer-events:none">${tp.render(sample)}</div>`;
    }), { rootMargin: '300px' });

    const drawGallery = () => {
      const list = filtered().map((l) => cvFor(l.layout, palette));
      q('[data-cv-total]').textContent = vi ? `${list.length} thiết kế × ${palettes.length} màu` : `${list.length} designs × ${palettes.length} colours`;
      grid.innerHTML = list.slice(0, shown).map((tp) => `
        <button type="button" data-pick="${tp.id}" class="group text-left">
          <div data-thumb="${tp.id}" class="overflow-hidden rounded-lg bg-slate-100 ring-2 ring-transparent transition group-hover:ring-brand-300 ${current().layout === tp.layout ? '!ring-brand-600' : ''}" style="aspect-ratio:210/297"></div>
          <div class="mt-1.5 text-xs font-semibold text-slate-800">${escapeHtml(tp.layoutName)}</div>
          <div class="text-[11px] text-slate-500">${tp.cols === 2 ? (vi ? '2 cột' : '2 columns') : (vi ? '1 cột' : '1 column')}${tp.photo ? (vi ? ' · có ảnh' : ' · photo') : ''}</div>
        </button>`).join('');
      grid.querySelectorAll('[data-thumb]').forEach((el) => io.observe(el));
      q('[data-cv-more]').classList.toggle('hidden', shown >= list.length);
    };

    // ---------- Contract galleries ----------
    for (const g of ['vn', 'intl']) {
      const items = templates.filter((tp) => tp.group === g);
      const cats = [...new Set(items.map((tp) => tp.category))];
      q(`[data-contract-grid="${g}"]`).innerHTML = cats.map((cat) => `
        <div class="sm:col-span-2 lg:col-span-3 mt-2 text-xs font-bold tracking-wide text-slate-500 uppercase">${escapeHtml(cat)}</div>
        ${items.filter((tp) => tp.category === cat).map((tp) => `
          <button type="button" data-pick="${tp.id}" class="rounded-xl border border-slate-200 bg-white p-3 text-left transition hover:border-brand-400 hover:shadow">
            <div class="font-semibold text-slate-900">${escapeHtml(tp.name)}</div>
            ${tp.law ? `<div class="mt-1 text-xs text-slate-500">${escapeHtml(tp.law)}</div>` : ''}
          </button>`).join('')}`).join('');
    }

    const markActive = () => root.querySelectorAll<HTMLElement>('[data-pick]').forEach((b) => {
      const th = b.querySelector('[data-thumb]');
      const tp = templates.find((x) => x.id === b.dataset.pick);
      const on = th ? tp?.layout === current().layout : b.dataset.pick === currentId;
      if (th) th.classList.toggle('!ring-brand-600', on);
      else { b.classList.toggle('!border-brand-600', on); b.classList.toggle('ring-2', on); b.classList.toggle('ring-brand-100', on); }
    });

    // ---------- Preview ----------
    const fit = () => {
      const s = Math.min(1, (frame.clientWidth - 24) / A4);
      scaler.style.transform = `scale(${s})`;
      scaler.style.height = preview.offsetHeight * s + 'px';
    };

    const values = (): Record<string, string> => {
      const v: Record<string, string> = {};
      fieldsEl.querySelectorAll<HTMLInputElement>('[name]').forEach((el) => {
        if (el.type === 'file') return;
        if (el.type === 'color' && el.dataset.touched !== '1') return; // keep each palette's own accent
        v[el.name] = el.value;
      });
      if (current().fields.some((x: any) => x.type === 'photo')) v.photo = photo;
      return v;
    };

    const render = () => {
      const tp = current();
      const v = values();
      preview.innerHTML = tp.render(v);
      preview.style.padding = tp.fullBleed ? '0' : '56px 64px';
      fit();
      try { localStorage.setItem(storeKey(tp), JSON.stringify(v)); } catch { /* quota */ }
    };

    function updatePhotoPreview() {
      const box = fieldsEl.querySelector<HTMLElement>('[data-photo-preview]');
      if (box) box.innerHTML = photo ? `<img src="${photo}" alt="" class="h-full w-full object-cover" />` : '👤';
    }

    const buildFields = (useDefaults = false) => {
      const tp = current();
      q('[data-doc-title]').textContent = tp.group === 'cv' ? (vi ? 'Điền thông tin CV' : 'Your CV details') : tp.name;
      q('[data-doc-law]').textContent = tp.law ? (vi ? 'Căn cứ: ' : 'Legal basis: ') + tp.law : '';
      let saved: Record<string, string> = {};
      if (!useDefaults) { try { saved = JSON.parse(localStorage.getItem(storeKey(tp)) || '{}'); } catch { saved = {}; } }
      photo = saved.photo || '';
      fieldsEl.innerHTML = tp.fields.map((fd: any) => {
        const val = escapeHtml(saved[fd.name] ?? fd.default ?? '');
        const id = `doc-${fd.name}`;
        const label = `<label class="label" for="${id}">${escapeHtml(fd.label)}</label>`;
        if (fd.type === 'photo') {
          return `<div>${label}<div class="flex items-center gap-3">
            <div data-photo-preview class="grid h-16 w-16 shrink-0 place-items-center overflow-hidden rounded-full bg-slate-100 text-xl text-slate-400">👤</div>
            <label class="btn-ghost cursor-pointer py-2 text-sm">📷 ${vi ? 'Chọn ảnh' : 'Upload'}<input id="${id}" type="file" accept="image/*" class="hidden" data-photo-input /></label>
            <button type="button" class="text-sm text-slate-500 hover:text-rose-600" data-photo-remove>${vi ? 'Xóa' : 'Remove'}</button>
          </div></div>`;
        }
        if (fd.type === 'textarea') return `<div>${label}<textarea id="${id}" name="${fd.name}" rows="${fd.rows || 4}" class="input text-sm">${val}</textarea></div>`;
        if (fd.type === 'select') {
          const cur = saved[fd.name] ?? fd.default;
          return `<div>${label}<select id="${id}" name="${fd.name}" class="input text-sm">${fd.options.map((o: string) => `<option${o === cur ? ' selected' : ''}>${escapeHtml(o)}</option>`).join('')}</select></div>`;
        }
        if (fd.type === 'color') {
          const touched = saved[fd.name] ? '1' : '';
          const cval = /^#[0-9a-f]{6}$/i.test(saved[fd.name] || '') ? saved[fd.name] : (tp.accent || '#1f55e6');
          return `<div>${label}<div class="flex items-center gap-2">
            <input id="${id}" name="${fd.name}" type="color" value="${cval}" data-touched="${touched}" class="h-9 w-12 cursor-pointer rounded border border-slate-300" />
            <button type="button" class="text-sm text-slate-500 hover:text-brand-700" data-color-auto>${vi ? 'Dùng màu của mẫu' : 'Use template colour'}</button>
          </div></div>`;
        }
        return `<div>${label}<input id="${id}" name="${fd.name}" type="${fd.type || 'text'}" value="${val}" class="input text-sm" /></div>`;
      }).join('');
      updatePhotoPreview();
      render();
    };

    const pick = (id: string, scroll = false) => {
      const prev = current();
      currentId = id;
      history.replaceState(null, '', location.pathname + '?template=' + id);
      markActive();
      if (prev.group === 'cv' && current().group === 'cv') {
        const color = fieldsEl.querySelector<HTMLInputElement>('input[type="color"]');
        if (color && color.dataset.touched !== '1') color.value = current().accent;
        render();
      } else buildFields();
      if (scroll && innerWidth < 1024) q('[data-doc-form]').scrollIntoView({ behavior: 'smooth' });
    };

    // ---------- Events ----------
    root.addEventListener('click', (ev) => {
      const target = ev.target as HTMLElement;
      const k = target.closest<HTMLElement>('[data-kind]');
      if (k) return showKind(k.dataset.kind!);
      const p = target.closest<HTMLElement>('[data-pick]');
      if (p) return pick(p.dataset.pick!, true);
      const pal = target.closest<HTMLElement>('[data-palette]');
      if (pal) {
        palette = pal.dataset.palette!;
        drawPalettes(); drawGallery();
        if (current().group === 'cv') pick(cvFor(current().layout, palette).id);
        return;
      }
      const tag = target.closest<HTMLElement>('[data-tag]');
      if (tag) {
        f.tag = tag.dataset.tag!; shown = PAGE;
        root.querySelectorAll('[data-tag]').forEach((b) => setOn(b, b === tag));
        return drawGallery();
      }
      if (target.closest('[data-cv-more]')) { shown += PAGE; return drawGallery(); }
      if (target.closest('[data-color-auto]')) {
        const input = fieldsEl.querySelector<HTMLInputElement>('input[type="color"]')!;
        input.dataset.touched = ''; input.value = current().accent; return render();
      }
      if (target.closest('[data-photo-remove]')) { photo = ''; updatePhotoPreview(); render(); }
    });
    root.querySelectorAll<HTMLSelectElement>('[data-f]').forEach((s) => s.addEventListener('change', () => {
      (f as any)[s.dataset.f!] = s.value; shown = PAGE; drawGallery();
    }));
    fieldsEl.addEventListener('input', (ev) => {
      const el = ev.target as HTMLInputElement;
      if (el.type === 'color') el.dataset.touched = '1';
      if (el.type !== 'file') render();
    });
    fieldsEl.addEventListener('change', async (ev) => {
      const el = ev.target as HTMLInputElement;
      if (el.tagName === 'SELECT') return render();
      if (!el.matches('[data-photo-input]') || !el.files?.[0]) return;
      try { photo = await readPhoto(el.files[0]); updatePhotoPreview(); render(); } catch { /* unreadable image */ }
      el.value = '';
    });

    q('[data-action="print"]').addEventListener('click', () => gate(() => window.print()));
    q('[data-action="reset"]').addEventListener('click', () => buildFields(true));
    q('[data-action="html"]').addEventListener('click', () => {
      const html = `<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word"><head><meta charset="utf-8"><title>${escapeHtml(current().name)}</title></head><body>${preview.innerHTML}</body></html>`;
      downloadBlob(`${current().id}.doc`, new Blob(['﻿' + html], { type: 'application/msword' }));
    });
    window.addEventListener('resize', fit);

    showKind(kind);
    drawPalettes();
    drawGallery();
    markActive();
    buildFields();
  });
</script>
