---
import MonetizedResult from '../MonetizedResult.astro';
import { t } from '../../i18n/ui.js';
import { CV_FILTERS } from '../../lib/cv-templates.js';
interface Props { lang?: 'vi' | 'en'; }
const { lang = 'vi' } = Astro.props;
const vi = lang === 'vi';
const L = t(lang);
const filters = CV_FILTERS[lang];
const chip = 'rounded-full border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:border-brand-500';
---
<div data-tool="documents" data-lang={lang}>
  <!-- Kind switch -->
  <div class="mb-4 inline-flex rounded-2xl bg-white p-1 shadow-sm ring-1 ring-slate-200" role="tablist">
    <button type="button" data-kind="cv" class="rounded-xl px-4 py-2 text-sm font-semibold data-[on=true]:bg-brand-600 data-[on=true]:text-white">📄 {vi ? 'Mẫu CV' : 'CV templates'} <span data-count="cv" class="opacity-70"></span></button>
    {vi ? (
      <>
        <button type="button" data-kind="vn" class="rounded-xl px-4 py-2 text-sm font-semibold data-[on=true]:bg-brand-600 data-[on=true]:text-white">🇻🇳 Hợp đồng – Luật Việt Nam <span data-count="vn" class="opacity-70"></span></button>
        <button type="button" data-kind="intl" class="rounded-xl px-4 py-2 text-sm font-semibold data-[on=true]:bg-brand-600 data-[on=true]:text-white">🌐 Hợp đồng – Luật Quốc tế (UK/US/SG) <span data-count="intl" class="opacity-70"></span></button>
      </>
    ) : (
      <>
        <button type="button" data-kind="intl" class="rounded-xl px-4 py-2 text-sm font-semibold data-[on=true]:bg-brand-600 data-[on=true]:text-white">🌐 Contracts – International Law (US/UK/SG) <span data-count="intl" class="opacity-70"></span></button>
        <button type="button" data-kind="vn" class="rounded-xl px-4 py-2 text-sm font-semibold data-[on=true]:bg-brand-600 data-[on=true]:text-white">🇻🇳 Contracts – Vietnam Local Law <span data-count="vn" class="opacity-70"></span></button>
      </>
    )}

  </div>

  <!-- CV gallery -->
  <div class="card mb-6" data-pane="cv">
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" class={chip} data-tag="">{vi ? 'Tất cả' : 'All'}</button>
      {Object.entries(filters).map(([k, label]) => <button type="button" class={chip} data-tag={k}>{label}</button>)}
    </div>
    <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
      <span class="font-medium text-slate-600">{vi ? 'Màu:' : 'Colour:'}</span>
      <div class="flex flex-wrap gap-1.5" data-palettes></div>
      <select data-f="cols" class="input w-auto py-1.5 text-sm">
        <option value="">{vi ? '1 hoặc 2 cột' : '1 or 2 columns'}</option><option value="1">{vi ? '1 cột' : '1 column'}</option><option value="2">{vi ? '2 cột' : '2 columns'}</option>
      </select>
      <select data-f="photo" class="input w-auto py-1.5 text-sm">
        <option value="">{vi ? 'Có/không ảnh' : 'Photo or not'}</option><option value="1">{vi ? 'Có ảnh' : 'With photo'}</option><option value="0">{vi ? 'Không ảnh' : 'No photo'}</option>
      </select>
      <span class="ml-auto text-slate-500" data-cv-total></span>
    </div>
    <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6" data-cv-grid></div>
    <div class="mt-4 text-center"><button type="button" class="btn-ghost text-sm" data-cv-more>{vi ? 'Xem thêm mẫu' : 'Show more'}</button></div>
  </div>

  <!-- Contract galleries -->
  {['vn', 'intl'].map((g) => (
    <div class="card mb-6 hidden" data-pane={g}>
      <div class="mb-3 rounded-xl bg-amber-50 p-3 text-sm text-amber-900 ring-1 ring-amber-200">
        {g === 'vn'
          ? (vi ? '⚖️ Mẫu hợp đồng soạn theo nội dung luật định kèm căn cứ pháp lý · Điền thông tin và xuất PDF/Word ngay.'
                : '⚖️ Reference templates drafted to statutory requirements with legal citations · Fill & export PDF/Word.')
          : (vi ? '🌐 Hợp đồng chuẩn quốc tế (UK, Singapore, US: NY/CA/Delaware) · Tự động đổi tiền tệ theo luật áp dụng.'
                : '🌐 Choose the governing law (England & Wales, Singapore, New York, California, Delaware); currency follows it. Reference templates only — not a substitute for local legal advice.')}
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-contract-grid={g}></div>
    </div>
  ))}

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
    <form class="card self-start" data-doc-form onsubmit="return false">
      <h2 class="mb-1 text-lg font-bold" data-doc-title></h2>
      <p class="mb-3 text-xs text-slate-500" data-doc-law></p>

      <details data-cv-api-box class="group mb-4 rounded-xl border border-slate-200 bg-slate-50/80 px-3.5 py-2.5">
        <summary class="flex cursor-pointer list-none items-center justify-between text-xs font-bold text-slate-800">
          <span>⚡ {vi ? 'Điền mẫu nhanh (24+ ngành nghề / GitHub)' : '1-Click Auto-Fill (24+ Roles / GitHub)'}</span>
          <span class="rounded-full bg-white px-2 py-0.5 text-[11px] font-semibold text-brand-700 ring-1 ring-slate-200 transition group-open:bg-slate-900 group-open:text-white">{vi ? 'Mở / Đóng ⌄' : 'Toggle ⌄'}</span>
        </summary>
        <div class="mt-3 space-y-2.5 border-t border-slate-200/80 pt-2.5">
          <div class="flex flex-wrap gap-1">
            {[
              ['claude', 'terracotta', '✦ Warm Editorial'],
              ['behance', 'cobalt', '★ Art Director'],
              ['bento', 'blue', '⊞ Bento Grid'],
              ['swiss', 'wine', '✚ Swiss Bauhaus'],
              ['minimal', 'graphite', '✓ Chuẩn ATS'],
              ['modern', 'navy', '▪ Hiện đại'],
              ['executive', 'amber', '♛ Quản lý'],
              ['opensource', 'green', '📦 GitHub OS'],
              ['architect', 'navy', '📐 Kiến trúc CAD'],
              ['nordic', 'teal', '🏛 Vòm Bắc Âu'],
              ['sketch', 'amber', '✎ Sổ tay Vẽ tay'],
              ['polaroid', 'pink', '📸 Polaroid']
            ].map(([ly, pal, label]) => (
              <button type="button" data-cv-quick={`${ly}:${pal}`} class="rounded-lg border border-slate-200 bg-white px-2 py-1 text-[11px] font-semibold text-slate-700 transition hover:border-brand-500 hover:text-brand-700">{label}</button>
            ))}
          </div>
          <div class="grid gap-1.5 sm:grid-cols-[1fr_auto_auto]">
            <input type="text" data-cv-gh-user class="rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs focus:border-brand-500 focus:outline-none" placeholder={vi ? 'Nhập @username GitHub để tự động điền CV...' : 'Enter GitHub @username to auto-fill CV...'} />
            <button type="button" data-cv-gh-fetch class="btn-primary py-1 text-xs font-bold">⚡ {vi ? 'Nạp GitHub' : 'Sync GitHub'}</button>
            <button type="button" data-cv-dicebear class="rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 hover:border-brand-500">🎭 {vi ? 'Avatar Minh họa' : 'Illustrated Avatar'}</button>
          </div>
          <div data-cv-gh-status class="text-[11px] font-semibold text-emerald-700"></div>
        </div>
      </details>

      <div data-cv-tune-box class="mb-4 rounded-xl border border-indigo-200/80 bg-indigo-50/40 p-3">
        <div class="mb-2 flex items-center justify-between">
          <span class="text-xs font-extrabold uppercase tracking-wider text-indigo-950">🎛 {vi ? 'Tinh chỉnh Chữ & Khung CV' : 'CV Font & Spacing'}</span>
          <span class="text-[11px] font-semibold text-indigo-700">{vi ? 'Áp dụng cho mọi mẫu CV' : 'Works on all 108 CV templates'}</span>
        </div>
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
          <label class="block text-[11px] font-semibold text-slate-700">
            {vi ? 'Phông chữ CV' : 'Font Family'}
            <select data-cv-tune="cvFont" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-xs font-semibold text-slate-800">
              <option value="">{vi ? 'Mặc định theo mẫu' : 'Template Default'}</option>
              <option value="sans">Be Vietnam Pro (Hiện đại)</option>
              <option value="serif">Lora Serif (Điềm tĩnh)</option>
              <option value="mono">JetBrains Mono (Kỹ thuật)</option>
              <option value="hand">Editorial Cursive (Nghệ thuật)</option>
            </select>
          </label>
          <label class="block text-[11px] font-semibold text-slate-700">
            {vi ? 'Tỷ lệ Cỡ chữ' : 'Font Scale'}
            <select data-cv-tune="cvScale" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-xs font-semibold text-slate-800">
              <option value="normal">{vi ? 'Chuẩn A4 (100%)' : 'Standard (100%)'}</option>
              <option value="compact">{vi ? 'Thu gọn nhiều chữ (92%)' : 'Compact (92%)'}</option>
              <option value="large">{vi ? 'Chữ lớn rõ nét (106%)' : 'Large (106%)'}</option>
            </select>
          </label>
          <label class="block text-[11px] font-semibold text-slate-700">
            {vi ? 'Giãn dòng & Mật độ' : 'Line Spacing'}
            <select data-cv-tune="cvDensity" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-xs font-semibold text-slate-800">
              <option value="normal">{vi ? 'Cân đối (1.55)' : 'Balanced (1.55)'}</option>
              <option value="tight">{vi ? 'Sát gọn 1 trang (1.36)' : 'Tight 1-Page (1.36)'}</option>
              <option value="airy">{vi ? 'Thoáng rộng (1.72)' : 'Airy (1.72)'}</option>
            </select>
          </label>
          <label class="block text-[11px] font-semibold text-slate-700">
            {vi ? 'Kiểu Khung & Bo góc' : 'Corner Style'}
            <select data-cv-tune="cvRadius" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-xs font-semibold text-slate-800">
              <option value="">{vi ? 'Theo mẫu gốc' : 'Template Default'}</option>
              <option value="sharp">{vi ? 'Vuông sắc nét (0px)' : 'Sharp Square (0px)'}</option>
              <option value="round">{vi ? 'Bo tròn mềm (14px)' : 'Soft Rounded (14px)'}</option>
            </select>
          </label>
        </div>
      </div>

      <div data-doc-fields class="grid gap-3"></div>
      <p class="mt-3 text-xs text-slate-500">🔒 {vi ? 'Xử lý trực tiếp trên trình duyệt, bảo mật 100%.' : 'Processed locally in your browser, 100% private.'}</p>
    </form>

    <div class="lg:sticky lg:top-20 lg:self-start">
      <div class="mb-3 flex flex-wrap items-center gap-2">
        <h2 class="mr-auto text-lg font-bold">{vi ? 'Xem trước A4 & Xuất file' : 'A4 Preview & Export'}</h2>
        <button type="button" class="btn-primary py-2 text-sm" data-action="print">⬇ PDF (A4)</button>
        <button type="button" class="btn-ghost py-2 text-sm" data-action="html">⬇ Word (.doc)</button>
        <button type="button" class="btn-ghost py-2 text-sm" data-action="reset">↺ {vi ? 'Dữ liệu mẫu' : 'Reset sample'}</button>
      </div>
      <div data-cv-studio-bar class="mb-2.5 flex flex-wrap items-center gap-1.5 rounded-xl border border-blue-400/60 bg-slate-900 px-3 py-2 text-[11px] font-bold text-slate-100 shadow-lg">
        <span data-cvs-tag class="rounded bg-blue-600 px-2 py-1 text-[10.5px] font-extrabold text-white">✎ {vi ? 'Chạm vào Vector / Khung vuông / Chữ trên CV để sửa' : 'Click any Vector / Box / Text on CV to edit'}</span>
        <button type="button" data-cvs-parent class="rounded border border-slate-700 bg-slate-800 px-2 py-1 hover:bg-blue-600" title={vi ? 'Chọn khung cha bao ngoài' : 'Select parent box'}>↑ {vi ? 'Khung cha' : 'Parent'}</button>
        <button type="button" data-cvs-vec class="rounded border border-slate-700 bg-slate-800 px-2 py-1 hover:bg-blue-600" title={vi ? 'Chọn Vector SVG' : 'Select SVG Vector'}>✦ Vector</button>
        <label class="inline-flex cursor-pointer items-center gap-1 rounded border border-slate-700 bg-slate-800 px-2 py-0.5 hover:bg-blue-600">🎨 {vi ? 'Chữ/Vector' : 'Color'} <input type="color" data-cvs-fg value="#1d4ed8" class="h-4 w-4 cursor-pointer border-0 bg-transparent p-0" /></label>
        <label class="inline-flex cursor-pointer items-center gap-1 rounded border border-slate-700 bg-slate-800 px-2 py-0.5 hover:bg-blue-600">⬜ {vi ? 'Nền' : 'Bg'} <input type="color" data-cvs-bg value="#ffffff" class="h-4 w-4 cursor-pointer border-0 bg-transparent p-0" /></label>
        <button type="button" data-cvs-bg-clear class="rounded border border-slate-700 bg-slate-800 px-1.5 py-1 hover:bg-blue-600" title={vi ? 'Trong suốt' : 'Transparent'}>Ø</button>
        <label class="inline-flex cursor-pointer items-center gap-1 rounded border border-slate-700 bg-slate-800 px-2 py-0.5 hover:bg-blue-600">🖍 {vi ? 'Viền' : 'Border'} <input type="color" data-cvs-bdr value="#0f172a" class="h-4 w-4 cursor-pointer border-0 bg-transparent p-0" /></label>
        <button type="button" data-cvs-rad="0px" class="rounded border border-slate-700 bg-slate-800 px-2 py-1 hover:bg-blue-600">⬜ {vi ? 'Vuông' : 'Square'}</button>
        <button type="button" data-cvs-rad="12px" class="rounded border border-slate-700 bg-slate-800 px-2 py-1 hover:bg-blue-600">▢ {vi ? 'Bo' : 'Round'}</button>
        <button type="button" data-cvs-rad="999px" class="rounded border border-slate-700 bg-slate-800 px-2 py-1 hover:bg-blue-600">◯ {vi ? 'Tròn' : 'Pill'}</button>
        <button type="button" data-cvs-bdr-cycle class="rounded border border-slate-700 bg-slate-800 px-2 py-1 hover:bg-blue-600">━ {vi ? 'Kiểu viền' : 'Border'}</button>
        <button type="button" data-cvs-shadow class="rounded border border-slate-700 bg-slate-800 px-2 py-1 hover:bg-blue-600">❐ {vi ? 'Bóng' : 'Shadow'}</button>
        <button type="button" data-cvs-scale="-0.1" class="rounded border border-slate-700 bg-slate-800 px-2 py-1 hover:bg-blue-600">− {vi ? 'Nhỏ' : 'Smaller'}</button>
        <button type="button" data-cvs-scale="0.1" class="rounded border border-slate-700 bg-slate-800 px-2 py-1 hover:bg-blue-600">＋ {vi ? 'To' : 'Larger'}</button>
        <button type="button" data-cvs-rot="-15" class="rounded border border-slate-700 bg-slate-800 px-2 py-1 hover:bg-blue-600">↺</button>
        <button type="button" data-cvs-rot="15" class="rounded border border-slate-700 bg-slate-800 px-2 py-1 hover:bg-blue-600">↻</button>
        <button type="button" data-cvs-drag class="rounded border border-slate-700 bg-slate-800 px-2 py-1 hover:bg-blue-600">✥ {vi ? 'Kéo thả' : 'Drag'}</button>
        <select data-cvs-vec-swap class="rounded border border-slate-700 bg-slate-800 px-2 py-1 text-[11px] font-bold text-white hover:bg-blue-600">
          <option value="">✦ {vi ? 'Đổi/Chèn Vector...' : 'Swap/Add Vector...'}</option>
          <option value="square">■ {vi ? 'Vector Khung Vuông' : 'Square Vector'}</option>
          <option value="circle">● {vi ? 'Vector Tâm Tròn' : 'Circle Vector'}</option>
          <option value="star">★ {vi ? 'Vector Ngôi Sao' : 'Star Vector'}</option>
          <option value="bauhaus">▲ {vi ? 'Vector Bauhaus' : 'Bauhaus Vector'}</option>
          <option value="hex">⬡ {vi ? 'Vector Lục Giác' : 'Hexagon Vector'}</option>
          <option value="seal">🉐 {vi ? 'Vector Ấn Triện' : 'Seal Vector'}</option>
        </select>
        <input type="search" data-cvs-oss-q placeholder={vi ? '🔍 Tìm 200k+ Vector mở...' : '🔍 Search 200k+ OSS Vectors...'} class="w-36 rounded border border-slate-700 bg-slate-800 px-2 py-1 text-[11px] text-white placeholder-slate-400" />
        <button type="button" data-cvs-oss-btn class="rounded border border-slate-700 bg-slate-800 px-2 py-1 hover:bg-blue-600">🌐 {vi ? 'Tìm Vector' : 'Find Vector'}</button>
        <button type="button" data-cvs-qr class="rounded border border-slate-700 bg-slate-800 px-2 py-1 hover:bg-blue-600">🔳 {vi ? 'Chèn QR' : 'Add QR'}</button>
        <button type="button" data-cvs-add-box class="rounded border border-slate-700 bg-slate-800 px-2 py-1 hover:bg-blue-600">＋ {vi ? 'Khung vuông' : 'Add Box'}</button>
        <button type="button" data-cvs-dup class="rounded border border-slate-700 bg-slate-800 px-2 py-1 hover:bg-blue-600">⧉ {vi ? 'Nhân bản' : 'Duplicate'}</button>
        <button type="button" data-cvs-del class="rounded border border-slate-700 bg-slate-800 px-2 py-1 text-rose-300 hover:bg-rose-600 hover:text-white">🗑 {vi ? 'Xóa' : 'Delete'}</button>
        <button type="button" data-cvs-undo class="rounded border border-slate-700 bg-slate-800 px-2 py-1 hover:bg-blue-600">↩ {vi ? 'Hoàn tác' : 'Undo'}</button>
        <div data-cvs-oss-tray class="hidden w-full flex-wrap items-center gap-1.5 border-t border-slate-700 pt-1.5"></div>
      </div>
      <div data-doc-frame class="overflow-hidden rounded-xl bg-slate-200/60 p-3 ring-1 ring-slate-200">
        <div data-doc-scaler style="transform-origin:top left">
          <div class="print-area bg-white shadow-xl" style="width:794px;min-height:1123px;box-sizing:border-box" data-doc-preview></div>
        </div>
      </div>
      <p class="mt-2 text-xs text-slate-500">{vi ? 'Mẹo in PDF đẹp: chọn khổ A4, lề "Không có" (None) và bật "Đồ họa nền" (Background graphics).' : 'PDF tip: select A4 size, margins "None", and enable "Background graphics".'}</p>
    </div>
  </div>

  <MonetizedResult context="tools" lang={lang} visible share={false} title={vi ? 'Mẹo tối ưu CV' : 'CV Tips'}>
    <p class="text-sm text-slate-600">{vi ? 'Ưu tiên CV 1 trang A4 gọn gàng, nêu số liệu kết quả cụ thể (%, doanh số, KPI) và dùng ảnh thẻ phông nền trắng hoặc xanh chuẩn.' : 'Keep your CV to 1 clean A4 page with measurable results (%, revenue, KPIs) and a clean white or blue ID portrait.'}</p>
  </MonetizedResult>
</div>

<style is:global>
  @media print {
    @page { size: A4; margin: 0; }
    [data-doc-scaler] { transform: none !important; height: auto !important; }
    [data-doc-preview] { box-shadow: none !important; }
    [data-doc-preview], [data-doc-preview] * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    [data-cv-studio-bar] { display: none !important; }
    [data-cv-sel], [data-cv-hover] { outline: 0 !important; box-shadow: none !important; }
  }
  [data-cv-sel="1"] { outline: 2px solid #2563eb !important; outline-offset: 2px !important; }
  [data-cv-hover="1"]:not([data-cv-sel="1"]) { outline: 1px dashed rgba(37, 99, 235, 0.65) !important; outline-offset: 2px !important; }
</style>

<script>
  import { getTemplates } from '../../lib/doc-templates.js';
  import { resolveCvId } from '../../lib/cv-templates.js';
  import { downloadBlob, escapeHtml } from '../../lib/format.js';
  import { safeImageSrc } from '../../lib/safe-url.js';
  import { openImageEditor, loadImage, replaceBackgroundCanvas, ensureAiSegmenter, dataUrlBytes, formatKb } from '../../lib/image-editor.js';
  import { gate } from '../../scripts/download-gate.js';

  const A4 = 794;
  const PAGE = 24;

  function readPhoto(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const img = new Image();
      img.onload = () => {
        const max = 800;
        const k = Math.min(1, max / Math.max(img.width, img.height));
        const cv = document.createElement('canvas');
        cv.width = Math.round(img.width * k);
        cv.height = Math.round(img.height * k);
        cv.getContext('2d')!.drawImage(img, 0, 0, cv.width, cv.height);
        URL.revokeObjectURL(img.src);
        resolve(cv.toDataURL('image/jpeg', 0.88));
      };
      img.onerror = reject;
      img.src = URL.createObjectURL(file);
    });
  }

  document.querySelectorAll<HTMLElement>('[data-tool="documents"]').forEach((root) => {
    const lang = (root.dataset.lang === 'en' ? 'en' : 'vi') as 'vi' | 'en';
    const vi = lang === 'vi';
    const templates: any[] = getTemplates(lang);
    const cvs = templates.filter((tp) => tp.group === 'cv');
    const layouts = [...new Map(cvs.map((c) => [c.layout, c])).values()];
    const palettes = [...new Map(cvs.map((c) => [c.palette, c])).values()].map((c) => ({ key: c.palette, name: c.paletteName, c: c.accent }));
    const cvFor = (layout: string, palette: string) => cvs.find((c) => c.layout === layout && c.palette === palette)!;
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const fieldsEl = q('[data-doc-fields]');
    const preview = q('[data-doc-preview]');
    const frame = q('[data-doc-frame]');
    const scaler = q('[data-doc-scaler]');
    const grid = q('[data-cv-grid]');
    const storeKey = (tp: any) => `mp:doc:${lang}:${tp.group === 'cv' ? 'cv' : tp.id}`;
    const defaults = (tp: any) => Object.fromEntries(tp.fields.map((f: any) => [f.name, f.default ?? '']));
    const sample = defaults(cvs[0]);
    const firstCv = templates.find((tp) => tp.group === 'cv');

    const params = new URLSearchParams(location.search);
    const wanted = resolveCvId(params.get('template'));
    let currentId = templates.some((tp) => tp.id === wanted) ? wanted! : firstCv.id;
    let photo = '';
    let photoOrig = '';
    let photoEditState: any = null;
    let photoShape = 'circle';
    let photoMeta = '';
    const current = () => templates.find((tp) => tp.id === currentId)!;

    q('[data-count="cv"]').textContent = `(${layouts.length})`;
    for (const g of ['vn', 'intl']) q(`[data-count="${g}"]`).textContent = `(${templates.filter((tp) => tp.group === g).length})`;

    let kind = current().group;
    const showKind = (k: string) => {
      kind = k;
      root.querySelectorAll<HTMLElement>('[data-kind]').forEach((b) => (b.dataset.on = String(b.dataset.kind === k)));
      root.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => p.classList.toggle('hidden', p.dataset.pane !== k));
    };

    const f = { tag: '', cols: '', photo: '' };
    let shown = PAGE;
    let palette = '';
    const filtered = () => layouts.filter((c) =>
      (!f.tag || c.tags.includes(f.tag)) && (!f.cols || String(c.cols) === f.cols) && (!f.photo || String(Number(c.photo)) === f.photo));

    const ON = ['!bg-brand-600', '!text-white', '!border-brand-600'];
    const setOn = (el: Element, on: boolean) => ON.forEach((c) => el.classList.toggle(c, on));
    root.querySelectorAll('[data-tag]').forEach((b) => setOn(b, (b as HTMLElement).dataset.tag === ''));

    const paletteBox = q('[data-palettes]');
    const drawPalettes = () => {
      paletteBox.innerHTML = `<button type="button" data-palette="" title="${vi ? 'Màu đặc trưng riêng của từng mẫu CV' : 'Signature colour per template'}" class="h-7 rounded-full px-2.5 text-[11px] font-bold ring-offset-2 transition ${!palette ? 'bg-slate-900 text-white ring-2 ring-slate-900' : 'bg-white text-slate-700 ring-1 ring-slate-300'}">🌈 ${vi ? 'Theo mẫu' : 'Auto Mix'}</button>` + palettes.map((p) => `<button type="button" data-palette="${p.key}" title="${escapeHtml(p.name)}" aria-label="${escapeHtml(p.name)}"
        class="h-7 w-7 rounded-full ring-offset-2 transition ${p.key === palette ? 'ring-2 ring-slate-900' : 'ring-1 ring-slate-200'}" style="background:${p.c}"></button>`).join('');
    };

    const io = new IntersectionObserver((entries) => entries.forEach((en) => {
      if (!en.isIntersecting) return;
      const box = en.target as HTMLElement;
      io.unobserve(box);
      const tp = cvs.find((c) => c.id === box.dataset.thumb)!;
      box.innerHTML = `<div style="width:${A4}px;transform:scale(${box.clientWidth / A4});transform-origin:top left;pointer-events:none">${tp.render({ ...sample, __thumb: true, title: tp.layoutName })}</div>`;
    }), { rootMargin: '300px' });

    const moreBtn = q('[data-cv-more]');
    const drawGallery = () => {
      const list = filtered().map((l) => cvFor(l.layout, palette || l.sigPalette || palettes[0].key));
      q('[data-cv-total]').textContent = vi ? `${list.length} mẫu CV độc bản · ${palettes.length} tông màu` : `${list.length} unique CV designs · ${palettes.length} colours`;
      grid.innerHTML = list.slice(0, shown).map((tp) => `
        <button type="button" data-pick="${tp.id}" class="group text-left">
          <div data-thumb="${tp.id}" class="overflow-hidden rounded-lg bg-slate-100 ring-2 ring-transparent transition group-hover:ring-brand-300 ${current().layout === tp.layout ? '!ring-brand-600' : ''}" style="aspect-ratio:210/297"></div>
          <div class="mt-1.5 text-xs font-semibold text-slate-800">${escapeHtml(tp.layoutName)}</div>
          <div class="text-[11px] text-slate-500">${tp.cols === 2 ? (vi ? '2 cột' : '2 columns') : (vi ? '1 cột' : '1 column')}${tp.photo ? (vi ? ' · có ảnh' : ' · photo') : ''}</div>
        </button>`).join('');
      grid.querySelectorAll('[data-thumb]').forEach((el) => io.observe(el));
      if (list.length <= PAGE) {
        moreBtn.classList.add('hidden');
      } else {
        moreBtn.classList.remove('hidden');
        moreBtn.textContent = shown >= list.length
          ? (vi ? '↑ Thu gọn danh sách mẫu' : '↑ Show fewer')
          : (vi ? `Xem tất cả ${list.length} mẫu CV (+${list.length - shown})` : `Show all ${list.length} designs (+${list.length - shown})`);
      }
    };

    for (const g of ['vn', 'intl']) {
      const items = templates.filter((tp) => tp.group === g);
      const cats = [...new Set(items.map((tp) => tp.category))];
      q(`[data-contract-grid="${g}"]`).innerHTML = cats.map((cat) => `
        <div class="sm:col-span-2 lg:col-span-3 mt-2 text-xs font-bold tracking-wide text-slate-500 uppercase">${escapeHtml(cat)}</div>
        ${items.filter((tp) => tp.category === cat).map((tp) => `
          <button type="button" data-pick="${tp.id}" class="rounded-xl border border-slate-200 bg-white p-3 text-left transition hover:border-brand-400 hover:shadow">
            <div class="font-semibold text-slate-900">${escapeHtml(tp.name)}</div>
            ${tp.law ? `<div class="mt-1 text-xs text-slate-500">${escapeHtml(tp.law)}</div>` : ''}
          </button>`).join('')}`).join('');
    }

    const markActive = () => root.querySelectorAll<HTMLElement>('[data-pick]').forEach((b) => {
      const th = b.querySelector('[data-thumb]');
      const tp = templates.find((x) => x.id === b.dataset.pick);
      const on = th ? tp?.layout === current().layout : b.dataset.pick === currentId;
      if (th) th.classList.toggle('!ring-brand-600', on);
      else { b.classList.toggle('!border-brand-600', on); b.classList.toggle('ring-2', on); b.classList.toggle('ring-brand-100', on); }
    });

    const fit = () => {
      const s = Math.min(1, (frame.clientWidth - 24) / A4);
      scaler.style.transform = `scale(${s})`;
      scaler.style.height = preview.offsetHeight * s + 'px';
    };

    const values = (): Record<string, string> => {
      const v: Record<string, string> = {};
      fieldsEl.querySelectorAll<HTMLInputElement>('[name]').forEach((el) => {
        if (el.type === 'file') return;
        if (el.type === 'color' && el.dataset.touched !== '1') return;
        v[el.name] = el.value;
      });
      if (current().fields.some((x: any) => x.type === 'photo')) {
        v.photo = photo;
        v.photoShape = photoShape;
      }
      root.querySelectorAll<HTMLSelectElement>('[data-cv-tune]').forEach((sel) => {
        if (sel.dataset.cvTune) v[sel.dataset.cvTune] = sel.value;
      });
      return v;
    };

    const render = () => {
      const tp = current();
      const v = values();
      preview.innerHTML = tp.render(v);
      preview.style.padding = tp.fullBleed ? '0' : '56px 64px';
      fit();
      try { localStorage.setItem(storeKey(tp), JSON.stringify(v)); } catch { /* quota */ }
    };

    async function refreshPhotoMeta(srcUrl: string) {
      if (!srcUrl || !srcUrl.startsWith('data:image/')) { photoMeta = ''; return; }
      try {
        const im = await loadImage(srcUrl);
        photoMeta = `${im.width}×${im.height} px · ${formatKb(dataUrlBytes(srcUrl))}`;
      } catch { photoMeta = ''; }
    }

    function updatePhotoPreview() {
      const box = fieldsEl.querySelector<HTMLElement>('[data-photo-preview]');
      const metaEl = fieldsEl.querySelector<HTMLElement>('[data-photo-meta]');
      const editBtn = fieldsEl.querySelector<HTMLElement>('[data-photo-edit]');
      const bgBtns = fieldsEl.querySelector<HTMLElement>('[data-photo-quickbg]');
      if (box) {
        box.className = photoShape === '3x4'
          ? 'grid h-20 w-15 shrink-0 place-items-center overflow-hidden rounded-lg border border-slate-300 bg-slate-100 text-xl text-slate-400'
          : 'grid h-16 w-16 shrink-0 place-items-center overflow-hidden rounded-full border border-slate-300 bg-slate-100 text-xl text-slate-400';
        const okSrc = safeImageSrc(photo);
        box.innerHTML = okSrc ? `<img src="${okSrc}" alt="" class="h-full w-full object-cover" />` : '👤';
      }
      if (metaEl) metaEl.textContent = photoMeta || (vi ? 'Chưa có ảnh · Hỗ trợ đổi nền Trắng/Xanh, cắt 3×4, 4×6 & nén KB' : 'No photo · Supports White/Blue ID background, 3×4 crop & KB limit');
      if (editBtn) editBtn.classList.toggle('hidden', !photo);
      if (bgBtns) bgBtns.classList.toggle('hidden', !photo);
      fieldsEl.querySelectorAll<HTMLElement>('[data-photoshape]').forEach((b) => {
        const on = b.dataset.photoshape === photoShape;
        b.classList.toggle('bg-slate-900', on);
        b.classList.toggle('text-white', on);
      });
    }

    const buildFields = (useDefaults = false) => {
      const tp = current();
      const apiBox = root.querySelector<HTMLElement>('[data-cv-api-box]');
      if (apiBox) apiBox.classList.toggle('hidden', tp.group !== 'cv');
      const tuneBox = root.querySelector<HTMLElement>('[data-cv-tune-box]');
      if (tuneBox) tuneBox.classList.toggle('hidden', tp.group !== 'cv');
      q('[data-doc-title]').textContent = tp.group === 'cv' ? (vi ? 'Thông tin CV của bạn' : 'Your CV details') : tp.name;
      q('[data-doc-law]').textContent = tp.law ? (vi ? 'Căn cứ: ' : 'Legal basis: ') + tp.law : '';
      let saved: Record<string, string> = {};
      if (!useDefaults) { try { saved = JSON.parse(localStorage.getItem(storeKey(tp)) || '{}'); } catch { saved = {}; } }
      photo = safeImageSrc(saved.photo) ? String(saved.photo).trim() : '';
      photoOrig = photo;
      photoShape = saved.photoShape || 'circle';
      root.querySelectorAll<HTMLSelectElement>('[data-cv-tune]').forEach((sel) => {
        const k = sel.dataset.cvTune!;
        if (saved[k] !== undefined) sel.value = saved[k];
      });
      fieldsEl.innerHTML = tp.fields.map((fd: any) => {
        const rawSaved = (fd.name === 'payBank' || fd.name === 'payAccount') ? (saved[fd.name] || fd.default || '') : (saved[fd.name] ?? fd.default ?? '');
        const val = escapeHtml(rawSaved);
        const id = `doc-${fd.name}`;
        const label = `<label class="label" for="${id}">${escapeHtml(fd.label)}</label>`;
        if (fd.type === 'photo') {
          return `<div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3">${label}
            <div class="flex flex-wrap items-center gap-2.5">
              <div data-photo-preview class="grid h-16 w-16 shrink-0 place-items-center overflow-hidden rounded-full border border-slate-300 bg-slate-100 text-xl text-slate-400">👤</div>
              <div class="flex-1 space-y-1.5">
                <div class="flex flex-wrap items-center gap-1.5">
                  <label class="btn-ghost cursor-pointer py-1.5 px-3 text-xs font-bold">📷 ${vi ? 'Tải ảnh lên' : 'Upload photo'}<input id="${id}" type="file" accept="image/*" class="hidden" data-photo-input /></label>
                  <button type="button" class="btn-primary py-1.5 px-3 text-xs font-bold hidden" data-photo-edit>🪪 ${vi ? 'Đổi nền Trắng/Xanh & Kích thước / KB' : 'ID Photo Bg & Size/KB'}</button>
                  <div class="inline-flex rounded-lg border border-slate-300 bg-white p-0.5 text-[11px] font-semibold">
                    <button type="button" data-photoshape="circle" class="rounded-md px-2 py-0.5">${vi ? 'Tròn' : 'Circle'}</button>
                    <button type="button" data-photoshape="3x4" class="rounded-md px-2 py-0.5">${vi ? 'Ảnh thẻ 3×4' : '3×4 ID'}</button>
                  </div>
                  <button type="button" class="text-xs font-semibold text-slate-500 hover:text-rose-600" data-photo-remove>${vi ? 'Xóa' : 'Remove'}</button>
                </div>
                <div data-photo-quickbg class="hidden flex-wrap items-center gap-1.5 text-[11px]">
                  <span class="font-semibold text-slate-600">${vi ? 'Đổi phông nhanh:' : 'Quick bg:'}</span>
                  <button type="button" data-quickbg="#ffffff" class="inline-flex items-center gap-1 rounded border border-slate-300 bg-white px-2 py-0.5 font-semibold text-slate-700 hover:border-brand-500"><span class="h-2.5 w-2.5 rounded-full border border-slate-400 bg-white"></span>${vi ? 'Nền Trắng' : 'White'}</button>
                  <button type="button" data-quickbg="#1d70b8" class="inline-flex items-center gap-1 rounded border border-slate-300 bg-white px-2 py-0.5 font-semibold text-slate-700 hover:border-brand-500"><span class="h-2.5 w-2.5 rounded-full bg-[#1d70b8]"></span>${vi ? 'Xanh Ảnh thẻ' : 'ID Blue'}</button>
                  <button type="button" data-quickbg="#38bdf8" class="inline-flex items-center gap-1 rounded border border-slate-300 bg-white px-2 py-0.5 font-semibold text-slate-700 hover:border-brand-500"><span class="h-2.5 w-2.5 rounded-full bg-[#38bdf8]"></span>${vi ? 'Xanh Nhạt' : 'Sky'}</button>
                </div>
                <div data-photo-meta class="text-[11px] font-medium text-slate-500"></div>
              </div>
            </div>
          </div>`;
        }
        if (fd.type === 'textarea') return `<div>${label}<textarea id="${id}" name="${fd.name}" rows="${fd.rows || 4}" class="input text-sm">${val}</textarea></div>`;
        if (fd.type === 'select') {
          const cur = saved[fd.name] ?? fd.default;
          return `<div>${label}<select id="${id}" name="${fd.name}" class="input text-sm">${fd.options.map((o: string) => `<option${o === cur ? ' selected' : ''}>${escapeHtml(o)}</option>`).join('')}</select></div>`;
        }
        if (fd.type === 'color') {
          const touched = saved[fd.name] ? '1' : '';
          const cval = /^#[0-9a-f]{6}$/i.test(saved[fd.name] || '') ? saved[fd.name] : (tp.accent || '#1f55e6');
          return `<div>${label}<div class="flex items-center gap-2">
            <input id="${id}" name="${fd.name}" type="color" value="${cval}" data-touched="${touched}" class="h-9 w-12 cursor-pointer rounded border border-slate-300" />
            <button type="button" class="text-sm text-slate-500 hover:text-brand-700" data-color-auto>${vi ? 'Dùng màu của mẫu' : 'Use template colour'}</button>
          </div></div>`;
        }
        return `<div>${label}<input id="${id}" name="${fd.name}" type="${fd.type || 'text'}" value="${val}" class="input text-sm" /></div>`;
      }).join('');
      refreshPhotoMeta(photo).then(() => updatePhotoPreview());
      render();
    };

    const pick = (id: string, scroll = false) => {
      const prev = current();
      currentId = id;
      history.replaceState(null, '', location.pathname + '?template=' + id);
      markActive();
      if (prev.group === 'cv' && current().group === 'cv') {
        const color = fieldsEl.querySelector<HTMLInputElement>('input[type="color"]');
        if (color && color.dataset.touched !== '1') color.value = current().accent;
        render();
      } else buildFields();
      if (scroll && innerWidth < 1024) q('[data-doc-form]').scrollIntoView({ behavior: 'smooth' });
    };

    root.addEventListener('click', async (ev) => {
      const target = ev.target as HTMLElement;
      const k = target.closest<HTMLElement>('[data-kind]');
      if (k) return showKind(k.dataset.kind!);
      const p = target.closest<HTMLElement>('[data-pick]');
      if (p) return pick(p.dataset.pick!, true);
      const pal = target.closest<HTMLElement>('[data-palette]');
      if (pal) {
        palette = pal.dataset.palette!;
        drawPalettes(); drawGallery();
        if (palette && current().group === 'cv') pick(cvFor(current().layout, palette).id);
        return;
      }
      const tag = target.closest<HTMLElement>('[data-tag]');
      if (tag) {
        f.tag = tag.dataset.tag!; shown = PAGE;
        root.querySelectorAll('[data-tag]').forEach((b) => setOn(b, b === tag));
        return drawGallery();
      }
      if (target.closest('[data-cv-more]')) {
        const totalLen = filtered().length;
        shown = shown >= totalLen ? PAGE : totalLen;
        return drawGallery();
      }
      if (target.closest('[data-color-auto]')) {
        const input = fieldsEl.querySelector<HTMLInputElement>('input[type="color"]')!;
        input.dataset.touched = ''; input.value = current().accent; return render();
      }
      const shapeBtn = target.closest<HTMLElement>('[data-photoshape]');
      if (shapeBtn) {
        photoShape = shapeBtn.dataset.photoshape!;
        updatePhotoPreview();
        return render();
      }
      const qbg = target.closest<HTMLElement>('[data-quickbg]');
      if (qbg && (photoOrig || photo)) {
        try {
          await ensureAiSegmenter();
          const im = await loadImage(photoOrig || photo);
          const cv = document.createElement('canvas');
          const ratio = photoShape === '3x4' ? 3 / 4 : 1;
          cv.width = 450;
          cv.height = Math.round(450 / ratio);
          const ctx = cv.getContext('2d')!;
          const scale = Math.max(cv.width / im.width, cv.height / im.height);
          ctx.drawImage(im, (cv.width - im.width * scale) / 2, (cv.height - im.height * scale) / 2, im.width * scale, im.height * scale);
          replaceBackgroundCanvas(cv, qbg.dataset.quickbg!, 38, 2);
          photo = cv.toDataURL('image/jpeg', 0.88);
          await refreshPhotoMeta(photo);
          updatePhotoPreview();
          render();
        } catch { /* cross-origin or invalid */ }
        return;
      }
      if (target.closest('[data-photo-edit]') && (photoOrig || photo)) {
        const initState = photoEditState || { ratio: photoShape === '3x4' ? '3/4' : '1', outWidth: 472 };
        const res: any = await openImageEditor(photoOrig || photo, initState, lang);
        if (!res) return;
        photo = res.dataUrl;
        photoEditState = res.state;
        if (res.state?.ratio === '3/4' || res.state?.ratio === '2/3' || res.state?.ratio === '7/9') photoShape = '3x4';
        photoMeta = `${res.width}×${res.height} px · ${formatKb(res.bytes)}`;
        updatePhotoPreview();
        render();
        return;
      }
      if (target.closest('[data-photo-remove]')) {
        photo = ''; photoOrig = ''; photoMeta = ''; photoEditState = null;
        updatePhotoPreview(); render();
      }
    });
    root.querySelectorAll<HTMLSelectElement>('[data-f]').forEach((s) => s.addEventListener('change', () => {
      (f as any)[s.dataset.f!] = s.value; shown = PAGE; drawGallery();
    }));
    fieldsEl.addEventListener('input', (ev) => {
      const el = ev.target as HTMLInputElement;
      if (el.type === 'color') el.dataset.touched = '1';
      if (el.type !== 'file') render();
    });
    fieldsEl.addEventListener('change', async (ev) => {
      const el = ev.target as HTMLInputElement;
      if (el.tagName === 'SELECT') return render();
      if (!el.matches('[data-photo-input]') || !el.files?.[0]) return;
      try {
        photoOrig = await readPhoto(el.files[0]);
        photo = photoOrig;
        photoEditState = null;
        await refreshPhotoMeta(photo);
        updatePhotoPreview();
        render();
      } catch { /* unreadable image */ }
      el.value = '';
    });

    q('[data-action="print"]').addEventListener('click', () => gate(() => window.print()));
    q('[data-action="reset"]').addEventListener('click', () => buildFields(true));
    q('[data-action="html"]').addEventListener('click', () => {
      const html = `<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word"><head><meta charset="utf-8"><title>${escapeHtml(current().name)}</title></head><body>${preview.innerHTML}</body></html>`;
      gate(() => downloadBlob(`${current().id}.doc`, new Blob(['﻿' + html], { type: 'application/msword' })));
    });

    const cvGhInput = root.querySelector<HTMLInputElement>('[data-cv-gh-user]');
    const cvGhStatus = root.querySelector<HTMLElement>('[data-cv-gh-status]');
    const importGitHubToCv = async (username: string) => {
      const clean = username.trim().replace(/^@/, '');
      if (!clean) return;
      if (cvGhStatus) cvGhStatus.textContent = vi ? `⏳ Đang nạp @${clean}...` : `⏳ Loading @${clean}...`;
      try {
        const [uRes, rRes] = await Promise.all([
          fetch(`https://api.github.com/users/${encodeURIComponent(clean)}`),
          fetch(`https://api.github.com/users/${encodeURIComponent(clean)}/repos?sort=pushed&per_page=35`)
        ]);
        if (!uRes.ok) throw new Error(`HTTP ${uRes.status}`);
        const user = await uRes.json();
        const repos: any[] = rRes.ok ? await rRes.json() : [];
        const topRepos = [...repos].sort((a, b) => (b.stargazers_count || 0) - (a.stargazers_count || 0)).slice(0, 4);
        const totalStars = repos.reduce((s, r) => s + (r.stargazers_count || 0), 0);
        const langCounts: Record<string, number> = {};
        repos.forEach((r) => { if (r.language) langCounts[r.language] = (langCounts[r.language] || 0) + 1; });
        const topLangs = Object.entries(langCounts).sort((a, b) => b[1] - a[1]).slice(0, 7).map(([l, cnt], idx) => `${l}:${idx < 3 ? 5 : cnt > 2 ? 4 : 3}`);

        const setVal = (name: string, val: string) => {
          const el = fieldsEl.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`);
          if (el && val) el.value = val;
        };
        setVal('fullName', user.name || user.login);
        setVal('title', user.company ? `Senior Software Engineer @ ${user.company}` : (vi ? 'Kỹ sư Phần mềm & Tác giả Mã nguồn mở' : 'Full-Stack & Open-Source Engineer'));
        if (user.email) setVal('email', user.email);
        setVal('address', user.location || 'Remote / Global');
        setVal('website', user.blog || `github.com/${user.login}`);
        setVal('summary', user.bio || (vi
          ? `Kỹ sư phần mềm phát triển và duy trì ${user.public_repos || topRepos.length} dự án mã nguồn mở trên GitHub với tổng cộng ${totalStars.toLocaleString()}★ Stars và ${(user.followers || 0).toLocaleString()} người theo dõi.`
          : `Software engineer maintaining ${user.public_repos || topRepos.length} public repositories on GitHub with ${totalStars.toLocaleString()}★ stars and ${(user.followers || 0).toLocaleString()} followers.`));
        if (topLangs.length) setVal('skills', topLangs.join(', '));
        if (topRepos.length) {
          const expLines = topRepos.map((r) => {
            const yr = new Date(r.created_at || Date.now()).getFullYear() + ' – ' + new Date(r.pushed_at || Date.now()).getFullYear();
            const co = `GitHub (${r.language || 'Open Source'})`;
            const role = `Creator & Maintainer — ${r.name}`;
            const desc = `${r.description || 'Open-source project'}; Đạt ${(r.stargazers_count || 0).toLocaleString()}★ Stars & ${(r.forks_count || 0).toLocaleString()} Forks; Link: github.com/${user.login}/${r.name}`;
            return `${yr} | ${co} | ${role} | ${desc}`;
          });
          setVal('experience', expLines.join('\n'));
        }
        setVal('certificates', `${totalStars.toLocaleString()}★ Total GitHub Stars across ${user.public_repos || topRepos.length} Repositories\n${(user.followers || 0).toLocaleString()} GitHub Followers (${user.html_url})`);
        if (user.avatar_url) { photo = user.avatar_url; updatePhotoPreview(); }
        render();
        if (cvGhStatus) cvGhStatus.textContent = `✓ @${user.login} (${topRepos.length} repos, ★${totalStars.toLocaleString()})`;
      } catch {
        if (cvGhStatus) cvGhStatus.textContent = vi ? '⚠ Không tìm thấy hoặc vượt giới hạn GitHub API.' : '⚠ GitHub user not found or rate limited.';
      }
    };
    root.querySelector<HTMLElement>('[data-cv-gh-fetch]')?.addEventListener('click', () => importGitHubToCv(cvGhInput?.value || ''));
    cvGhInput?.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); importGitHubToCv(cvGhInput.value); } });
    root.querySelectorAll<HTMLElement>('[data-cv-gh-sample]').forEach((b) => b.addEventListener('click', () => {
      if (cvGhInput) cvGhInput.value = b.dataset.cvGhSample || '';
      importGitHubToCv(b.dataset.cvGhSample || '');
    }));
    let cvDice = 0;
    const cvDiceStyles = ['notionists', 'lorelei', 'croodles', 'adventurer', 'micah'];
    root.querySelector<HTMLElement>('[data-cv-dicebear]')?.addEventListener('click', () => {
      const nameVal = fieldsEl.querySelector<HTMLInputElement>('[name="fullName"]')?.value || 'Candidate';
      const st = cvDiceStyles[cvDice % cvDiceStyles.length];
      cvDice++;
      photo = `https://api.dicebear.com/9.x/${st}/svg?seed=${encodeURIComponent(nameVal + '-' + cvDice)}&backgroundColor=b6e3f4,c0aede,d1d4f9,ffd5dc,ffdfbf`;
      updatePhotoPreview(); render();
    });
    root.querySelectorAll<HTMLElement>('[data-cv-quick]').forEach((b) => b.addEventListener('click', () => {
      const [ly, pal] = (b.dataset.cvQuick || '').split(':');
      const targetCv = cvFor(ly, pal) || cvs.find((c) => c.layout === ly);
      if (targetCv) {
        palette = targetCv.palette;
        drawPalettes(); drawGallery();
        pick(targetCv.id);
      }
    }));
    window.addEventListener('resize', fit);

    // Direct CV Vector, Square Frame, Text & Block Canvas Editor
    let cvSel: HTMLElement | SVGElement | null = null;
    let cvHover: HTMLElement | SVGElement | null = null;
    let cvDragMode = false;
    let cvDragging: any = null;
    const cvUndoStack: string[] = [];
    const cvTagEl = root.querySelector<HTMLElement>('[data-cvs-tag]');
    const saveCvUndo = () => {
      if (cvSel) cvSel.removeAttribute('data-cv-sel');
      if (cvHover) cvHover.removeAttribute('data-cv-hover');
      const snap = preview.innerHTML;
      if (!cvUndoStack.length || cvUndoStack[cvUndoStack.length - 1] !== snap) {
        cvUndoStack.push(snap);
        if (cvUndoStack.length > 25) cvUndoStack.shift();
      }
      if (cvSel) cvSel.setAttribute('data-cv-sel', '1');
    };
    const isSvgNode = (el: any) => !!(el && (el.tagName === 'svg' || el.tagName === 'SVG' || el.ownerSVGElement));
    const getCvTarget = (raw: any): HTMLElement | SVGElement | null => {
      if (!raw || raw === preview || !preview.contains(raw)) return null;
      if (isSvgNode(raw)) return raw.ownerSVGElement || raw;
      return raw as HTMLElement;
    };
    const isCvTextLike = (el: any) => {
      if (!el || isSvgNode(el) || el.tagName === 'IMG') return false;
      const t = String(el.tagName || '').toUpperCase();
      if (['H1', 'H2', 'H3', 'H4', 'P', 'SPAN', 'B', 'STRONG', 'EM', 'I', 'SMALL', 'LI', 'TD', 'TH', 'A'].includes(t)) return true;
      return el.children.length === 0 && (el.textContent || '').trim().length > 0;
    };
    const getCvTf = (el: HTMLElement | SVGElement) => ({
      sc: parseFloat(el.getAttribute('data-cvs-sc') || '1') || 1,
      rot: parseFloat(el.getAttribute('data-cvs-rot') || '0') || 0,
      tx: parseFloat(el.getAttribute('data-cvs-tx') || '0') || 0,
      ty: parseFloat(el.getAttribute('data-cvs-ty') || '0') || 0
    });
    const applyCvTf = (el: HTMLElement | SVGElement, st: { sc: number; rot: number; tx: number; ty: number }) => {
      el.setAttribute('data-cvs-sc', String(st.sc));
      el.setAttribute('data-cvs-rot', String(st.rot));
      el.setAttribute('data-cvs-tx', String(st.tx));
      el.setAttribute('data-cvs-ty', String(st.ty));
      (el as HTMLElement).style.transform = `translate(${st.tx}px,${st.ty}px) rotate(${st.rot}deg) scale(${st.sc})`;
    };
    const selectCvEl = (el: HTMLElement | SVGElement | null, enableEdit = false) => {
      if (!el || el === preview) return;
      if (cvSel && cvSel !== el) {
        cvSel.removeAttribute('data-cv-sel');
        if ((cvSel as HTMLElement).isContentEditable) cvSel.removeAttribute('contenteditable');
      }
      cvSel = el;
      cvSel.setAttribute('data-cv-sel', '1');
      if (cvTagEl) {
        const t = String(cvSel.tagName || '').toUpperCase();
        cvTagEl.textContent = isSvgNode(cvSel) ? '✦ Vector SVG' : t === 'IMG' ? '🖼 Ảnh CV' : isCvTextLike(cvSel) ? `✎ Chữ (${t})` : `⬜ Khung (${t})`;
      }
      if (enableEdit && isCvTextLike(cvSel) && !cvDragMode) {
        cvSel.setAttribute('contenteditable', 'true');
        try { (cvSel as HTMLElement).focus(); } catch {}
      }
    };
    preview.addEventListener('mouseover', (ev) => {
      const t = getCvTarget(ev.target);
      if (cvHover && cvHover !== t) cvHover.removeAttribute('data-cv-hover');
      if (t && t !== cvSel) { cvHover = t; cvHover.setAttribute('data-cv-hover', '1'); }
    });
    preview.addEventListener('mouseout', (ev) => {
      if (cvHover && ev.target === cvHover) { cvHover.removeAttribute('data-cv-hover'); cvHover = null; }
    });
    preview.addEventListener('click', (ev) => {
      const t = getCvTarget(ev.target);
      if (!t) return;
      ev.stopPropagation();
      saveCvUndo();
      selectCvEl(t, true);
    });
    preview.addEventListener('pointerdown', (ev) => {
      if (!cvDragMode && !ev.altKey) return;
      const t = getCvTarget(ev.target);
      if (!t) return;
      ev.preventDefault();
      ev.stopPropagation();
      selectCvEl(t, false);
      saveCvUndo();
      const st = getCvTf(cvSel!);
      cvDragging = { el: cvSel, startX: ev.clientX, startY: ev.clientY, origX: st.tx, origY: st.ty, st };
    });
    window.addEventListener('pointermove', (ev) => {
      if (!cvDragging) return;
      cvDragging.st.tx = Math.round(cvDragging.origX + (ev.clientX - cvDragging.startX));
      cvDragging.st.ty = Math.round(cvDragging.origY + (ev.clientY - cvDragging.startY));
      applyCvTf(cvDragging.el, cvDragging.st);
    });
    window.addEventListener('pointerup', () => { cvDragging = null; });

    root.querySelector('[data-cvs-parent]')?.addEventListener('click', () => {
      if (cvSel && cvSel.parentElement && cvSel.parentElement !== preview) selectCvEl(cvSel.parentElement, false);
    });
    root.querySelector('[data-cvs-vec]')?.addEventListener('click', () => {
      const v = (cvSel || preview).querySelector('svg') || preview.querySelector('svg');
      if (v) selectCvEl(v, false);
    });
    root.querySelector<HTMLInputElement>('[data-cvs-fg]')?.addEventListener('input', (ev) => {
      if (!cvSel) return;
      saveCvUndo();
      const c = (ev.target as HTMLInputElement).value;
      if (isSvgNode(cvSel)) {
        (cvSel as HTMLElement).style.color = c;
        cvSel.setAttribute('stroke', c);
        cvSel.querySelectorAll('path,rect,circle,polygon,ellipse,line').forEach((sh, i) => {
          if (sh.getAttribute('fill') && sh.getAttribute('fill') !== 'none') sh.setAttribute('fill', i % 2 ? c + '33' : c);
          if (sh.getAttribute('stroke') && sh.getAttribute('stroke') !== 'none') sh.setAttribute('stroke', c);
        });
      } else (cvSel as HTMLElement).style.color = c;
    });
    root.querySelector<HTMLInputElement>('[data-cvs-bg]')?.addEventListener('input', (ev) => {
      if (!cvSel) return; saveCvUndo(); (cvSel as HTMLElement).style.backgroundColor = (ev.target as HTMLInputElement).value;
    });
    root.querySelector('[data-cvs-bg-clear]')?.addEventListener('click', () => {
      if (!cvSel) return; saveCvUndo(); (cvSel as HTMLElement).style.background = 'transparent';
    });
    root.querySelector<HTMLInputElement>('[data-cvs-bdr]')?.addEventListener('input', (ev) => {
      if (!cvSel) return; saveCvUndo();
      const c = (ev.target as HTMLInputElement).value;
      if (isSvgNode(cvSel)) {
        cvSel.setAttribute('stroke', c);
        cvSel.querySelectorAll('path,rect,circle,polygon,ellipse,line').forEach((sh) => sh.setAttribute('stroke', c));
      } else {
        const st = (cvSel as HTMLElement).style;
        if (!st.borderStyle || st.borderStyle === 'none') st.border = `2px solid ${c}`;
        else st.borderColor = c;
      }
    });
    root.querySelectorAll<HTMLElement>('[data-cvs-rad]').forEach((b) => b.addEventListener('click', () => {
      if (!cvSel) return; saveCvUndo();
      const target = (isSvgNode(cvSel) ? cvSel.parentElement || cvSel : cvSel) as HTMLElement;
      target.style.borderRadius = b.dataset.cvsRad!;
    }));
    let cvBdrIdx = 0;
    const cvBdrModes = ['0px none', '1.5px solid currentColor', '2.5px solid currentColor', '2px dashed currentColor', '3px double currentColor'];
    root.querySelector('[data-cvs-bdr-cycle]')?.addEventListener('click', () => {
      if (!cvSel) return; saveCvUndo();
      cvBdrIdx = (cvBdrIdx + 1) % cvBdrModes.length;
      (cvSel as HTMLElement).style.border = cvBdrModes[cvBdrIdx];
    });
    let cvShIdx = 0;
    const cvShModes = ['none', '0 8px 20px rgba(0,0,0,.14)', '4px 4px 0 currentColor'];
    root.querySelector('[data-cvs-shadow]')?.addEventListener('click', () => {
      if (!cvSel) return; saveCvUndo();
      cvShIdx = (cvShIdx + 1) % cvShModes.length;
      (cvSel as HTMLElement).style.boxShadow = cvShModes[cvShIdx];
    });
    root.querySelectorAll<HTMLElement>('[data-cvs-scale]').forEach((b) => b.addEventListener('click', () => {
      if (!cvSel) return; saveCvUndo();
      const d = parseFloat(b.dataset.cvsScale || '0');
      if (isCvTextLike(cvSel) && !isSvgNode(cvSel)) {
        const cur = parseFloat(getComputedStyle(cvSel as HTMLElement).fontSize) || 13;
        (cvSel as HTMLElement).style.fontSize = `${Math.max(9, Math.round(cur * (d > 0 ? 1.1 : 0.9)))}px`;
      } else {
        const st = getCvTf(cvSel); st.sc = Math.max(0.3, Math.min(3.5, Number((st.sc + d).toFixed(2)))); applyCvTf(cvSel, st);
      }
    }));
    root.querySelectorAll<HTMLElement>('[data-cvs-rot]').forEach((b) => b.addEventListener('click', () => {
      if (!cvSel) return; saveCvUndo();
      const st = getCvTf(cvSel); st.rot += Number(b.dataset.cvsRot || 0); applyCvTf(cvSel, st);
    }));
    const cvDragBtn = root.querySelector<HTMLElement>('[data-cvs-drag]');
    cvDragBtn?.addEventListener('click', () => {
      cvDragMode = !cvDragMode;
      cvDragBtn.classList.toggle('!bg-blue-600', cvDragMode);
    });
    const CV_VECS: Record<string, string> = {
      square: '<svg data-cv-vec="1" width="38" height="38" viewBox="0 0 40 40" fill="none" stroke="#1d4ed8" stroke-width="2.5" style="display:inline-block;vertical-align:middle;cursor:pointer"><rect x="4" y="4" width="32" height="32" fill="#1d4ed822"/><rect x="12" y="12" width="16" height="16" fill="#1d4ed8"/></svg>',
      circle: '<svg data-cv-vec="1" width="38" height="38" viewBox="0 0 40 40" fill="none" stroke="#1d4ed8" stroke-width="2.5" style="display:inline-block;vertical-align:middle;cursor:pointer"><circle cx="20" cy="20" r="15" fill="#1d4ed822"/><circle cx="20" cy="20" r="6" fill="#1d4ed8"/></svg>',
      star: '<svg data-cv-vec="1" width="38" height="38" viewBox="0 0 40 40" fill="#1d4ed8" style="display:inline-block;vertical-align:middle;cursor:pointer"><path d="M20 2 L24.5 15.5 L38 20 L24.5 24.5 L20 38 L15.5 24.5 L2 20 L15.5 15.5 Z"/></svg>',
      bauhaus: '<svg data-cv-vec="1" width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="#0f172a" stroke-width="2" style="display:inline-block;vertical-align:middle;cursor:pointer"><rect x="4" y="4" width="18" height="18" fill="#ef4444"/><circle cx="26" cy="26" r="10" fill="#f59e0b"/></svg>',
      hex: '<svg data-cv-vec="1" width="38" height="38" viewBox="0 0 40 40" fill="none" stroke="#059669" stroke-width="2.5" style="display:inline-block;vertical-align:middle;cursor:pointer"><polygon points="20,3 35,11.5 35,28.5 20,37 5,28.5 5,11.5" fill="#05966922"/><circle cx="20" cy="20" r="6" fill="#059669"/></svg>',
      seal: '<svg data-cv-vec="1" width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="#dc2626" stroke-width="2" style="display:inline-block;vertical-align:middle;cursor:pointer"><rect x="3" y="3" width="34" height="34" rx="5" fill="#dc2626"/><path d="M12,15 H28 M20,10 V30 M12,24 H28" stroke="#fff" stroke-width="2.5"/></svg>'
    };
    root.querySelector<HTMLSelectElement>('[data-cvs-vec-swap]')?.addEventListener('change', (ev) => {
      const selEl = ev.target as HTMLSelectElement;
      const k = selEl.value; if (!k || !CV_VECS[k]) return;
      saveCvUndo();
      const wrap = document.createElement('div'); wrap.innerHTML = CV_VECS[k];
      const svg = wrap.firstElementChild as SVGElement;
      if (cvSel && isSvgNode(cvSel)) cvSel.replaceWith(svg);
      else if (cvSel) cvSel.insertAdjacentElement('afterbegin', svg);
      else preview.firstElementChild?.insertAdjacentElement('afterbegin', svg);
      selectCvEl(svg, false);
      selEl.value = '';
    });
    const insertCvSvg = (svgMarkup: string) => {
      saveCvUndo();
      const wrap = document.createElement('div'); wrap.innerHTML = svgMarkup;
      const svg = (wrap.querySelector('svg') || wrap.firstElementChild) as SVGElement | null;
      if (!svg) return;
      svg.setAttribute('data-cv-vec', '1');
      if (!svg.getAttribute('width')) svg.setAttribute('width', '36');
      if (!svg.getAttribute('height')) svg.setAttribute('height', '36');
      (svg as unknown as HTMLElement).style.cssText = 'display:inline-block;vertical-align:middle;cursor:pointer;color:#1d4ed8';
      if (cvSel && isSvgNode(cvSel)) cvSel.replaceWith(svg);
      else if (cvSel) cvSel.insertAdjacentElement('afterbegin', svg);
      else preview.firstElementChild?.insertAdjacentElement('afterbegin', svg);
      selectCvEl(svg, false);
    };
    const cvOssTray = root.querySelector<HTMLElement>('[data-cvs-oss-tray]');
    const cvOssQ = root.querySelector<HTMLInputElement>('[data-cvs-oss-q]');
    const searchCvIconify = async () => {
      const q = (cvOssQ?.value || '').trim() || 'award';
      if (!cvOssTray) return;
      cvOssTray.classList.remove('hidden');
      cvOssTray.classList.add('flex');
      cvOssTray.innerHTML = `<span class="text-[10.5px] text-blue-300">⏳ ${vi ? 'Đang tải Vector mã nguồn mở (Iconify)...' : 'Loading open-source vectors...'}</span>`;
      try {
        const res = await fetch(`https://api.iconify.design/search?query=${encodeURIComponent(q)}&limit=16`);
        const d = await res.json();
        const icons: string[] = d?.icons || [];
        if (!icons.length) {
          cvOssTray.innerHTML = `<span class="text-[10.5px] text-rose-300">${vi ? 'Không tìm thấy vector. Thử từ khóa tiếng Anh (vd: star, code, award, briefcase)' : 'No vectors found.'}</span>`;
          return;
        }
        cvOssTray.innerHTML = `<span class="text-[10px] font-bold text-blue-300">${vi ? 'Chạm để chèn:' : 'Click to insert:'}</span>`;
        icons.forEach((ic) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.title = ic;
          b.className = 'inline-flex items-center justify-center rounded border border-slate-600 bg-slate-800 p-1 hover:bg-blue-600';
          b.innerHTML = `<img src="https://api.iconify.design/${ic}.svg?color=%23ffffff&height=18" width="18" height="18" alt="${ic}" />`;
          b.addEventListener('click', async () => {
            const r = await fetch(`https://api.iconify.design/${ic}.svg?height=38`);
            const txt = await r.text();
            if (txt.includes('<svg')) insertCvSvg(txt);
          });
          cvOssTray.appendChild(b);
        });
      } catch {
        cvOssTray.innerHTML = `<span class="text-[10.5px] text-rose-300">Error</span>`;
      }
    };
    root.querySelector('[data-cvs-oss-btn]')?.addEventListener('click', searchCvIconify);
    cvOssQ?.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); searchCvIconify(); } });
    root.querySelector('[data-cvs-qr]')?.addEventListener('click', async () => {
      const val = window.prompt(vi ? 'Nhập Link Portfolio, LinkedIn, Zalo để tạo Mã QR Vector chèn vào CV:' : 'Enter Portfolio, LinkedIn or contact URL for QR Vector:', 'https://linkedin.com/in/');
      if (!val) return;
      try {
        const r = await fetch(`https://api.qrserver.com/v1/create-qr-code/?size=110x110&format=svg&margin=2&data=${encodeURIComponent(val.trim())}`);
        const svgTxt = await r.text();
        if (svgTxt.includes('<svg')) insertCvSvg(svgTxt);
      } catch {}
    });
    root.querySelector('[data-cvs-add-box]')?.addEventListener('click', () => {
      saveCvUndo();
      const box = document.createElement('div');
      box.style.cssText = 'padding:12px 14px;border:2px solid #1d4ed8;border-radius:8px;background:rgba(29,78,216,.04);margin:10px 0;display:flex;align-items:center;gap:10px';
      box.innerHTML = `${CV_VECS.square}<div><b style="display:block;font-size:13px">Khung Vuông Điểm Nhấn Mới</b><span style="font-size:11.5px;opacity:.85">Bấm vào để sửa chữ, đổi màu khung, bo góc hoặc kéo di chuyển.</span></div>`;
      if (cvSel && cvSel !== preview) (isSvgNode(cvSel) ? cvSel.parentElement || cvSel : cvSel).insertAdjacentElement('afterend', box);
      else (preview.firstElementChild || preview).appendChild(box);
      selectCvEl(box, false);
    });
    root.querySelector('[data-cvs-dup]')?.addEventListener('click', () => {
      if (!cvSel || cvSel === preview) return; saveCvUndo();
      const cl = cvSel.cloneNode(true) as HTMLElement;
      cl.removeAttribute('data-cv-sel');
      cvSel.insertAdjacentElement('afterend', cl);
      selectCvEl(cl, false);
    });
    root.querySelector('[data-cvs-del]')?.addEventListener('click', () => {
      if (!cvSel || cvSel === preview) return; saveCvUndo();
      cvSel.remove(); cvSel = null;
    });
    root.querySelector('[data-cvs-undo]')?.addEventListener('click', () => {
      if (!cvUndoStack.length) return;
      preview.innerHTML = cvUndoStack.pop()!;
      cvSel = null;
      fit();
    });

    showKind(kind);
    drawPalettes();
    drawGallery();
    markActive();
    buildFields();
  });
</script>
