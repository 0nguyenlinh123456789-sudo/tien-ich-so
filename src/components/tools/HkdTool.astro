---
// Thuế hộ kinh doanh 2026. Logic: src/lib/hkd.js
import { SECTORS } from '../../lib/hkd.js';
interface Props { lang?: 'vi' | 'en'; }
const { lang = 'vi' } = Astro.props;
const vi = lang === 'vi';
---
<div data-tool="hkd" data-lang={lang} class="grid gap-5 lg:grid-cols-2">
  <form class="card grid content-start gap-3" data-f>
    <div><label class="label">{vi ? 'Doanh thu cả năm (đồng)' : 'Annual revenue (VND)'}</label><input class="input text-lg" name="rev" data-money inputmode="numeric" value="2.000.000.000" /></div>
    <div><label class="label">{vi ? 'Ngành nghề' : 'Business sector'}</label><select class="input" name="sector">{SECTORS.map((s) => <option value={s.id}>{vi ? s.vi : s.en}</option>)}</select></div>
    <div data-exp><label class="label">{vi ? 'Chi phí có hóa đơn cả năm (tùy chọn)' : 'Invoiced expenses per year (optional)'}</label><input class="input" name="exp" data-money inputmode="numeric" value="" /></div>
  </form>
  <div class="card" data-out></div>
</div>

<script>
  import { hkdTax, THRESHOLD } from '../../lib/hkd.js';

  document.querySelectorAll<HTMLElement>('[data-tool="hkd"]').forEach((root) => {
    const vi = root.dataset.lang !== 'en';
    const form = root.querySelector<HTMLFormElement>('[data-f]')!;
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    const n = (x: number) => (Number.isFinite(x) ? Math.round(x) : 0).toLocaleString('vi-VN');
    const pct = (x: number) => (x * 100).toLocaleString(vi ? 'vi-VN' : 'en-US', { maximumFractionDigits: 2 }) + '%';
    const money = (k: string) => Number(String(new FormData(form).get(k) ?? '').replace(/\D/g, '').slice(0, 15)) || 0;
    form.querySelectorAll<HTMLInputElement>('[data-money]').forEach((el) => el.addEventListener('input', () => { const d = el.value.replace(/\D/g, '').slice(0, 15); el.value = d ? Number(d).toLocaleString('vi-VN') : ''; }));
    const note = (s: string) => `<p class="mt-3 text-xs text-slate-500">${s}</p>`;
    const row = (l: string, v: string, b = false) => `<div class="flex justify-between gap-3 py-1 text-sm ${b ? 'font-semibold' : ''}"><span class="min-w-0 break-words">${l}</span><span class="shrink-0 whitespace-nowrap">${v}</span></div>`;
    const d = vi ? ' đ' : ' VND';

    const calc = () => {
      const sector = String(new FormData(form).get('sector'));
      const r = hkdTax(money('rev'), sector, money('exp'));
      root.querySelector<HTMLElement>('[data-exp]')!.hidden = !!r.sector.rent || r.revenue <= THRESHOLD;
      let h = `<div class="text-sm text-slate-500">${vi ? 'Tổng thuế phải nộp / năm' : 'Total tax per year'}</div><div class="text-4xl font-extrabold text-brand-700">${n(r.total)}${d}</div><div class="mt-1 text-sm text-slate-600">≈ ${n(r.monthly)}${d}${vi ? '/tháng' : '/month'}</div>`;
      if (r.missingExpenses) h += `<div class="mt-3 rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm font-semibold text-amber-800">${vi ? 'Doanh thu trên 3 tỷ bắt buộc tính theo thu nhập – nhập chi phí có hóa đơn để ra số đúng' : 'Revenue above 3 bn must use the income method – enter invoiced expenses for an accurate figure'}</div>`;
      if (r.exempt) {
        h += note(vi ? `Doanh thu ≤ ${n(THRESHOLD)} đ/năm: không phải nộp thuế GTGT và thuế TNCN.` : `Revenue ≤ ${n(THRESHOLD)} VND/year: no VAT and no PIT.`);
      } else {
        h += `<div class="mt-4 border-t pt-2">${row(vi ? 'Thuế GTGT' : 'VAT', `${n(r.vat)}${d}`)}${row(vi ? 'Thuế TNCN' : 'PIT', `${n(r.pit)}${d}`)}</div>`;
        h += note((vi ? `GTGT = ${n(r.revenue)} × ${pct(r.sector.vat)}` : `VAT = ${n(r.revenue)} × ${pct(r.sector.vat)}`) + (r.sector.vatEst ? (vi ? ' (tỷ lệ ước tính)' : ' (estimated rate)') : '') + (vi ? '. Ước tính trên toàn bộ doanh thu theo phương pháp trực tiếp, Luật Thuế GTGT 48/2024/QH15.' : '. Estimated on total revenue, direct method, VAT Law 48/2024/QH15.'));
        if (r.mode === 'rent') {
          h += note(vi ? `TNCN = (${n(r.revenue)} − ${n(THRESHOLD)}) × 5%. Cho thuê bất động sản không áp dụng phương pháp thu nhập (khoản 4 Điều 7 Luật 109/2025/QH15).` : `PIT = (revenue − 1 bn) × 5%. Real-estate leasing has no income method (Law 109/2025/QH15, Art. 7(4)).`);
        } else if (r.mode === 'choice') {
          const tag = (k: string) => (r.lower === k ? ` <span class="rounded bg-green-100 px-1 text-green-700">${vi ? 'thấp hơn' : 'lower'}</span>` : '');
          h += `<div class="mt-3 rounded border p-2 text-sm"><div class="mb-1 font-semibold">${vi ? 'So sánh 2 cách tính TNCN (doanh thu 1–3 tỷ được chọn)' : 'Compare 2 PIT methods (revenue 1–3 bn may choose)'}</div>`
            + row(`(A) ${vi ? 'Tỷ lệ' : 'Rate'}: (${n(r.revenue)} − ${n(THRESHOLD)}) × ${pct(r.sector.pit)}${tag('rate')}`, `${n(r.rateAmt!)}${d}`)
            + row(`(B) ${vi ? 'Thu nhập' : 'Income'}: max(0, ${n(r.revenue)} − ${n(r.expenses)}) × 15%${tag('income')}`, `${n(r.incomeAmt!)}${d}`)
            + `</div>` + note(vi ? 'Tổng thuế ở trên lấy phương án thấp hơn. Phương pháp thu nhập cần sổ sách, chứng từ chi phí hợp lệ; để trống chi phí nghĩa là 0.' : 'Total above uses the lower option. The income method requires bookkeeping and valid expense records.');
        } else {
          h += note(vi ? `Doanh thu trên 3 tỷ: bắt buộc tính theo thu nhập. TNCN = max(0, ${n(r.revenue)} − ${n(r.expenses)}) × ${pct(r.incomeRate!)}${r.revenue > 50_000_000_000 ? ' (doanh thu trên 50 tỷ)' : ''}.` : `Revenue above 3 bn: income method required. PIT = (revenue − expenses) × ${pct(r.incomeRate!)}.`);
        }
      }
      h += `<details class="mt-3 text-xs text-slate-500"><summary class="cursor-pointer">${vi ? 'Căn cứ pháp lý' : 'Legal basis'}</summary><p class="mt-1">${vi ? 'Từ 01/01/2026 bỏ thuế khoán và bỏ lệ phí môn bài (Điều 10 NQ 198/2025/QH15). Điều 7 Luật Thuế TNCN 109/2025/QH15; ngưỡng 1 tỷ theo NĐ 141/2026/NĐ-CP; Luật Thuế GTGT 48/2024/QH15.' : 'Presumptive tax and business licence fee abolished from 01/01/2026 (Resolution 198/2025/QH15, Art. 10). PIT Law 109/2025/QH15 Art. 7; 1 bn threshold per Decree 141/2026/ND-CP; VAT Law 48/2024/QH15.'}</p></details>`;
      h += `<p class="mt-3 text-xs font-semibold text-amber-700">${vi ? 'Kết quả ước tính, đối chiếu với cơ quan thuế trước khi kê khai.' : 'Estimate only; confirm with the tax authority before filing.'}</p>`;
      out.innerHTML = h;
    };
    form.addEventListener('input', calc);
    form.addEventListener('change', calc);
    calc();
  });
</script>
