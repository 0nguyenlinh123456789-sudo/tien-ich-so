---
interface Props { lang?: 'vi' | 'en'; }
const { lang = 'vi' } = Astro.props;
const vi = lang === 'vi';
---
<div data-tool="pregnancy" data-lang={lang} class="grid gap-5 lg:grid-cols-2">
  <form class="card grid min-w-0 content-start gap-3" data-f>
    <svg class="viz-art" viewBox="0 0 240 56" aria-hidden="true" focusable="false"><circle cx="28" cy="28" r="22" fill="#fce7f3"/><path d="M28 40s-12-7-12-15a7 7 0 0 1 12-4 7 7 0 0 1 12 4c0 8-12 15-12 15z" fill="#ec4899"/><path d="M62 28h16" stroke="#94a3b8" stroke-width="3" stroke-linecap="round" stroke-dasharray="4 4"/><rect x="88" y="10" width="64" height="40" rx="6" fill="#fff" stroke="#2f6bff" stroke-width="2.5"/><rect x="88" y="10" width="64" height="11" rx="5" fill="#2f6bff"/><path d="M102 6v8M138 6v8" stroke="#1a45b8" stroke-width="3" stroke-linecap="round"/><circle cx="120" cy="35" r="7" fill="#f5b83d"/><rect x="164" y="24" width="20" height="8" rx="4" fill="#93b8ff"/><rect x="186" y="24" width="20" height="8" rx="4" fill="#2f6bff"/><rect x="208" y="24" width="26" height="8" rx="4" fill="#ec4899"/></svg>
    <div><label class="label">{vi ? 'Ngày đầu kỳ kinh gần nhất' : 'First day of last period'}</label><input class="input" name="lmp" type="date" /></div>
    <div><label class="label">{vi ? 'Độ dài chu kỳ (ngày)' : 'Cycle length (days)'}</label><input class="input" name="c" type="number" min="21" max="45" value="28" /></div>
    <p class="text-xs text-slate-500">{vi ? 'Ngày dự sinh theo quy tắc Naegele (kỳ kinh cuối + 280 ngày, chỉnh theo chu kỳ). Rụng trứng ước tính 14 ngày trước kỳ kinh sau. Chỉ để tham khảo, siêu âm và bác sĩ cho kết quả chính xác hơn.' : 'Due date by Naegele’s rule (LMP + 280 days, adjusted for cycle). Ovulation ≈ 14 days before the next period. Reference only.'}</p>
  </form>
  <div class="card min-w-0" data-out></div>
</div>

<script>
  import { progress, timeline } from '../../lib/viz.js';
  document.querySelectorAll<HTMLElement>('[data-tool="pregnancy"]').forEach((root) => {
    const vi = root.dataset.lang !== 'en';
    const form = root.querySelector<HTMLFormElement>('[data-f]')!;
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    const lmpIn = form.elements.namedItem('lmp') as HTMLInputElement;
    const today = new Date(); today.setHours(0, 0, 0, 0);
    if (!lmpIn.value) { const d = new Date(today); d.setDate(d.getDate() - 14); lmpIn.value = d.toISOString().slice(0, 10); }
    const add = (d: Date, k: number) => { const x = new Date(d); x.setDate(x.getDate() + k); return x; };
    const f = (d: Date) => d.toLocaleDateString(vi ? 'vi-VN' : 'en-GB', { weekday: 'short', day: 'numeric', month: 'numeric', year: 'numeric' });
    const calc = () => {
      if (!lmpIn.value) { out.innerHTML = ''; return; }
      const lmp = new Date(lmpIn.value + 'T00:00:00');
      const c = Math.min(45, Math.max(21, Number((form.elements.namedItem('c') as HTMLInputElement).value) || 28));
      const due = add(lmp, 280 + (c - 28));
      const days = Math.round((+today - +lmp) / 864e5);
      const ov = add(lmp, c - 14);
      const pregnant = days >= c;
      const w = Math.floor(days / 7), d = days % 7;
      const tri = w < 13 ? 1 : w < 27 ? 2 : 3;
      const next = [0, 1, 2].map((k) => add(lmp, c * k + c - 14));
      out.innerHTML = pregnant && days <= 300 ? `
        <div class="text-sm text-slate-500">${vi ? 'Ngày dự sinh' : 'Due date'}</div>
        <div class="text-4xl font-extrabold text-brand-700">${f(due)}</div>
        <div class="mt-2 text-lg font-semibold">${vi ? `Thai ${w} tuần ${d} ngày · Tam cá nguyệt ${tri}` : `${w} weeks ${d} days · Trimester ${tri}`}</div>
        <div class="text-sm text-slate-500">${vi ? `Còn ${Math.max(0, Math.round((+due - +today) / 864e5))} ngày` : `${Math.max(0, Math.round((+due - +today) / 864e5))} days to go`}</div>
        ${progress(Math.min(280, days) / 280, vi ? `Tuần ${w}/40 của thai kỳ` : `Week ${w} of 40`)}
        ${timeline([
          { date: `${f(lmp)} – ${f(add(lmp, 13 * 7 - 1))}`, title: vi ? 'Tam cá nguyệt 1 (tuần 1–12)' : 'Trimester 1 (weeks 1–12)', state: tri > 1 ? 'done' : 'now' },
          { date: `${f(add(lmp, 13 * 7))} – ${f(add(lmp, 27 * 7 - 1))}`, title: vi ? 'Tam cá nguyệt 2 (tuần 13–26)' : 'Trimester 2 (weeks 13–26)', state: tri > 2 ? 'done' : tri === 2 ? 'now' : 'next' },
          { date: `${f(add(lmp, 27 * 7))} – ${f(due)}`, title: vi ? 'Tam cá nguyệt 3 (tuần 27–40)' : 'Trimester 3 (weeks 27–40)', state: tri === 3 ? 'now' : 'next' }
        ], { title: vi ? 'Các giai đoạn thai kỳ' : 'Pregnancy stages' })}`
      : `
        <div class="text-sm text-slate-500">${vi ? 'Ngày rụng trứng dự kiến' : 'Estimated ovulation'}</div>
        <div class="text-4xl font-extrabold text-rose-600">${f(ov)}</div>
        <div class="mt-2 text-sm"><b>${vi ? 'Cửa sổ dễ thụ thai' : 'Fertile window'}:</b> ${f(add(ov, -5))} – ${f(add(ov, 1))}</div>
        <div class="mt-1 text-sm"><b>${vi ? 'Kỳ kinh tiếp theo' : 'Next period'}:</b> ${f(add(lmp, c))}</div>
        <div class="mt-1 text-sm"><b>${vi ? 'Nếu thụ thai, dự sinh' : 'If conceived, due'}:</b> ${f(due)}</div>
        <div class="mt-4 text-sm text-slate-500">${vi ? 'Rụng trứng 3 chu kỳ tới' : 'Next 3 ovulations'}: ${next.map(f).join(' · ')}</div>`;
    };
    form.addEventListener('input', calc);
    calc();
  });
</script>
