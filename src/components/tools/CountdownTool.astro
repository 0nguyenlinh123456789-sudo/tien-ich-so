---
interface Props { lang?: 'vi' | 'en'; }
const { lang = 'vi' } = Astro.props;
const vi = lang === 'vi';
---
<div data-tool="countdown" data-lang={lang} class="grid gap-5">
  <div class="card min-w-0 text-center">
    <svg class="viz-art mx-auto" viewBox="0 0 240 56" aria-hidden="true" focusable="false"><path d="M96 4h28M96 52h28" stroke="#1a45b8" stroke-width="4" stroke-linecap="round"/><path d="M100 6c0 14 20 16 20 22s-20 8-20 22h20c0-14-20-16-20-22s20-8 20-22z" fill="#d9eaff" stroke="#2f6bff" stroke-width="2.5" stroke-linejoin="round"/><path d="M104 14h12l-6 9zM103 49c2-8 12-8 14 0z" fill="#f5b83d"/><path d="M110 24v20" stroke="#f5b83d" stroke-width="1.5" stroke-dasharray="2 3"/><g fill="#e11d48"><circle cx="46" cy="18" r="3"/><circle cx="196" cy="14" r="3"/></g><g fill="#2f6bff"><circle cx="64" cy="38" r="2.5"/><circle cx="176" cy="40" r="2.5"/></g><path d="M30 34l8-4M202 30l10 2M150 20l8-6M70 14l8 4" stroke="#f5b83d" stroke-width="3" stroke-linecap="round"/></svg>
    <div data-main></div>
  </div>
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-list></div>
  <div class="card min-w-0" data-tl></div>
  <form class="card grid gap-3 sm:grid-cols-[1fr_auto_auto]" data-f>
    <input class="input" name="name" aria-label={vi ? "Tên sự kiện" : "Event name"} placeholder={vi ? 'Sự kiện của bạn (cưới, thi, sinh nhật…)' : 'Your event'} />
    <input class="input" name="date" aria-label={vi ? "Ngày diễn ra" : "Event date"} type="date" required />
    <button class="btn-primary" type="submit">{vi ? 'Đếm ngược & lấy link' : 'Count down & get link'}</button>
  </form>
</div>

<script>
  import { escapeHtml as esc } from '../../lib/format.js';
  import { solarToLunar } from '../../lib/lunar.js';
  import { timeline } from '../../lib/viz.js';

  document.querySelectorAll<HTMLElement>('[data-tool="countdown"]').forEach((root) => {
    const vi = root.dataset.lang !== 'en';
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    const now = new Date();
    const tet = (y: number) => {
      for (let k = 0; k < 50; k++) {
        const d = new Date(y, 0, 15 + k);
        const l = solarToLunar(d.getDate(), d.getMonth() + 1, d.getFullYear());
        if (l.day === 1 && l.month === 1 && !l.leap) return d;
      }
      return null;
    };
    const next = (m: number, d: number) => { const t = new Date(now.getFullYear(), m - 1, d); return t < now ? new Date(now.getFullYear() + 1, m - 1, d) : t; };
    const tt = tet(now.getFullYear());
    const tetD = tt && tt > now ? tt : tet(now.getFullYear() + 1)!;
    const events: [string, Date][] = [
      [`${vi ? 'Tết Nguyên đán' : 'Lunar New Year'} ${tetD.getFullYear()}`, tetD],
      [vi ? 'Tết Dương lịch' : 'New Year', next(1, 1)],
      [vi ? 'Giáng sinh' : 'Christmas', next(12, 25)],
      [vi ? 'Giải phóng miền Nam 30/4' : 'Reunification Day', next(4, 30)],
      [vi ? 'Quốc khánh 2/9' : 'National Day', next(9, 2)]
    ];
    if (!vi) {
      // US Thanksgiving: fourth Thursday of November.
      const tg = (y: number) => { const d = new Date(y, 10, 1); d.setDate(1 + ((11 - d.getDay()) % 7) + 21); return d; };
      const t0 = tg(now.getFullYear());
      events.splice(0, events.length, ['🎄 Christmas', next(12, 25)], ['🎆 New Year', next(1, 1)], ['🎃 Halloween', next(10, 31)], ['🦃 Thanksgiving', t0 > now ? t0 : tg(now.getFullYear() + 1)], ["💝 Valentine's Day", next(2, 14)], [`🧧 Lunar New Year ${tetD.getFullYear()}`, tetD]);

    }
    const q = new URLSearchParams(location.search);
    const custom = q.get('date') ? new Date(q.get('date') + 'T00:00:00') : null;
    const main: [string, Date] = custom && !isNaN(+custom) ? [q.get('name') || (vi ? 'Sự kiện' : 'Event'), custom] : events[0];
    const f = root.querySelector<HTMLFormElement>('[data-f]')!;
    if (custom) { (f.elements.namedItem('name') as HTMLInputElement).value = q.get('name') || ''; (f.elements.namedItem('date') as HTMLInputElement).value = q.get('date')!; }
    const dd = (d: Date) => `${d.getDate()}/${d.getMonth() + 1}/${d.getFullYear()}`;
    const listed = events.slice(custom ? 0 : 1);
    $('[data-list]').innerHTML = listed.map(([n, d], i) =>
      `<div class="card cd-ev min-w-0" style="--c:var(--viz-${(i % 6) + 1})"><div class="text-sm text-slate-500">${esc(n)}</div><div class="text-2xl font-extrabold">${Math.ceil((+d - +now) / 864e5)} ${vi ? 'ngày' : 'days'}</div><div class="text-xs text-slate-400">${dd(d)}</div></div>`).join('');
    // Dòng thời gian các mốc theo thứ tự ngày (chỉ dùng chính các ngày đã tính ở trên).
    const all = [main, ...listed.filter((e) => e !== main)].filter(([, d]) => Number.isFinite(+d)).sort((a, b) => +a[1] - +b[1]);
    $('[data-tl]').innerHTML = timeline(all.map(([n, d]) => {
      const left = Math.ceil((+d - +now) / 864e5);
      return { date: dd(d), title: n, note: left > 0 ? (vi ? `còn ${left} ngày` : `${left} days to go`) : (vi ? 'Đã đến' : 'Here'), state: n === main[0] && d === main[1] ? 'now' : left <= 0 ? 'done' : 'next' };
    }), { title: vi ? 'Các mốc sắp tới theo thứ tự' : 'Upcoming dates in order' });
    const unit = (v: number, l: string) => `<div class="cd-unit"><b>${String(v).padStart(2, '0')}</b><small>${l}</small></div>`;
    const tick = () => {
      const ms = Math.max(0, +main[1] - Date.now());
      const s = Math.floor(ms / 1000);
      $('[data-main]').innerHTML = `<div class="text-lg font-semibold">${esc(main[0])} · ${dd(main[1])}</div>
        <div class="mx-auto mt-4 grid max-w-xl grid-cols-4 gap-2 sm:gap-3" role="timer" aria-label="${esc(`${main[0]}: ${Math.floor(s / 86400)} ${vi ? 'ngày' : 'days'}`)}">${unit(Math.floor(s / 86400), vi ? 'ngày' : 'days')}${unit(Math.floor(s / 3600) % 24, vi ? 'giờ' : 'hours')}${unit(Math.floor(s / 60) % 60, vi ? 'phút' : 'min')}${unit(s % 60, vi ? 'giây' : 'sec')}</div>`;
    };
    tick();
    setInterval(tick, 1000);
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(f);
      const p = new URLSearchParams({ name: String(fd.get('name') || ''), date: String(fd.get('date')) });
      location.search = p.toString();
    });
  });
</script>
