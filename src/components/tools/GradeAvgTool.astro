---
// Điểm trung bình môn THCS/THPT (TT 22/2021/TT-BGDĐT). Logic: src/lib/grade-avg.js
interface Props { lang?: 'vi' | 'en'; }
const { lang = 'vi' } = Astro.props;
const vi = lang === 'vi';
const blk = 'flex-1 min-w-0 cursor-pointer rounded-xl border border-slate-300 p-3 text-sm has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50';
const sc = 'input w-20 text-center';
---
<div data-tool="diemtb" data-lang={lang} class="grid gap-5 lg:grid-cols-2">
  <form class="card grid content-start gap-3" data-f onsubmit="return false">
    <div class="flex flex-wrap gap-2">
      <label class={blk}><input type="radio" name="mode" value="hk" class="mr-2" checked />{vi ? 'Học kỳ' : 'Semester'}</label>
      <label class={blk}><input type="radio" name="mode" value="cn" class="mr-2" />{vi ? 'Cả năm' : 'Full year'}</label>
      <label class={blk}><input type="radio" name="mode" value="xl" class="mr-2" />{vi ? 'Học lực' : 'Overall grade'}</label>
    </div>
    <div data-p="hk" class="grid gap-3">
      <div><label class="label">{vi ? 'Điểm thường xuyên (miệng, 15 phút)' : 'Regular scores (oral, 15-minute tests)'}</label>
        <div class="flex flex-wrap items-center gap-2" data-tx>
          <input class={sc} inputmode="decimal" name="tx" value="8" aria-label={vi ? 'Điểm thường xuyên 1' : 'Regular score 1'} /><input class={sc} inputmode="decimal" name="tx" value="7" aria-label={vi ? 'Điểm thường xuyên 2' : 'Regular score 2'} /><input class={sc} inputmode="decimal" name="tx" value="9" aria-label={vi ? 'Điểm thường xuyên 3' : 'Regular score 3'} />
        </div>
        <div class="mt-2 flex gap-2"><button type="button" class="btn-ghost min-h-11 px-4 disabled:opacity-40" data-add>+ {vi ? 'Thêm cột' : 'Add'}</button><button type="button" class="btn-ghost min-h-11 px-4 disabled:opacity-40" data-del>− {vi ? 'Bớt cột' : 'Remove'}</button></div>
        <p class="mt-1 text-xs text-slate-500">{vi ? 'Gợi ý số cột (Điều 6): môn 35 tiết/năm: 2; trên 35–70 tiết: 3; trên 70 tiết: 4.' : 'Suggested count (Art. 6): 35 periods/year: 2; 36–70: 3; over 70: 4.'}</p></div>
      <div class="flex gap-3">
        <div><label class="label">{vi ? 'Giữa kỳ (×2)' : 'Mid-term (×2)'}</label><input class={sc} inputmode="decimal" name="gk" value="7.5" /></div>
        <div><label class="label">{vi ? 'Cuối kỳ (×3)' : 'Final (×3)'}</label><input class={sc} inputmode="decimal" name="ck" value="8" /></div>
      </div>
    </div>
    <div data-p="cn" class="flex gap-3" hidden>
      <div><label class="label">{vi ? 'ĐTB học kỳ I' : 'Semester I avg'}</label><input class={sc} inputmode="decimal" name="hk1" value="7.6" /></div>
      <div><label class="label">{vi ? 'ĐTB học kỳ II (×2)' : 'Semester II avg (×2)'}</label><input class={sc} inputmode="decimal" name="hk2" value="8.2" /></div>
    </div>
    <div data-p="xl" class="grid gap-3" hidden>
      <div class="flex gap-2">
        <label class={blk}><input type="radio" name="level" value="thpt" class="mr-2" checked />THPT</label>
        <label class={blk}><input type="radio" name="level" value="thcs" class="mr-2" />THCS</label>
      </div>
      <div class="grid gap-2" data-subj></div>
      <div><button type="button" class="btn-ghost min-h-11 px-4 disabled:opacity-40" data-addsub>+ {vi ? 'Thêm môn' : 'Add subject'}</button></div>
      <div><label class="label">{vi ? 'Số môn đánh giá bằng nhận xét bị "Chưa đạt"' : 'Comment-graded subjects rated "Not achieved"'}</label>
        <div class="flex gap-2">
          <label class={blk}><input type="radio" name="failed" value="0" class="mr-2" checked />0</label>
          <label class={blk}><input type="radio" name="failed" value="1" class="mr-2" />1</label>
          <label class={blk}><input type="radio" name="failed" value="2" class="mr-2" />2+</label>
        </div></div>
    </div>
  </form>
  <div class="card" data-out></div>
</div>

<script>
  import { semesterAvg, yearAvg, classify, parseScore, SUBJECTS, LEVELS, MAX_SUBJECTS } from '../../lib/grade-avg.js';
  import { escapeHtml } from '../../lib/format.js';

  document.querySelectorAll<HTMLElement>('[data-tool="diemtb"]').forEach((root) => {
    const vi = root.dataset.lang !== 'en';
    const form = root.querySelector<HTMLFormElement>('[data-f]')!;
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    const txBox = root.querySelector<HTMLElement>('[data-tx]')!;
    const subjBox = root.querySelector<HTMLElement>('[data-subj]')!;
    const get = (k: string) => String(new FormData(form).get(k) ?? '');
    const fmt = (x: number) => (Number.isFinite(x) ? x.toLocaleString(vi ? 'vi-VN' : 'en-US', { minimumFractionDigits: 1, maximumFractionDigits: 3 }) : '–');
    const note = (s: string) => `<p class="mt-3 text-xs text-slate-500">${s}</p>`;
    const big = (l: string, v: string) => `<div class="text-sm text-slate-500">${l}</div><div class="text-4xl font-extrabold text-brand-700 break-words">${v}</div>`;
    const warn = (s: string) => `<div class="rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm font-semibold text-amber-800">${s}</div>`;
    const invalid = vi ? 'Nhập điểm từ 0 đến 10, tối đa 1 chữ số thập phân (dùng dấu phẩy hoặc chấm).' : 'Enter scores 0–10 with at most 1 decimal (comma or dot).';
    const mkInput = (name: string, value = '', aria = '') => { const el = document.createElement('input'); el.className = 'input w-20 shrink-0 text-center'; el.inputMode = 'decimal'; el.name = name; el.value = value; if (aria) el.setAttribute('aria-label', aria); return el; };
    const addSubBtn = root.querySelector<HTMLButtonElement>('[data-addsub]')!;
    const addSubject = (name: string, score: string) => {
      if (subjBox.children.length >= MAX_SUBJECTS) return;
      const row = document.createElement('div');
      row.className = 'flex items-center gap-2 text-sm';
      const nm = document.createElement('input');
      nm.className = 'input min-w-0 flex-1'; nm.name = 'subname'; nm.maxLength = 60; nm.value = name;
      nm.setAttribute('aria-label', vi ? 'Tên môn' : 'Subject name');
      row.append(nm, mkInput('sub', score, vi ? 'Điểm trung bình môn' : 'Subject average'));
      subjBox.append(row);
    };

    let lastLevel = '';
    const buildSubjects = () => {
      const lv = get('level') === 'thcs' ? 'thcs' : 'thpt';
      if (lv === lastLevel) return;
      lastLevel = lv;
      subjBox.innerHTML = '';
      SUBJECTS[lv].forEach((s, i) => addSubject(vi ? s.vi : s.en, ['8.5', '8', '7.8', '8.2', '9', '7', '8.4', '6.8', '8'][i] ?? '8'));
    };

    addSubBtn.addEventListener('click', () => { addSubject('', ''); calc(); });
    root.querySelector('[data-add]')!.addEventListener('click', () => { if (txBox.children.length < 8) { txBox.append(mkInput('tx', '', `${vi ? 'Điểm thường xuyên' : 'Regular score'} ${txBox.children.length + 1}`)); calc(); } });
    root.querySelector('[data-del]')!.addEventListener('click', () => { if (txBox.children.length > 1) { txBox.lastElementChild!.remove(); calc(); } });

    const legal = (s: string) => `<details class="mt-3 text-xs text-slate-500"><summary class="cursor-pointer">${vi ? 'Căn cứ pháp lý' : 'Legal basis'}</summary><p class="mt-1">${s}</p></details>`;
    const legalText = vi
      ? 'Thông tư 22/2021/TT-BGDĐT: Điều 5 k3 (điểm làm tròn 1 chữ số thập phân), Điều 6 k2 (số ĐĐGtx), Điều 9 k1 (ĐTBmhk = (TĐĐGtx + 2×ĐĐGgk + 3×ĐĐGck)/(số ĐĐGtx + 5); ĐTBmcn = (ĐTBmhkI + 2×ĐTBmhkII)/3), Điều 9 k2–k3 (mức kết quả học tập). TT 89/2026/TT-BGDĐT (từ 01/12/2026) không sửa Điều 5, Điều 9. Tiểu học không tính điểm trung bình (TT 27/2020/TT-BGDĐT).'
      : 'Circular 22/2021/TT-BGDĐT: Art. 5(3) (1-decimal rounding), Art. 6(2) (number of regular scores), Art. 9(1) (semester avg = (sum regular + 2×mid + 3×final)/(count + 5); year avg = (S1 + 2×S2)/3), Art. 9(2)–(3) (rating levels). Circular 89/2026 (from 01/12/2026) does not amend Art. 5 or 9. Primary schools do not compute averages (Circular 27/2020).';
    const commentNote = vi
      ? 'Môn đánh giá bằng nhận xét (Đạt/Chưa đạt, không tính điểm): Giáo dục thể chất, Nghệ thuật, Âm nhạc, Mĩ thuật, Nội dung giáo dục địa phương, Hoạt động trải nghiệm, hướng nghiệp.'
      : 'Comment-graded subjects (Achieved/Not achieved, no score): PE, Arts, Music, Fine arts, Local education content, Experiential & career activities.';

    const calc = () => {
      const mode = get('mode');
      root.querySelectorAll<HTMLElement>('[data-p]').forEach((p) => { p.hidden = p.dataset.p !== mode; });
      root.querySelector<HTMLButtonElement>('[data-add]')!.disabled = txBox.children.length >= 8;
      root.querySelector<HTMLButtonElement>('[data-del]')!.disabled = txBox.children.length <= 1;
      let h = '';
      if (mode === 'cn') {
        const a = parseScore(get('hk1')), b = parseScore(get('hk2'));
        const r = yearAvg(a, b);
        if (!r) h = warn(invalid);
        else {
          h = big(vi ? 'Điểm trung bình môn cả năm' : 'Full-year subject average', fmt(r.avg));
          h += note(`(${fmt(a)} + 2 × ${fmt(b)}) / 3 = ${fmt(Math.round(r.raw * 1000) / 1000)} → ${fmt(r.avg)}`);
        }
      } else if (mode === 'xl') {
        buildSubjects();
        addSubBtn.disabled = subjBox.children.length >= MAX_SUBJECTS;
        const rows = Array.from(subjBox.children);
        const vals = rows.map((row, i) => {
          const el = row.querySelector<HTMLInputElement>('[name="sub"]')!;
          const nm = (row.querySelector<HTMLInputElement>('[name="subname"]')?.value ?? '').trim();
          return { el, v: parseScore(el.value), name: nm || `${vi ? 'Môn' : 'Subject'} ${i + 1}` };
        });
        const valid = vals.filter((x) => Number.isFinite(x.v));
        const bad = vals.some((x) => x.el.value.trim() !== '' && !Number.isFinite(x.v));
        const r = classify(valid.map((x) => x.v), Number(get('failed')) || 0);
        if (bad) h += warn(invalid) + '<div class="mt-3"></div>';
        if (r.level === null) h += warn(vi ? `Cần ít nhất 6 môn tính điểm hợp lệ để xếp mức (đang có ${r.count}).` : `At least 6 valid scored subjects are needed (have ${r.count}).`);
        else {
          h += big(vi ? 'Mức kết quả học tập' : 'Learning result level', LEVELS[r.level][vi ? 'vi' : 'en']);
          if (r.adjusted) {
            const who = r.culprit?.type === 'score' ? escapeHtml(valid[r.culprit.index]?.name ?? '') : (vi ? '1 môn nhận xét Chưa đạt' : '1 comment-graded subject');
            h += note(vi ? `Theo tiêu chí khoản 2 Điều 9 là mức ${LEVELS[r.base].vi}, bị hạ từ 2 bậc trở lên chỉ vì 1 môn (${who}) nên được điều chỉnh theo khoản 3 Điều 9 lên mức liền kề.` : `Under Art. 9(2) the level is ${LEVELS[r.base].en}, but it is lowered by 2+ levels due to a single subject (${who}), so it is adjusted to the next level per Art. 9(3).`);
          }
          h += note(vi ? 'Tốt: tất cả môn nhận xét Đạt; mọi môn tính điểm ≥ 6,5, ít nhất 6 môn ≥ 8,0. Khá: tất cả Đạt; mọi môn ≥ 5,0, ít nhất 6 môn ≥ 6,5. Đạt: tối đa 1 môn Chưa đạt; ít nhất 6 môn ≥ 5,0, không môn nào < 3,5.' : 'Excellent: all comment subjects Achieved; every scored subject ≥ 6.5 and at least 6 ≥ 8.0. Good: all Achieved; every subject ≥ 5.0, at least 6 ≥ 6.5. Achieved: at most 1 Not achieved; at least 6 subjects ≥ 5.0, none < 3.5.');
        }
        h += note(commentNote);
        h += note(vi ? 'Nhập điểm trung bình cả năm (hoặc học kỳ) của từng môn; có thể đổi tên môn lựa chọn theo tổ hợp của trường.' : 'Enter each subject\'s year (or semester) average; you can rename elective subjects to match your school\'s combination.');
      } else {
        const txRaw = Array.from(form.querySelectorAll<HTMLInputElement>('[name="tx"]')).map((el) => el.value.trim()).filter((s) => s !== '');
        const tx = txRaw.map((s) => parseScore(s));
        const gk = parseScore(get('gk')), ck = parseScore(get('ck'));
        const r = tx.length && tx.every(Number.isFinite) ? semesterAvg(tx, gk, ck) : null;
        if (!txRaw.length) h = warn(vi ? 'Cần ít nhất 1 điểm thường xuyên.' : 'At least 1 regular score is required.');
        else if (!r) h = warn(invalid);
        else {
          h = big(vi ? 'Điểm trung bình môn học kỳ' : 'Semester subject average', fmt(r.avg));
          h += note(`(${tx.map(fmt).join(' + ')} + 2 × ${fmt(gk)} + 3 × ${fmt(ck)}) / (${r.n} + 5) = ${fmt(r.sum)} / ${r.den} = ${fmt(Math.round(r.raw * 1000) / 1000)} → ${fmt(r.avg)}`);
        }
      }
      h += legal(legalText);
      h += `<p class="mt-3 text-xs font-semibold text-amber-700">${vi ? 'Tham khảo; kết quả chính thức theo sổ điểm của nhà trường. Cập nhật 10/2026.' : 'Reference only; official results are in the school records. Updated 10/2026.'}</p>`;
      out.innerHTML = h;
    };
    form.addEventListener('input', calc);
    form.addEventListener('change', calc);
    calc();
  });
</script>
