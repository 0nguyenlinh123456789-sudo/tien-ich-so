---
import MonetizedResult from '../MonetizedResult.astro';
interface Props { lang?: 'vi' | 'en'; }
const { lang = 'vi' } = Astro.props;
const vi = lang === 'vi';
---
<div data-tool="compress" data-lang={lang}>
  <form class="card space-y-5" data-tool-form>
    <div class="rounded-2xl border-2 border-dashed border-brand-300 bg-brand-50/70 p-5 text-center transition hover:bg-brand-100/60" data-drop>
      <label class="flex cursor-pointer flex-col items-center justify-center gap-1.5">
        <span class="text-4xl">🪪</span>
        <span class="text-base font-bold text-slate-900">{vi ? 'Kéo thả hoặc bấm để chọn ảnh gốc từ máy của bạn' : 'Drag & drop or click to select your original photo'}</span>
        <span class="text-xs text-slate-500">{vi ? 'Hỗ trợ đổi phông nền Trắng/Xanh giữ nguyên nhân vật, cắt chuẩn 2×3, 3×4, 4×6 cm và ép đúng dung lượng KB.' : 'Change background to White/Blue preserving the subject, crop to 3×4 / 4×6 ID sizes, and compress to exact KB limits.'}</span>
        <input type="file" name="files" accept="image/*" multiple class="sr-only" />
        <span data-out="count" class="mt-1 rounded-full bg-brand-600 px-3 py-0.5 text-xs font-semibold text-white empty:hidden"></span>
      </label>
      <div class="mt-3 flex flex-wrap items-center justify-center gap-1.5 border-t border-brand-200/70 pt-3">
        <span class="text-xs font-semibold text-slate-600">{vi ? 'Hoặc bấm thử ngay nhân vật mẫu:' : 'Or test with sample portraits:'}</span>
        <button type="button" data-sample-portrait="male_shirt" class="rounded-full border border-slate-300 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 shadow-2xs transition hover:border-brand-500 hover:text-brand-700">👔 {vi ? 'Nam Sơ mi' : 'Male Shirt'}</button>
        <button type="button" data-sample-portrait="female_suit" class="rounded-full border border-slate-300 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 shadow-2xs transition hover:border-brand-500 hover:text-brand-700">👩‍💼 {vi ? 'Nữ Công sở' : 'Female Blazer'}</button>
        <button type="button" data-sample-portrait="student" class="rounded-full border border-slate-300 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 shadow-2xs transition hover:border-brand-500 hover:text-brand-700">🎓 {vi ? 'Sinh viên' : 'Student'}</button>
        <button type="button" data-sample-portrait="exec" class="rounded-full border border-slate-300 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 shadow-2xs transition hover:border-brand-500 hover:text-brand-700">🤵 {vi ? 'Nam Vest' : 'Executive'}</button>
      </div>
    </div>

    <!-- Cảnh báo khi chọn nhầm file ảnh rỗng 2.1 KB đã tải trước đó -->
    <div data-blank-warn class="hidden rounded-xl border border-amber-300 bg-amber-50 p-3.5 text-xs text-amber-950 shadow-2xs">
      <div class="font-bold text-amber-900">⚠️ {vi ? 'Phát hiện file bạn vừa chọn là ảnh màu trơn 2.1 KB (không có hình người bên trong)!' : 'The file you selected is a solid color image (2.1 KB) with no person inside!'}</div>
      <div class="mt-1 text-amber-800">{vi ? 'Nguyên nhân: Bạn vừa chọn nhầm file "…-id3x4.jpg" (2.1 KB) nằm trong thư mục Tải xuống từ lần xuất lỗi trước đó. Hãy bấm chọn lại file ảnh gốc (~196.9 KB ban đầu) trong máy tính của bạn hoặc bấm các nút "Nhân vật mẫu" ở trên!' : 'You selected the previously downloaded 2.1 KB blank file from your Downloads folder. Please select your original photo (~197 KB) or click a Sample Portrait above!'}</div>
    </div>

    <!-- Khung xem trước nhân vật trực tiếp ngay trong cụm sửa ảnh -->
    <div data-live-stage class="hidden rounded-2xl border border-brand-200 bg-slate-900/95 p-4 text-white shadow-md">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-2.5">
        <div class="flex items-center gap-2">
          <span class="inline-block h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
          <span class="text-xs font-bold tracking-wide uppercase text-slate-200">{vi ? 'Xem trước Nhân vật & Phông nền trực tiếp' : 'Live Subject & Backdrop Preview'}</span>
          <span data-live-meta class="rounded-full bg-slate-800 px-2.5 py-0.5 text-xs font-semibold text-emerald-300"></span>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <button type="button" data-live-crop class="rounded-lg bg-white/15 px-3 py-1 text-xs font-bold text-white transition hover:bg-white/25">✎ {vi ? 'Căn chỉnh khuôn mặt & Cắt khung' : 'Fine-tune Crop & Face'}</button>
          <a data-live-dl href="#" download="anh-the.jpg" class="rounded-lg bg-emerald-600 px-3 py-1 text-xs font-bold text-white transition hover:bg-emerald-500">⬇ {vi ? 'Tải ảnh này ngay' : 'Download Now'}</a>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 items-center">
        <div class="flex flex-col items-center rounded-xl bg-slate-800/70 p-3">
          <span data-live-orig-label class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-400">{vi ? 'Ảnh gốc đã tải lên' : 'Original Uploaded Photo'}</span>
          <img data-live-orig src="" alt="Original" class="max-h-56 rounded-lg object-contain shadow" />
        </div>
        <div class="flex flex-col items-center rounded-xl bg-slate-800/70 p-3">
          <span class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-emerald-400">{vi ? 'Ảnh sau khi sửa (Giữ nguyên nhân vật)' : 'Processed Result (Subject Preserved)'}</span>
          <img data-live-after src="" alt="Processed" class="max-h-56 rounded-lg object-contain shadow ring-2 ring-emerald-500/40" />
        </div>
      </div>
    </div>

    <div class="grid gap-4 lg:grid-cols-3">
      <!-- 1. Phông nền ảnh thẻ -->
      <div class="rounded-xl border border-blue-200 bg-blue-50/50 p-3.5">
        <div class="mb-2 text-xs font-extrabold tracking-wide text-blue-950 uppercase">1. {vi ? 'Phông nền Ảnh thẻ' : 'ID Photo Background'}</div>
        <div class="flex flex-wrap gap-1.5" data-bg-group>
          {[
            ['', vi ? 'Giữ gốc' : 'Original', ''],
            ['#ffffff', vi ? 'Nền Trắng' : 'White', '#ffffff'],
            ['#1d70b8', vi ? 'Xanh Chuẩn' : 'ID Blue', '#1d70b8'],
            ['#38bdf8', vi ? 'Xanh Nhạt' : 'Sky Blue', '#38bdf8'],
            ['#e2e8f0', vi ? 'Xám Studio' : 'Gray', '#e2e8f0']
          ].map(([val, label, dot], idx) => (
            <button type="button" data-bg-val={val} class={`inline-flex items-center gap-1.5 rounded-lg border px-2.5 py-1.5 text-xs font-semibold transition ${idx === 0 ? 'border-brand-600 bg-brand-600 text-white' : 'border-slate-300 bg-white text-slate-700 hover:border-brand-500'}`}>
              {dot && <span class="h-3 w-3 rounded-full border border-slate-400" style={`background:${dot}`}></span>}
              <span>{label}</span>
            </button>
          ))}
        </div>
        <input type="hidden" name="bgColor" value="" />
        <div class="mt-2.5 hidden" data-tol-wrap>
          <label class="flex items-center justify-between text-xs font-medium text-slate-700">
            <span>{vi ? 'Độ nhạy tách nền' : 'Edge tolerance'}: <b data-out="tolv">32</b></span>
            <input name="tolerance" type="range" min="10" max="65" value="32" class="w-36 accent-brand-600" />
          </label>
        </div>
      </div>

      <!-- 2. Kích thước chuẩn -->
      <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3.5">
        <div class="mb-2 text-xs font-extrabold tracking-wide text-slate-700 uppercase">2. {vi ? 'Kích thước Ảnh thẻ & Khung (cm / px)' : 'Standard Size & Dimensions'}</div>
        <div class="mb-2.5 flex flex-wrap gap-1.5" data-size-group>
          {[
            ['orig', '1920', '1920', vi ? 'Giữ tỷ lệ gốc' : 'Original ratio'],
            ['id3x4', '354', '472', '3×4 cm (354×472)'],
            ['id4x6', '472', '709', '4×6 cm (472×709)'],
            ['id2x3', '236', '354', '2×3 cm (236×354)'],
            ['passport', '413', '531', vi ? 'Hộ chiếu 3.5×4.5' : 'Passport 3.5×4.5'],
            ['avatar', '600', '600', 'Avatar 1:1 (600×600)']
          ].map(([mode, w, h, label], idx) => (
            <button type="button" data-size-preset={mode} data-w={w} data-h={h} class={`rounded-lg border px-2.5 py-1 text-xs font-semibold transition ${idx === 0 ? 'border-brand-600 bg-brand-600 text-white' : 'border-slate-300 bg-white text-slate-700 hover:border-brand-500'}`}>
              {label}
            </button>
          ))}
        </div>
        <input type="hidden" name="cropMode" value="orig" />
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="text-[11px] font-semibold text-slate-600" for="cp-w">{vi ? 'Rộng (px)' : 'Width (px)'}</label>
            <input id="cp-w" name="maxWidth" type="number" min="80" max="8000" value="1920" class="input py-1.5 text-sm" />
          </div>
          <div>
            <label class="text-[11px] font-semibold text-slate-600" for="cp-h">{vi ? 'Cao (px)' : 'Height (px)'}</label>
            <input id="cp-h" name="maxHeight" type="number" min="80" max="8000" value="1920" class="input py-1.5 text-sm" />
          </div>
        </div>
      </div>

      <!-- 3. Dung lượng file mục tiêu (KB) -->
      <div class="rounded-xl border border-emerald-200 bg-emerald-50/40 p-3.5">
        <div class="mb-2 text-xs font-extrabold tracking-wide text-emerald-950 uppercase">3. {vi ? 'Dung lượng File Ảnh (KB) & Định dạng' : 'Target File Size (KB) & Format'}</div>
        <div class="mb-2.5 flex flex-wrap gap-1.5" data-kb-group>
          {[
            ['0', vi ? 'Theo thanh nén' : 'By quality'],
            ['50', '≤ 50 KB'],
            ['100', '≤ 100 KB'],
            ['200', '≤ 200 KB'],
            ['500', '≤ 500 KB']
          ].map(([kbVal, label], idx) => (
            <button type="button" data-kb-val={kbVal} class={`rounded-lg border px-2.5 py-1 text-xs font-semibold transition ${idx === 0 ? 'border-brand-600 bg-brand-600 text-white' : 'border-slate-300 bg-white text-slate-700 hover:border-brand-500'}`}>
              {label}
            </button>
          ))}
        </div>
        <input type="hidden" name="targetKb" value="0" />
        <div class="grid grid-cols-2 gap-2 items-end">
          <div>
            <label class="text-[11px] font-semibold text-slate-600" for="cp-f">{vi ? 'Định dạng' : 'Format'}</label>
            <select id="cp-f" name="format" class="input py-1.5 text-sm">
              <option value="image/jpeg" selected>JPEG (.jpg)</option>
              <option value="image/webp">WebP (.webp)</option>
              <option value="image/png">PNG (.png)</option>
            </select>
          </div>
          <div>
            <label class="text-[11px] font-semibold text-slate-600" for="cp-q">{vi ? 'Chất lượng' : 'Quality'}: <b data-out="qv">85%</b></label>
            <input id="cp-q" name="quality" type="range" min="0.2" max="0.98" step="0.02" value="0.85" class="w-full accent-brand-600" />
          </div>
        </div>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <button class="btn-primary" type="submit">⚡ {vi ? 'Xử lý ảnh ngay' : 'Process Photos'}</button>
      <span class="text-xs text-slate-500">{vi ? '💡 Sau khi xử lý, bạn có thể bấm "✎ Cắt & Đổi nền chi tiết" trên từng ảnh để căn chỉnh khuôn mặt trực quan.' : '💡 After processing, click "✎ Fine-tune & Crop" on any photo for interactive editing.'}</span>
    </div>
  </form>

  <MonetizedResult context="tools" lang={lang}>
    <div data-out="summary" class="mb-4"></div>
    <div data-out="list" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
    <div slot="bottom" class="mt-6 flex justify-center">
      <button type="button" class="btn-primary" data-action="zip">⬇ {vi ? 'Tải tất cả (ZIP)' : 'Download all (ZIP)'}</button>
    </div>
  </MonetizedResult>
</div>

<script>
  import { zipSync } from 'fflate';
  import { downloadBlob, escapeHtml } from '../../lib/format.js';
  import { openImageEditor, replaceBackgroundCanvas, encodeCanvasToTarget, ensureAiSegmenter } from '../../lib/image-editor.js';
  import { showResult } from '../../scripts/form-state.js';

  const kb = (n: number) => (n / 1024 < 1024 ? (n / 1024).toFixed(1) + ' KB' : (n / 1048576).toFixed(2) + ' MB');
  const ext = (t: string) => (t === 'image/png' ? 'png' : t === 'image/webp' ? 'webp' : 'jpg');

  function fileToDataUrl(file: File): Promise<string> {
    return new Promise((res, rej) => {
      const r = new FileReader();
      r.onload = () => res(String(r.result));
      r.onerror = rej;
      r.readAsDataURL(file);
    });
  }

  function checkIsSolidBlank(canvas: HTMLCanvasElement): boolean {
    const w = canvas.width, h = canvas.height;
    if (!w || !h) return false;
    const d = canvas.getContext('2d')!.getImageData(0, 0, w, h).data;
    const r0 = d[0], g0 = d[1], b0 = d[2];
    let same = 0, total = 0;
    const step = Math.max(4, Math.floor((w * h) / 400)) * 4;
    for (let i = 0; i < d.length; i += step) {
      total++;
      if (Math.abs(d[i] - r0) <= 6 && Math.abs(d[i + 1] - g0) <= 6 && Math.abs(d[i + 2] - b0) <= 6) same++;
    }
    return total > 10 && same / total > 0.95;
  }

  async function createSamplePortraitFile(kind: string): Promise<File> {
    const cv = document.createElement('canvas');
    const w = 600, h = 800;
    cv.width = w;
    cv.height = h;
    const ctx = cv.getContext('2d')!;

    // Studio wall background (warm cream/gray so White & Blue background replacement clearly contrasts)
    const wallMap: Record<string, [string, string]> = {
      male_shirt: ['#f3efe6', '#e7e0d2'],
      female_suit: ['#eef2f6', '#dde5ee'],
      student: ['#f5f0e6', '#e8dfd1'],
      exec: ['#edeff2', '#dcdfe6']
    };
    const [w1, w2] = wallMap[kind] || wallMap.male_shirt;
    const g = ctx.createLinearGradient(0, 0, 0, h);
    g.addColorStop(0, w1);
    g.addColorStop(1, w2);
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, w, h);

    const isFemale = kind === 'female_suit';
    const skin = isFemale ? '#f7d3ba' : '#eec2a4';
    const skinShadow = isFemale ? '#e5b89b' : '#d9a684';
    const hair = kind === 'student' ? '#231f20' : isFemale ? '#2b1d16' : '#1e242b';

    // Back hair for female portrait
    if (isFemale) {
      ctx.fillStyle = hair;
      ctx.beginPath();
      ctx.ellipse(300, 325, 132, 165, 0, 0, Math.PI * 2);
      ctx.fill();
    }

    // Shoulders & Torso
    ctx.save();
    ctx.beginPath();
    ctx.moveTo(75, h);
    ctx.quadraticCurveTo(95, 540, 225, 515);
    ctx.lineTo(375, 515);
    ctx.quadraticCurveTo(505, 540, 525, h);
    ctx.closePath();
    ctx.fillStyle = kind === 'male_shirt' ? '#f8fafc' : kind === 'student' ? '#eff6ff' : kind === 'female_suit' ? '#1e293b' : '#0f172a';
    ctx.fill();
    ctx.lineWidth = 3;
    ctx.strokeStyle = '#334155';
    ctx.stroke();

    // Inner shirt & tie / blouse V-neck
    if (kind === 'exec' || kind === 'female_suit') {
      ctx.beginPath();
      ctx.moveTo(235, 515);
      ctx.lineTo(300, 675);
      ctx.lineTo(365, 515);
      ctx.closePath();
      ctx.fillStyle = '#ffffff';
      ctx.fill();
      if (kind === 'exec') {
        ctx.fillStyle = '#991b1b';
        ctx.beginPath();
        ctx.moveTo(288, 545);
        ctx.lineTo(312, 545);
        ctx.lineTo(320, 720);
        ctx.lineTo(300, 755);
        ctx.lineTo(280, 720);
        ctx.closePath();
        ctx.fill();
      }
    } else {
      // Shirt collar & placket
      ctx.strokeStyle = '#94a3b8';
      ctx.lineWidth = 2.5;
      ctx.beginPath();
      ctx.moveTo(300, 555);
      ctx.lineTo(300, h);
      ctx.stroke();
      if (kind === 'student') {
        ctx.fillStyle = '#1e3a8a';
        ctx.beginPath();
        ctx.moveTo(288, 555);
        ctx.lineTo(312, 555);
        ctx.lineTo(318, 710);
        ctx.lineTo(300, 740);
        ctx.lineTo(282, 710);
        ctx.closePath();
        ctx.fill();
      }
    }
    ctx.restore();

    // Neck
    ctx.fillStyle = skinShadow;
    ctx.beginPath();
    ctx.roundRect(252, 415, 96, 125, 28);
    ctx.fill();

    // Collar flaps
    ctx.fillStyle = '#ffffff';
    ctx.strokeStyle = '#64748b';
    ctx.lineWidth = 2.5;
    ctx.beginPath();
    ctx.moveTo(246, 502);
    ctx.lineTo(300, 560);
    ctx.lineTo(260, 585);
    ctx.lineTo(222, 520);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(354, 502);
    ctx.lineTo(300, 560);
    ctx.lineTo(340, 585);
    ctx.lineTo(378, 520);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();

    // Ears
    ctx.fillStyle = skinShadow;
    ctx.beginPath();
    ctx.ellipse(186, 315, 18, 34, -0.08, 0, Math.PI * 2);
    ctx.ellipse(414, 315, 18, 34, 0.08, 0, Math.PI * 2);
    ctx.fill();

    // Face / Head
    ctx.fillStyle = skin;
    ctx.beginPath();
    ctx.ellipse(300, 305, 112, 142, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.lineWidth = 2;
    ctx.strokeStyle = '#c69272';
    ctx.stroke();

    // Hair top & sides
    ctx.fillStyle = hair;
    ctx.beginPath();
    if (isFemale) {
      ctx.moveTo(182, 300);
      ctx.quadraticCurveTo(175, 145, 300, 142);
      ctx.quadraticCurveTo(425, 145, 418, 300);
      ctx.quadraticCurveTo(385, 205, 295, 212);
      ctx.quadraticCurveTo(215, 215, 182, 300);
    } else {
      ctx.moveTo(186, 285);
      ctx.quadraticCurveTo(178, 142, 300, 140);
      ctx.quadraticCurveTo(422, 142, 414, 285);
      ctx.quadraticCurveTo(395, 212, 310, 205);
      ctx.quadraticCurveTo(218, 205, 186, 285);
    }
    ctx.closePath();
    ctx.fill();

    // Eyebrows
    ctx.strokeStyle = hair;
    ctx.lineWidth = isFemale ? 4.5 : 6;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(232, 272);
    ctx.quadraticCurveTo(256, 263, 278, 270);
    ctx.moveTo(322, 270);
    ctx.quadraticCurveTo(344, 263, 368, 272);
    ctx.stroke();

    // Eyes
    ctx.fillStyle = '#ffffff';
    ctx.beginPath();
    ctx.ellipse(255, 295, 18, 11, 0, 0, Math.PI * 2);
    ctx.ellipse(345, 295, 18, 11, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = '#1e293b';
    ctx.beginPath();
    ctx.arc(255, 295, 7.5, 0, Math.PI * 2);
    ctx.arc(345, 295, 7.5, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = '#ffffff';
    ctx.beginPath();
    ctx.arc(252, 292, 2.5, 0, Math.PI * 2);
    ctx.arc(342, 292, 2.5, 0, Math.PI * 2);
    ctx.fill();

    // Nose
    ctx.strokeStyle = '#c58c6d';
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(300, 295);
    ctx.lineTo(294, 342);
    ctx.quadraticCurveTo(300, 348, 309, 342);
    ctx.stroke();

    // Mouth / Smile
    ctx.strokeStyle = isFemale ? '#be123c' : '#b45346';
    ctx.lineWidth = isFemale ? 5 : 4;
    ctx.beginPath();
    ctx.moveTo(268, 378);
    ctx.quadraticCurveTo(300, 396, 332, 378);
    ctx.stroke();

    const blob: Blob = await new Promise((res) => cv.toBlob((b) => res(b!), 'image/jpeg', 0.92));
    return new File([blob], `anh-chan-dung-${kind}.jpg`, { type: 'image/jpeg' });
  }

  async function processOne(file: File, o: { quality: number; maxWidth: number; maxHeight: number; format: string; cropMode: string; bgColor: string; tolerance: number; targetKb: number }) {
    const bmp = await createImageBitmap(file);
    const origW = bmp.width, origH = bmp.height;
    let w = origW, h = origH;
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d')!;
    ctx.imageSmoothingQuality = 'high';

    if (o.cropMode !== 'orig') {
      // Exact ID photo / avatar dimensions with smart center-top portrait crop
      w = o.maxWidth;
      h = o.maxHeight;
      canvas.width = w;
      canvas.height = h;
      const scale = Math.max(w / origW, h / origH);
      const sw = origW * scale, sh = origH * scale;
      const dx = (w - sw) / 2;
      const dy = (h - sh) * 0.22; // keep head & shoulders framed naturally
      ctx.drawImage(bmp, dx, dy, sw, sh);
    } else {
      const ratio = Math.min(1, o.maxWidth / origW, o.maxHeight / origH);
      w = Math.round(origW * ratio);
      h = Math.round(origH * ratio);
      canvas.width = w;
      canvas.height = h;
      ctx.drawImage(bmp, 0, 0, w, h);
    }
    bmp.close();

    const isBlankInput = checkIsSolidBlank(canvas);

    if (o.bgColor && !isBlankInput) {
      await ensureAiSegmenter();
      replaceBackgroundCanvas(canvas, o.bgColor, o.tolerance, 2);
    } else if (o.format === 'image/jpeg') {
      // Ensure transparent PNGs get a clean white backdrop when exported as JPEG without bg replacement
      const tmp = document.createElement('canvas');
      tmp.width = w;
      tmp.height = h;
      const tctx = tmp.getContext('2d')!;
      tctx.fillStyle = '#ffffff';
      tctx.fillRect(0, 0, w, h);
      tctx.drawImage(canvas, 0, 0);
      ctx.clearRect(0, 0, w, h);
      ctx.drawImage(tmp, 0, 0);
    }

    const encoded = encodeCanvasToTarget(canvas, {
      format: o.format,
      quality: Math.round(o.quality * 100),
      targetKb: o.targetKb,
      radius: 0
    });
    const resBlob = await (await fetch(encoded.dataUrl)).blob();
    const noChange = !o.bgColor && o.cropMode === 'orig' && !o.targetKb && resBlob.size >= file.size && w === origW && file.type === o.format;
    return {
      blob: noChange ? file : resBlob,
      dataUrl: encoded.dataUrl,
      w: encoded.width,
      h: encoded.height,
      origW,
      origH,
      isBlankInput,
      keptOriginal: noChange
    };
  }

  document.querySelectorAll<HTMLElement>('[data-tool="compress"]').forEach((root) => {
    const lang = (root.dataset.lang === 'en' ? 'en' : 'vi') as 'vi' | 'en';
    const vi = lang === 'vi';
    const form = root.querySelector<HTMLFormElement>('[data-tool-form]')!;
    const input = form.querySelector<HTMLInputElement>('input[name="files"]')!;
    const drop = root.querySelector<HTMLElement>('[data-drop]')!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const wInp = form.querySelector<HTMLInputElement>('input[name="maxWidth"]')!;
    const hInp = form.querySelector<HTMLInputElement>('input[name="maxHeight"]')!;
    const cropInp = form.querySelector<HTMLInputElement>('input[name="cropMode"]')!;
    const bgInp = form.querySelector<HTMLInputElement>('input[name="bgColor"]')!;
    const kbInp = form.querySelector<HTMLInputElement>('input[name="targetKb"]')!;
    const tolWrap = form.querySelector<HTMLElement>('[data-tol-wrap]')!;
    const tolInp = form.querySelector<HTMLInputElement>('input[name="tolerance"]')!;
    const fmtSel = form.querySelector<HTMLSelectElement>('select[name="format"]')!;
    const liveStage = form.querySelector<HTMLElement>('[data-live-stage]')!;
    const liveOrig = form.querySelector<HTMLImageElement>('[data-live-orig]')!;
    const liveOrigLabel = form.querySelector<HTMLElement>('[data-live-orig-label]')!;
    const liveAfter = form.querySelector<HTMLImageElement>('[data-live-after]')!;
    const liveMeta = form.querySelector<HTMLElement>('[data-live-meta]')!;
    const liveCropBtn = form.querySelector<HTMLButtonElement>('[data-live-crop]')!;
    const liveDlLink = form.querySelector<HTMLAnchorElement>('[data-live-dl]')!;
    const blankWarn = form.querySelector<HTMLElement>('[data-blank-warn]')!;

    let files: File[] = [];
    let results: { name: string; blob: Blob; origSrc: string; w: number; h: number; origW?: number; origH?: number; isBlankInput?: boolean }[] = [];
    let previewUrls: string[] = [];
    let debounceTimer: any = null;
    let runToken = 0;

    const scheduleProcess = (delay = 0) => {
      if (!files.length) return;
      clearTimeout(debounceTimer);
      if (delay <= 0) {
        runProcess();
      } else {
        debounceTimer = setTimeout(() => runProcess(), delay);
      }
    };

    const activeClasses = ['border-brand-600', 'bg-brand-600', 'text-white'];
    const inactiveClasses = ['border-slate-300', 'bg-white', 'text-slate-700'];
    const markGroup = (container: HTMLElement, activeBtn: HTMLElement) => {
      container.querySelectorAll<HTMLElement>('button').forEach((b) => {
        const on = b === activeBtn;
        activeClasses.forEach((c) => b.classList.toggle(c, on));
        inactiveClasses.forEach((c) => b.classList.toggle(c, !on));
      });
    };

    form.querySelector<HTMLElement>('[data-bg-group]')?.addEventListener('click', (ev) => {
      const b = (ev.target as HTMLElement).closest<HTMLElement>('button[data-bg-val]');
      if (!b) return;
      bgInp.value = b.dataset.bgVal || '';
      tolWrap.classList.toggle('hidden', !bgInp.value);
      markGroup(b.parentElement!, b);
      scheduleProcess(0);
    });

    form.querySelector<HTMLElement>('[data-size-group]')?.addEventListener('click', (ev) => {
      const b = (ev.target as HTMLElement).closest<HTMLElement>('button[data-size-preset]');
      if (!b) return;
      cropInp.value = b.dataset.sizePreset || 'orig';
      wInp.value = b.dataset.w || '1920';
      hInp.value = b.dataset.h || '1920';
      markGroup(b.parentElement!, b);
      scheduleProcess(0);
    });

    form.querySelector<HTMLElement>('[data-kb-group]')?.addEventListener('click', (ev) => {
      const b = (ev.target as HTMLElement).closest<HTMLElement>('button[data-kb-val]');
      if (!b) return;
      kbInp.value = b.dataset.kbVal || '0';
      markGroup(b.parentElement!, b);
      scheduleProcess(0);
    });

    tolInp?.addEventListener('input', () => {
      out('tolv').textContent = tolInp.value;
      scheduleProcess(120);
    });

    const setFiles = (list: FileList | File[]) => {
      files = Array.from(list).filter((f) => f.type.startsWith('image/'));
      out('count').textContent = files.length ? (vi ? `Đã chọn ${files.length} ảnh` : `${files.length} photo(s) ready`) : '';
      if (files.length) scheduleProcess(0);
    };
    input.addEventListener('change', () => input.files && setFiles(input.files));
    form.querySelectorAll<HTMLElement>('[data-sample-portrait]').forEach((btn) => {
      btn.addEventListener('click', async (ev) => {
        ev.preventDefault();
        ev.stopPropagation();
        const f = await createSamplePortraitFile(btn.dataset.samplePortrait || 'male_shirt');
        setFiles([f]);
      });
    });
    ['dragenter', 'dragover'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.add('ring-2', 'ring-brand-500'); }));
    ['dragleave', 'drop'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.remove('ring-2', 'ring-brand-500'); }));
    drop.addEventListener('drop', (e) => { const dt = (e as DragEvent).dataTransfer; if (dt?.files) setFiles(dt.files); });
    const q = form.querySelector<HTMLInputElement>('input[name="quality"]')!;
    q.addEventListener('input', () => {
      out('qv').textContent = Math.round(Number(q.value) * 100) + '%';
      scheduleProcess(120);
    });
    wInp.addEventListener('input', () => scheduleProcess(220));
    hInp.addEventListener('input', () => scheduleProcess(220));
    fmtSel.addEventListener('change', () => scheduleProcess(0));

    const openEditorFor = async (idx: number) => {
      const item = results[idx];
      if (!item) return;
      const ratioMap: Record<string, string> = { id3x4: '3/4', id4x6: '2/3', id2x3: '2/3', passport: '7/9', avatar: '1', orig: 'orig' };
      const bgModeMap: Record<string, string> = { '#ffffff': 'white', '#1d70b8': 'blue', '#38bdf8': 'sky', '#e2e8f0': 'gray' };
      const edited: any = await openImageEditor(item.origSrc, {
        ratio: ratioMap[cropInp.value] || '3/4',
        bgMode: bgInp.value ? (bgModeMap[bgInp.value.toLowerCase()] || 'custom') : 'none',
        bgColor: bgInp.value || '#1d70b8',
        bgTolerance: Number(tolInp.value) || 32,
        outWidth: item.w,
        targetKb: Number(kbInp.value) || 0
      }, lang);
      if (!edited) return;
      const newBlob = await (await fetch(edited.dataUrl)).blob();
      results[idx] = { ...item, blob: newBlob, w: edited.width, h: edited.height };
      renderCards();
    };

    liveCropBtn?.addEventListener('click', () => openEditorFor(0));

    const renderCards = () => {
      previewUrls.forEach((u) => URL.revokeObjectURL(u));
      previewUrls = [];
      out('list').innerHTML = '';
      let before = 0, after = 0;
      files.forEach((f) => { before += f.size; });
      const anyBlank = results.some((r) => r.isBlankInput);
      blankWarn?.classList.toggle('hidden', !anyBlank);
      results.forEach((r, idx) => {
        after += r.blob.size;
        const url = URL.createObjectURL(r.blob);
        previewUrls.push(url);
        const origSize = files[idx]?.size || r.blob.size;
        if (idx === 0 && liveStage) {
          liveStage.classList.remove('hidden');
          liveOrig.src = r.origSrc;
          liveAfter.src = url;
          if (liveOrigLabel) {
            liveOrigLabel.textContent = `${vi ? 'Ảnh gốc' : 'Original'}: ${r.origW || r.w}×${r.origH || r.h} px · ${kb(origSize)}`;
          }
          liveMeta.textContent = `${vi ? 'Sau xử lý' : 'Result'}: ${r.w} × ${r.h} px · ${kb(r.blob.size)}`;
          liveDlLink.href = url;
          liveDlLink.download = r.name;
        }
        const saved = Math.max(0, 1 - r.blob.size / origSize);
        const card = document.createElement('div');
        card.className = 'rounded-2xl border border-slate-200 bg-white p-3.5 shadow-2xs flex flex-col';
        card.innerHTML = `<div class="relative flex h-52 w-full items-center justify-center overflow-hidden rounded-xl bg-slate-100 p-2">
            <img src="${url}" alt="" class="max-h-full max-w-full rounded object-contain shadow-sm" loading="lazy" />
            <img src="${r.origSrc}" alt="Original" title="${vi ? 'Ảnh gốc' : 'Original'}" class="absolute bottom-2 left-2 h-12 w-12 rounded-lg border-2 border-white object-cover shadow-md" />
            <span class="absolute top-2 left-2 rounded-full bg-slate-900/80 px-2.5 py-0.5 text-[11px] font-bold text-white">${r.w}×${r.h} px</span>
            <span class="absolute top-2 right-2 rounded-full bg-emerald-700 px-2.5 py-0.5 text-[11px] font-bold text-white">${kb(r.blob.size)}</span>
          </div>
          <div class="mt-2.5 truncate text-sm font-bold text-slate-800" title="${escapeHtml(r.name)}">${escapeHtml(r.name)}</div>
          <div class="mt-0.5 text-xs text-slate-500">${vi ? 'Gốc' : 'Orig'}: ${kb(origSize)} → <b class="text-emerald-700">${kb(r.blob.size)}</b> ${saved > 0.01 ? `(-${(saved * 100).toFixed(0)}%)` : ''}</div>
          <div class="mt-3 grid grid-cols-2 gap-2">
            <button type="button" data-fine-edit="${idx}" class="btn-ghost py-1.5 px-2 text-xs font-bold">✎ ${vi ? 'Cắt & Đổi nền' : 'Fine-tune'}</button>
            <a href="${url}" download="${escapeHtml(r.name)}" class="btn-primary py-1.5 px-2 text-xs font-bold text-center">⬇ ${vi ? 'Tải ảnh' : 'Download'}</a>
          </div>`;
        out('list').appendChild(card);
      });
      out('summary').innerHTML = `<div class="grid gap-3 sm:grid-cols-3">
        <div class="stat"><div class="stat-label">${vi ? 'Dung lượng gốc' : 'Original size'}</div><div class="stat-value">${kb(before)}</div></div>
        <div class="stat"><div class="stat-label">${vi ? 'Dung lượng sau xử lý' : 'Output size'}</div><div class="stat-value text-emerald-700">${kb(after)}</div></div>
        <div class="stat"><div class="stat-label">${vi ? 'Đã giảm' : 'Saved'}</div><div class="stat-value">${before && after < before ? ((1 - after / before) * 100).toFixed(1) + '%' : 'Chuẩn kích thước'}</div></div></div>`;
    };

    out('list').addEventListener('click', (ev) => {
      const btn = (ev.target as HTMLElement).closest<HTMLElement>('[data-fine-edit]');
      if (!btn) return;
      openEditorFor(Number(btn.dataset.fineEdit));
    });

    const runProcess = async () => {
      if (!files.length) { out('count').textContent = vi ? 'Vui lòng chọn ít nhất 1 ảnh.' : 'Please select at least one image.'; return; }
      const myToken = ++runToken;
      const fd = new FormData(form);
      const o = {
        quality: Number(fd.get('quality')) || 0.85,
        maxWidth: Number(fd.get('maxWidth')) || 1920,
        maxHeight: Number(fd.get('maxHeight')) || 1920,
        format: String(fd.get('format') || 'image/jpeg'),
        cropMode: String(fd.get('cropMode') || 'orig'),
        bgColor: String(fd.get('bgColor') || ''),
        tolerance: Number(fd.get('tolerance')) || 32,
        targetKb: Number(fd.get('targetKb')) || 0
      };
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      btn.disabled = true;
      const nextResults: { name: string; blob: Blob; origSrc: string; w: number; h: number; origW?: number; origH?: number; isBlankInput?: boolean }[] = [];
      showResult(root);
      for (let i = 0; i < files.length; i++) {
        if (myToken !== runToken) return;
        const f = files[i];
        btn.textContent = `${i + 1}/${files.length}…`;
        try {
          const origSrc = await fileToDataUrl(f);
          const r = await processOne(f, o);
          const suffix = o.cropMode !== 'orig' ? `-${o.cropMode}` : '-edited';
          const name = f.name.replace(/\.[^.]+$/, '') + suffix + '.' + ext(o.format);
          nextResults.push({ name, blob: r.blob, origSrc, w: r.w, h: r.h, origW: r.origW, origH: r.origH, isBlankInput: r.isBlankInput });
        } catch (err: any) {
          const card = document.createElement('div');
          card.className = 'rounded-2xl border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700';
          card.textContent = `${f.name}: ${err.message}`;
          out('list').appendChild(card);
        }
      }
      if (myToken !== runToken) return;
      results = nextResults;
      renderCards();
      btn.disabled = false;
      btn.textContent = vi ? '⚡ Xử lý ảnh ngay' : '⚡ Process Photos';
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      scheduleProcess(0);
    });

    // Tự động nạp sẵn 1 ảnh nhân vật mẫu để khách hàng thấy ngay hình nhân vật và thử đổi nền Trắng/Xanh tức thì
    createSamplePortraitFile('male_shirt').then((sampleFile) => {
      if (!files.length) setFiles([sampleFile]);
    });

    root.querySelector('[data-action="zip"]')?.addEventListener('click', async () => {
      if (!results.length) return;
      const entries: Record<string, Uint8Array> = {};
      const used = new Set<string>();
      for (const r of results) {
        let n = r.name, k = 1;
        while (used.has(n)) n = r.name.replace(/(\.[^.]+)$/, `-${k++}$1`);
        used.add(n);
        entries[n] = new Uint8Array(await r.blob.arrayBuffer());
      }
      const zipped = zipSync(entries, { level: 0 });
      downloadBlob('anh-the-da-xu-ly.zip', new Blob([zipped], { type: 'application/zip' }));
    });
  });
</script>
