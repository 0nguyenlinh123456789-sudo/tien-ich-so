---
import MonetizedResult from '../MonetizedResult.astro';
import { PORTFOLIO_STYLES, PORTFOLIO_FIELDS } from '../../lib/portfolio-templates.js';
import { PORTFOLIO_PRESETS, OPEN_SOURCE_THEMES, LIVE_SEARCH_TOPICS } from '../../lib/portfolio-presets.js';
interface Props { lang?: 'vi' | 'en'; }
const { lang = 'vi' } = Astro.props;
const vi = lang === 'vi';
const uniqueStyles = [...new Map(PORTFOLIO_STYLES.map((s) => [s.id, s])).values()];
const styles = uniqueStyles.map((s) => ({ id: s.id, name: vi ? s.vi : s.en, desc: s.desc[lang], fields: s.fields.join(' ') }));
const fields = PORTFOLIO_FIELDS[lang];
const chip = 'rounded-full border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:border-brand-500';
---
<div data-tool="portfolio" data-lang={lang}>
  <div class="card mb-6">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-lg font-bold">{vi ? `1. Chọn mẫu giao diện (${styles.length} mẫu, gồm phong cách Vẽ tay)` : `1. Choose a template (${styles.length} styles incl. hand-drawn)`}</h2>
      <span class="text-xs text-slate-500">{vi ? 'Bản xem trước trực tiếp' : 'Live interactive thumbnails'}</span>
    </div>
    <div class="mb-4 flex flex-wrap gap-2">
      <button type="button" class={`${chip} !border-brand-600 !bg-brand-600 !text-white`} data-field="">{vi ? 'Tất cả' : 'All'}</button>
      {Object.entries(fields).map(([k, label]) => <button type="button" class={chip} data-field={k}>{label}</button>)}
    </div>
    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4" data-styles>
      {styles.map((s, i) => (
        <button type="button" data-style={s.id} data-fields={s.fields} hidden={i >= 8} class={`group rounded-xl border-2 bg-white p-2 text-left transition hover:border-brand-400 ${i === 0 ? 'border-brand-600' : 'border-slate-200'}`}>
          <div class="relative overflow-hidden rounded-lg bg-slate-100" style="aspect-ratio:16/11" data-thumb={s.id}></div>
          <div class="mt-2 px-1 font-semibold text-slate-900">{s.name}</div>
          <div class="px-1 pb-1 text-xs text-slate-500">{s.desc}</div>
        </button>
      ))}
    </div>
    <div class="mt-4 text-center">
      <button type="button" class="btn-ghost text-sm" data-pf-more>{vi ? `Xem tất cả ${styles.length} mẫu Portfolio (+${styles.length - 8})` : `Show all ${styles.length} templates (+${styles.length - 8})`}</button>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]" data-pf-workspace>
    <form class="card self-start" data-pf-form onsubmit="return false">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-bold">{vi ? '2. Thiết kế Hồ sơ & Tác phẩm' : '2. Customize Profile & Works'}</h2>
        <div class="inline-flex rounded-xl border border-slate-200 bg-slate-100 p-0.5 text-xs font-bold">
          <button type="button" data-studio-tab="presets" class="rounded-lg bg-slate-900 px-3 py-1.5 text-white transition">🎨 {vi ? 'Mẫu Điền Nhanh' : 'Presets & Themes'}</button>
          <button type="button" data-studio-tab="import" class="rounded-lg px-3 py-1.5 text-slate-600 transition hover:text-slate-900">🌐 {vi ? 'Đồng bộ GitHub / Tác giả' : 'Sync GitHub / Creators'}</button>
        </div>
      </div>

      <div data-studio-panel="presets">
        <div class="mb-3.5 rounded-xl bg-gradient-to-br from-amber-50 via-rose-50/60 to-violet-50 p-3.5 ring-1 ring-amber-200/80">
          <div class="mb-2 flex flex-wrap items-center justify-between gap-1">
            <span class="text-xs font-bold text-slate-800">⚡ {vi ? `${PORTFOLIO_PRESETS.length} Hồ sơ Mẫu theo Ngành (Tự động điền đầy đủ dự án & Case Study):` : `${PORTFOLIO_PRESETS.length} Industry Presets (Auto-fills projects & Case Studies):`}</span>
          </div>
          <div class="flex flex-wrap gap-1.5">
            {PORTFOLIO_PRESETS.map((p) => <button type="button" data-preset={p.id} class="rounded-full border border-slate-300 bg-white px-2.5 py-1 text-xs font-semibold transition hover:border-brand-500 hover:text-brand-700">{p.icon} {p.label?.[lang] || (p as any)[lang]?.label}</button>)}
          </div>
        </div>

        <div class="mb-4 rounded-xl border border-slate-200 bg-slate-50/70 p-3.5">
          <div class="mb-1.5 text-xs font-bold text-slate-800">🎨 {vi ? '16 Hệ Thiết Kế Độc Bản (Bố cục + Chất liệu Giấy + Bảng màu):' : '16 Design Systems (Layout + Paper + Palette):'}</div>
          <div class="flex flex-wrap gap-1.5">
            {OPEN_SOURCE_THEMES.map((th) => (
              <button type="button" data-os-theme={th.id} class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 shadow-2xs transition hover:border-brand-500 hover:bg-amber-50/40">
                <span class="h-2.5 w-2.5 rounded-full" style={`background:${th.color}`}></span>
                <span>{th.name[lang]}</span>
                {th.badge && <span class="rounded bg-amber-100 px-1 py-0.2 text-[9px] font-bold text-amber-900">{th.badge}</span>}
              </button>
            ))}
          </div>

          <div class="mt-3 flex flex-wrap items-center gap-1.5 border-t border-slate-200/80 pt-2.5">
            <button type="button" data-os-covers class="rounded-lg border border-indigo-300 bg-indigo-50 px-2.5 py-1 text-xs font-bold text-indigo-950 hover:bg-indigo-100">🖼 {vi ? 'Tạo Mockup' : 'Mockups'}</button>
            <button type="button" data-hand-covers class="rounded-lg border border-amber-400 bg-amber-50 px-2.5 py-1 text-xs font-bold text-amber-900 hover:bg-amber-100">🖌 {vi ? 'Tranh Vẽ Tay' : 'Hand-Drawn Covers'}</button>
            <button type="button" data-os-avatar class="rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 hover:border-brand-500">🎭 {vi ? 'Avatar Minh Họa' : 'Illustrated Avatar'}</button>
            <button type="button" data-pf-export-json class="rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 hover:border-brand-500">⬇ JSON</button>
            <label class="cursor-pointer rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 hover:border-brand-500">⬆ JSON<input type="file" accept=".json,application/json" class="hidden" data-pf-import-json /></label>
          </div>
        </div>
      </div>

      <div data-studio-panel="import" hidden class="mb-4 rounded-xl border border-emerald-200 bg-gradient-to-br from-emerald-50/70 via-white to-amber-50/50 p-3.5 shadow-sm">
        <p class="mb-3 text-xs text-slate-600">{vi ? 'Nhập username GitHub của chính bạn để tự điền hồ sơ và dự án từ dữ liệu công khai (GitHub REST API). Chỉ đọc, không cần đăng nhập.' : 'Enter your own GitHub username to auto-fill your profile and projects from public data (GitHub REST API). Read-only, no login.'}</p>

        <div class="rounded-lg border border-emerald-200/80 bg-white/90 p-2.5">
          <div class="mb-2 flex flex-wrap gap-1">
            {LIVE_SEARCH_TOPICS.map((tp) => (
              <button type="button" data-topic-query={tp.q} class="rounded-full border border-emerald-200 bg-emerald-50/70 px-2.5 py-1 text-[11px] font-semibold text-emerald-900 transition hover:border-emerald-500 hover:bg-emerald-100">
                {tp.label[lang]}
              </button>
            ))}
          </div>
          <div class="grid gap-1.5 sm:grid-cols-[1fr_auto_auto]">
            <input type="text" data-gh-user class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm focus:border-brand-500 focus:outline-none" placeholder={vi ? 'Nhập @username GitHub hoặc từ khóa...' : 'Enter GitHub @username or keyword...'} />
            <button type="button" data-gh-fetch class="btn-primary py-1.5 text-xs font-bold">⚡ {vi ? 'Nạp @Username' : 'Sync @User'}</button>
            <button type="button" data-gh-search class="rounded-lg border border-emerald-600 bg-emerald-600 px-3 py-1.5 text-xs font-bold text-white transition hover:bg-emerald-700">{vi ? 'Tìm mẫu' : 'Browse'}</button>
          </div>
          <div class="mt-1.5 flex flex-wrap items-center justify-between gap-1 text-[11px] text-slate-500">
            <span data-gh-status class="font-semibold text-emerald-700"></span>
          </div>
          <div data-discovery-results class="mt-2.5 hidden grid-cols-1 gap-2 sm:grid-cols-2"></div>
        </div>
      </div>

      <div class="grid gap-3" data-pf-fields></div>
      <div class="mt-4 rounded-xl border border-slate-200 bg-slate-50/70 p-3">
        <div class="label">{vi ? 'Ảnh chân dung / Ảnh thẻ' : 'Portrait / Avatar'}</div>
        <div class="flex flex-wrap items-center gap-2.5">
          <div data-pf-avatar-preview class="grid h-14 w-14 shrink-0 place-items-center overflow-hidden rounded-full border border-slate-300 bg-slate-100 text-lg text-slate-400">👤</div>
          <label class="btn-ghost cursor-pointer py-1.5 px-3 text-xs font-bold">📷 {vi ? 'Chọn ảnh' : 'Upload'}<input type="file" accept="image/*" class="hidden" data-pf-avatar /></label>
          <button type="button" class="btn-primary py-1.5 px-3 text-xs font-bold hidden" data-pf-avatar-edit>🪪 {vi ? 'Đổi nền Trắng/Xanh & Kích thước' : 'Edit Bg & Size'}</button>
          <button type="button" class="text-xs font-semibold text-slate-500 hover:text-rose-600 hidden" data-pf-avatar-del>{vi ? 'Xóa' : 'Remove'}</button>
        </div>
      </div>
      <div class="mt-5 border-t border-slate-200 pt-4">
        <div class="mb-2 flex flex-wrap items-center gap-2">
          <h3 class="mr-auto font-bold">{vi ? 'Tác phẩm & Dự án' : 'Projects & Works'} <span class="text-sm font-normal text-slate-500" data-pf-count></span></h3>
          <label class="btn-primary cursor-pointer py-1.5 text-sm">⬆ {vi ? 'Tải ảnh lên' : 'Upload work'}<input type="file" accept="image/*" multiple class="hidden" data-pf-bulk /></label>
          <button type="button" class="btn-ghost py-1.5 text-sm" data-pf-add>＋ {vi ? 'Thêm dự án' : 'Add project'}</button>
        </div>
        <div class="rounded-xl border-2 border-dashed border-slate-300 p-3 text-center text-xs text-slate-500 transition" data-pf-drop>{vi ? 'Kéo thả ảnh sản phẩm vào đây – bấm vào ảnh bất kỳ để cắt khung, đổi nền & nén KB' : 'Drop project images here – click any image to crop, edit background & compress KB'}</div>
        <div class="mt-3 grid gap-3" data-pf-projects></div>
      </div>
    </form>

    <div class="lg:sticky lg:top-20 lg:self-start" data-pf-stage>
      <div class="mb-3 flex flex-wrap items-center gap-2">
        <h2 class="mr-auto text-lg font-bold">{vi ? '3. Trình Chiếu Artboard 1400px & Xuất Bản' : '3. 1400px Artboard Stage & Export'}</h2>
        <div class="inline-flex rounded-xl border border-slate-300 bg-white p-0.5 text-xs font-bold">
          <button type="button" data-device="1400" class="rounded-lg bg-slate-900 px-2.5 py-1 text-white" title="1400px Artboard">🖥 1400px</button>
          <button type="button" data-device="390" class="rounded-lg px-2.5 py-1" title="Mobile Lookbook">📱 Mobile</button>
        </div>
        <button type="button" class="btn-ghost py-1.5 text-xs font-bold" data-pf-cinema title={vi ? 'Mở rộng bàn trình chiếu toàn chiều ngang' : 'Expand full-width presentation stage'}>⛶ {vi ? 'Rộng 100%' : 'Full Stage'}</button>
        <button type="button" class="btn-ghost py-1.5 text-xs font-bold !border-amber-400 !bg-amber-100" data-pf-editmode aria-pressed="true" title={vi ? 'Bấm vào chữ trên trang để sửa' : 'Click text on the page to edit'}>✎ {vi ? 'Sửa trực tiếp' : 'Inline Edit'}</button>
        <button type="button" class="btn-ghost py-1.5 text-xs font-bold" data-pf-print title={vi ? 'Xuất hoặc in thành cuốn Portfolio PDF nhiều trang' : 'Print or Save as multi-page PDF Portfolio Book'}>🖨 {vi ? 'Xuất PDF' : 'Save PDF'}</button>
        <button type="button" class="btn-primary py-1.5 text-xs font-bold" data-pf-download>⬇ {vi ? 'Tải Portfolio (.html)' : 'Download (.html)'}</button>
      </div>
      <div class="overflow-hidden rounded-2xl bg-slate-900 p-3 shadow-2xl ring-1 ring-slate-800" data-pf-frame>
        <div data-pf-scaler style="transform-origin:top left;margin:0 auto">
          <iframe title="Portfolio preview" data-pf-iframe sandbox="allow-scripts allow-modals" class="block rounded-lg bg-white shadow-xl" style="width:1400px;height:900px;border:0"></iframe>
        </div>
      </div>
      <p class="mt-2 text-xs text-slate-600">{vi ? '✎ Bấm trực tiếp vào tiêu đề, tuyên ngôn nghệ thuật, câu chuyện dự án hoặc bảng thông số trên Artboard để chỉnh sửa tại chỗ. Bấm "⛶ Rộng 100%" để ngắm trọn vẹn khổ 1400px.' : '✎ Click any title, artist statement, case study narrative or spec sheet directly on the artboard to edit inline. Click "⛶ Full Stage" to inspect at full 1400px scale.'}</p>
    </div>
  </div>

  <MonetizedResult context="tools" lang={lang} visible share={false} title={vi ? 'Gợi ý trình bày Portfolio chuyên nghiệp' : 'Tips for a professional portfolio presentation'}>
    <p class="text-sm text-slate-600">{vi ? 'Khác với website thông thường, một Portfolio tốt thường được trình bày như một cuốn Sách Triển Lãm (Editorial Artbook 1400px): mở đầu bằng Poster Bìa có dấu cắt khung (Crop Marks), tiếp nối bằng Mục Lục Tác Phẩm (Index 01–06), đi sâu vào từng Case Study đa khung (Mockup thực tế + Bản vẽ phác thảo tỷ lệ vàng + Bảng mã màu Pantone) và khép lại bằng tấm thẻ Tri Ân (Thank You for Watching).' : 'Unlike a generic website, a strong portfolio is often art-directed as a 1400px Editorial Exhibition Book: opening with a Cover Poster Artboard with crop marks, followed by an Indexed Table of Works (01–06), multi-board Case Studies (Hero Mockup + Wireframe Sketch + Pantone Spec Sheet), and closing with an Appreciation Colophon.'}</p>
  </MonetizedResult>
</div>

<script>
  import { renderPortfolio, portfolioFields, SECTION_KEYS, SECTION_NAMES, placeholder, handDrawnPlaceholder } from '../../lib/portfolio-templates.js';
  import { downloadBlob, escapeHtml } from '../../lib/format.js';
  import { safeImageSrc } from '../../lib/safe-url.js';
  import { openImageEditor } from '../../lib/image-editor.js';
  import { PORTFOLIO_PRESETS, OPEN_SOURCE_THEMES, QUICK_SNIPPETS } from '../../lib/portfolio-presets.js';

  function shrink(file: File, max = 1400): Promise<string> {
    return new Promise((resolve, reject) => {
      const img = new Image();
      img.onload = () => {
        const k = Math.min(1, max / Math.max(img.width, img.height));
        const cv = document.createElement('canvas');
        cv.width = Math.round(img.width * k); cv.height = Math.round(img.height * k);
        cv.getContext('2d')!.drawImage(img, 0, 0, cv.width, cv.height);
        URL.revokeObjectURL(img.src);
        resolve(cv.toDataURL('image/jpeg', 0.82));
      };
      img.onerror = reject;
      img.src = URL.createObjectURL(file);
    });
  }

  document.querySelectorAll<HTMLElement>('[data-tool="portfolio"]').forEach((root) => {
    const lang = (root.dataset.lang === 'en' ? 'en' : 'vi') as 'vi' | 'en';
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const fields = portfolioFields(lang);
    const storeKey = `mp:portfolio:${lang}`;
    const L = (a: string, b: string) => (lang === 'vi' ? a : b);
    const iframe = q<HTMLIFrameElement>('[data-pf-iframe]');
    const frame = q('[data-pf-frame]');
    const scaler = q('[data-pf-scaler]');
    let style = new URLSearchParams(location.search).get('style') || 'behance';
    let avatar = '';
    let device = 1400;

    let saved: Record<string, any> = {};
    try { saved = JSON.parse(localStorage.getItem(storeKey) || '{}'); } catch { saved = {}; }

    type Project = { title: string; cat: string; year: string; desc: string; link: string; orig: string; img: string; edit: any; challenge: string; solution: string; result: string; gallery: string[]; open?: boolean };
    const blank = (p: Partial<Project> = {}): Project => ({ title: '', cat: '', year: String(new Date().getFullYear()), desc: '', link: '', orig: '', img: '', edit: null, challenge: '', solution: '', result: '', gallery: [], ...p });
    const fromText = (txt: string) => String(txt || '').split('\n').map((l) => l.trim()).filter(Boolean).map((l) => {
      const [title = '', cat = '', year = '', desc = '', link = ''] = l.split('|').map((x) => x.trim());
      return blank({ title, cat, year, desc, link });
    });
    let projects: Project[] = Array.isArray(saved.projectList)
      ? saved.projectList.map((p: any) => blank(p))
      : fromText(saved.projects ?? fields.find((f: any) => f.name === 'projects')?.default ?? '');
    try {
      const imgs = JSON.parse(localStorage.getItem(storeKey + ':img') || '[]');
      imgs.forEach((x: any, i: number) => { if (projects[i] && x) Object.assign(projects[i], x, { gallery: Array.isArray(x.gallery) ? x.gallery : [] }); });
    } catch { /* no saved images */ }

    const SWATCHES = [
      ['#2563eb', L('Xanh dương – tin cậy, công nghệ', 'Blue – trust, tech')], ['#0d9488', L('Xanh ngọc – hiện đại, cân bằng', 'Teal – modern')],
      ['#16a34a', L('Xanh lá – tự nhiên, bền vững', 'Green – natural')], ['#ca8a04', L('Vàng nghệ – ấm áp, thủ công', 'Ochre – warm, crafted')],
      ['#ea580c', L('Cam – năng lượng, trẻ trung', 'Orange – energetic')], ['#db2777', L('Hồng – sáng tạo, thời trang', 'Pink – creative')],
      ['#b91c1c', L('Đỏ chu sa – ấn chương, nghệ thuật', 'Vermilion – seal, art')], ['#7c3aed', L('Tím – nghệ thuật, độc đáo', 'Violet – artistic')],
      ['#18181b', L('Đen – tối giản, cao cấp', 'Black – minimal')]
    ];

    const dominant = (src: string) => new Promise<string>((res) => {
      const img = new Image();
      img.onload = () => {
        const cv = document.createElement('canvas'); cv.width = cv.height = 48;
        const ctx = cv.getContext('2d')!; ctx.drawImage(img, 0, 0, 48, 48);
        const px = ctx.getImageData(0, 0, 48, 48).data;
        const bins = Array.from({ length: 24 }, () => ({ w: 0, r: 0, g: 0, b: 0 }));
        for (let i = 0; i < px.length; i += 4) {
          const [r, g, b] = [px[i], px[i + 1], px[i + 2]];
          const mx = Math.max(r, g, b), mn = Math.min(r, g, b), sat = mx ? (mx - mn) / mx : 0;
          if (sat < 0.25 || mx < 50 || mx > 250 && sat < 0.35) continue;
          let h = mx === mn ? 0 : mx === r ? (g - b) / (mx - mn) : mx === g ? 2 + (b - r) / (mx - mn) : 4 + (r - g) / (mx - mn);
          h = ((h * 60) + 360) % 360;
          const bin = bins[Math.floor(h / 15)], w = sat * sat;
          bin.w += w; bin.r += r * w; bin.g += g * w; bin.b += b * w;
        }
        const top = bins.sort((a, b) => b.w - a.w)[0];
        if (!top.w) return res('');
        const k = 0.85, hex = (n: number) => Math.round((n / top.w) * k).toString(16).padStart(2, '0');
        res(`#${hex(top.r)}${hex(top.g)}${hex(top.b)}`);
      };
      img.onerror = () => res('');
      img.src = src;
    });

    const ROW_SCHEMAS: Record<string, { cols: string[]; sample: string[] }> = {
      links: {
        cols: [L('Tên mạng / Kênh (VD: Website)', 'Label (e.g. Website)'), L('Đường dẫn (https://...)', 'URL (https://...)')],
        sample: ['Website', 'https://example.com/']
      },
      stats: {
        cols: [L('Con số (VD: 8+ hoặc 120%)', 'Number (e.g. 8+ or 120%)'), L('Nhãn mô tả (VD: Năm kinh nghiệm)', 'Label (e.g. Years experience)')],
        sample: ['10+', L('Dự án tiêu biểu', 'Featured projects')]
      },
      services: {
        cols: [L('Tên dịch vụ', 'Service title'), L('Mô tả chi tiết giá trị mang lại', 'Description & deliverables')],
        sample: [L('Thiết kế & Minh họa Độc bản', 'Bespoke Illustration & Design'), L('Phác thảo tay, phối màu thủ công và bàn giao trọn bộ file gốc', 'Hand-drawn concepts, custom palette and source files')]
      },
      pricing: {
        cols: [L('Tên gói (VD: Gói Cơ Bản)', 'Tier Name (e.g. Starter)'), L('Mức giá (VD: 5.000.000đ)', 'Price (e.g. $500)'), L('Quyền lợi & Hạng mục bàn giao', 'Deliverables & Perks')],
        sample: [L('Gói Độc Bản VIP', 'Bespoke VIP Tier'), L('12.000.000đ / dự án', '$950 / project'), L('Phác thảo 3 phương án; Chỉnh sửa linh hoạt; Bàn giao file gốc thương mại', '3 concept sketches; Flexible revisions; Full commercial source files')]
      },
      process: {
        cols: [L('Tên bước (VD: Khám phá & Phác thảo)', 'Step title'), L('Cách bạn thực hiện bước này', 'How you execute this step')],
        sample: [L('Phác thảo & Thử nghiệm chất liệu', 'Sketching & Material Study'), L('Vẽ tay concept trên giấy và gửi khách hàng duyệt bố cục', 'Hand-sketching concepts and reviewing composition')]
      },
      experience: {
        cols: [L('Giai đoạn (VD: 2023–nay)', 'Period (e.g. 2023–now)'), L('Vị trí / Vai trò', 'Role / Title'), L('Tổ chức / Studio', 'Company / Studio'), L('Thành tựu nổi bật', 'Key achievements')],
        sample: ['2024–nay', L('Art Director / Freelancer', 'Art Director / Freelancer'), 'Independent Studio', L('Thực hiện 25+ dự án thương hiệu và minh họa quốc tế', 'Delivered 25+ international branding & illustration projects')]
      },
      awards: {
        cols: [L('Năm', 'Year'), L('Tên giải thưởng / Triển lãm / Chứng chỉ', 'Award / Exhibition / Certificate'), L('Đơn vị cấp', 'Organization')],
        sample: ['2025', 'Giải thưởng / Ghi nhận', 'Đơn vị trao']
      },
      testimonials: {
        cols: [L('Lời nhận xét của khách hàng', 'Client quote'), L('Tên khách hàng', 'Client name'), L('Chức vụ / Công ty', 'Role / Company')],
        sample: [L('Tác phẩm có hồn, nét vẽ tay độc bản và bàn giao vượt mong đợi.', 'Soulful hand-crafted artwork delivered ahead of schedule.'), L('Minh Anh', 'Sarah Chen'), 'Creative Director']
      }
    };

    const getSnips = (fieldName: string): string[] => {
      const qs = QUICK_SNIPPETS as any;
      if (qs?.[fieldName]?.[lang]) return qs[fieldName][lang];
      if (qs?.[lang]?.[fieldName]) return qs[lang][fieldName];
      return [];
    };

    const fieldHtml = (f: any) => {
      const val = escapeHtml(saved[f.name] ?? f.default ?? '');
      if (f.type === 'hidden') return `<input type="hidden" name="${f.name}" value="${val}" />`;
      const id = `pf-${f.name}`;
      const label = `<label class="label" for="${id}">${escapeHtml(f.label)}</label>`;
      const ph = f.placeholder ? ` placeholder="${escapeHtml(f.placeholder)}"` : '';

      if (f.type === 'textarea' && ROW_SCHEMAS[f.name]) {
        return `<div class="rounded-xl border border-slate-200 bg-white p-2.5 shadow-2xs" data-vwrap="${f.name}">
          <div class="mb-1.5 flex flex-wrap items-center justify-between gap-1">
            ${label}
            <button type="button" data-vadd="${f.name}" class="rounded-lg bg-brand-50 px-2 py-0.5 text-xs font-bold text-brand-700 transition hover:bg-brand-100">＋ ${L('Thêm mục mới', 'Add item')}</button>
          </div>
          <div class="grid gap-1.5" data-vlist="${f.name}"></div>
          <details class="mt-1.5 text-xs text-slate-400">
            <summary class="cursor-pointer select-none hover:text-slate-600">⌨ ${L('Sửa nhanh bằng văn bản thô (dành cho người quen dùng dấu |)', 'Raw text mode (pipe | separated)')}</summary>
            <textarea id="${id}" name="${f.name}" rows="${f.rows || 3}" class="input mt-1 text-xs"${ph}>${val}</textarea>
          </details>
        </div>`;
      }

      if (f.type === 'textarea') return `<div>${label}<textarea id="${id}" name="${f.name}" rows="${f.rows || 3}" class="input text-sm"${ph}>${val}</textarea></div>`;
      if (f.type === 'select') return `<div>${label}<select id="${id}" name="${f.name}" class="input text-sm">${f.options.map((o: any) => `<option value="${escapeHtml(o.value)}"${o.value === (saved[f.name] ?? f.default) ? ' selected' : ''}>${escapeHtml(o.label)}</option>`).join('')}</select></div>`;
      if (f.type === 'color') return `<div>${label}<div class="flex flex-wrap items-center gap-1.5"><input id="${id}" name="${f.name}" type="color" value="${val}" class="h-9 w-12 cursor-pointer rounded border border-slate-300" />
${SWATCHES.map(([c, n]) => `<button type="button" data-sw="${c}" title="${escapeHtml(n)}" aria-label="${escapeHtml(n)}" class="h-7 w-7 rounded-full ring-2 ring-white ring-offset-1 ring-offset-slate-200 transition hover:scale-110" style="background:${c}"></button>`).join('')}
<button type="button" data-sw-pick class="ml-1 rounded-lg border border-slate-300 bg-white px-2 py-1 text-xs font-semibold hover:border-brand-500">🎯 ${L('Lấy màu từ sản phẩm', 'Match my work')}</button></div>
<p class="mt-1 text-xs text-slate-500">${L('Nguyên tắc 60-30-10: nền trung tính 60%, chữ 30%, màu nhấn 10% – chỉ cần chọn 1 màu nhấn nổi bật.', '60-30-10 rule: neutral background, text, and one strong accent.')}</p></div>`;

      const snips = (f.name === 'availability' || f.name === 'manifesto') ? getSnips(f.name) : [];
      const snipHtml = snips.length
        ? `<div class="mt-1 flex flex-wrap gap-1">${snips.map((s) => `<button type="button" data-snip-target="${f.name}" data-snip-val="${escapeHtml(s)}" class="rounded-md border border-slate-200 bg-white px-2 py-0.5 text-[11px] text-slate-600 transition hover:border-brand-400 hover:bg-brand-50 hover:text-brand-800">+ ${escapeHtml(s.length > 48 ? s.slice(0, 48) + '…' : s)}</button>`).join('')}</div>`
        : '';
      return `<div>${label}<input id="${id}" name="${f.name}" value="${val}" class="input text-sm"${ph} />${snipHtml}</div>`;
    };

    const GROUPS = [
      { t: L('① Thông tin cá nhân, Trạng thái & Chữ ký Vẽ tay', '① Personal Info, Availability & Handwritten Signature'), keys: ['name', 'role', 'availability', 'manifesto', 'signature', 'bio', 'email', 'location', 'links', 'skills'], open: true },
      { t: L('② Các mục trên trang, Bảng báo giá & Bố cục (Sửa từng dòng dễ dàng)', '② Page Sections, Pricing Tiers & Layout (Visual Row Editor)'), keys: ['sections', 'stats', 'services', 'pricing', 'process', 'testimonials', 'experience', 'awards', 'clients'], layout: true, open: true },
      { t: L('③ Giao diện, Chất liệu Giấy Vẽ Tay & Sticker Độc bản', '③ Look, Hand-Crafted Paper Textures & Floating Stickers'), keys: ['paperTexture', 'handSticker', 'font', 'color', 'coverMode'], open: true }
    ];
    const byName = Object.fromEntries(fields.map((f: any) => [f.name, f]));
    q('[data-pf-fields]').innerHTML = GROUPS.map((g) => `<details class="group rounded-xl border border-slate-200 bg-slate-50/60"${g.open ? ' open' : ''}>
<summary class="flex cursor-pointer list-none items-center justify-between px-3 py-2.5 font-semibold">${g.t}<span class="text-slate-400 transition group-open:rotate-180">⌄</span></summary>
<div class="grid gap-3 px-3 pb-3">${g.layout ? `<div><div class="label">${L('Bố cục trang – bật/tắt và kéo thả sắp xếp thứ tự các mục', 'Layout – toggle and drag to reorder sections')}</div><div class="grid gap-1" data-pf-layout></div><p class="mt-1 text-xs text-slate-500">${L('Mục có nội dung trống sẽ tự ẩn. Bạn có thể thêm/xóa từng dòng dịch vụ, bảng giá, kinh nghiệm bằng nút "＋ Thêm mục mới" bên dưới.', 'Empty sections hide automatically. Use "+ Add item" below to easily add or edit rows.')}</p></div>` : ''}${g.keys.map((k) => (byName[k] ? fieldHtml(byName[k]) : '')).join('')}</div></details>`).join('');

    const drawVisualList = (fname: string) => {
      const schema = ROW_SCHEMAS[fname];
      const box = root.querySelector<HTMLElement>(`[data-vlist="${fname}"]`);
      const ta = root.querySelector<HTMLTextAreaElement>(`[data-pf-fields] [name="${fname}"]`);
      if (!schema || !box || !ta) return;
      const lines = ta.value.split('\n').map((l) => l.trim()).filter(Boolean);
      const gridCols = schema.cols.length === 4 ? 'sm:grid-cols-4' : schema.cols.length === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2';
      box.innerHTML = lines.map((line, rIdx) => {
        const cells = line.split('|').map((c) => c.trim());
        return `<div class="relative grid gap-1.5 rounded-lg border border-slate-200 bg-slate-50/80 p-2 pr-7 ${gridCols}" data-vrow="${rIdx}">
          ${schema.cols.map((colPh, cIdx) => `<input type="text" data-vcell="${cIdx}" value="${escapeHtml(cells[cIdx] || '')}" placeholder="${escapeHtml(colPh)}" class="w-full rounded border border-slate-200 bg-white px-2 py-1 text-xs focus:border-brand-500 focus:outline-none" />`).join('')}
          <button type="button" data-vdel="${rIdx}" class="absolute right-1 top-1.5 rounded px-1 text-xs text-slate-400 hover:bg-red-50 hover:text-red-600" title="${L('Xóa dòng này', 'Delete row')}">✕</button>
        </div>`;
      }).join('') || `<div class="rounded-lg border border-dashed border-slate-200 p-2 text-center text-xs text-slate-400">${L('Chưa có mục nào – bấm "＋ Thêm mục mới" ở góc phải để thêm.', 'No items yet – click "+ Add item" above.')}</div>`;
    };
    const syncAllVisualLists = () => Object.keys(ROW_SCHEMAS).forEach(drawVisualList);
    syncAllVisualLists();

    const writeVisualToTextarea = (fname: string) => {
      const box = root.querySelector<HTMLElement>(`[data-vlist="${fname}"]`);
      const ta = root.querySelector<HTMLTextAreaElement>(`[data-pf-fields] [name="${fname}"]`);
      if (!box || !ta) return;
      const rows = [...box.querySelectorAll<HTMLElement>('[data-vrow]')].map((row) =>
        [...row.querySelectorAll<HTMLInputElement>('[data-vcell]')].map((inp) => inp.value.replace(/[|\n]/g, ' ').trim()).join(' | ')
      ).filter((line) => line.replace(/\|/g, '').trim().length > 0);
      ta.value = rows.join('\n');
    };

    const secInput = q<HTMLInputElement>('[name="sections"]');
    const readLayout = () => {
      const toks = secInput.value.split(',').filter(Boolean);
      const seen = toks.map((t) => t.replace(/^-/, ''));
      return [...toks.map((t) => ({ k: t.replace(/^-/, ''), on: !t.startsWith('-') })), ...SECTION_KEYS.filter((k: string) => !seen.includes(k)).map((k: string) => ({ k, on: true }))]
        .filter((x) => SECTION_KEYS.includes(x.k));
    };
    const drawLayout = () => {
      const lay = readLayout();
      q('[data-pf-layout]').innerHTML = lay.map((x, i) => `<div class="flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-sm ${x.on ? '' : 'opacity-50'}" data-li="${i}">
<span class="cursor-grab select-none text-slate-400" data-drag title="drag">⠿</span><input type="checkbox" class="h-4 w-4 accent-brand-600" data-lk ${x.on ? 'checked' : ''} aria-label="${escapeHtml(SECTION_NAMES[lang][x.k])}" /><span class="mr-auto">${escapeHtml(SECTION_NAMES[lang][x.k])}</span>
<button type="button" class="rounded px-1.5 text-slate-400 hover:bg-slate-100 disabled:opacity-30" data-lm="-1" ${i ? '' : 'disabled'}>↑</button><button type="button" class="rounded px-1.5 text-slate-400 hover:bg-slate-100 disabled:opacity-30" data-lm="1" ${i < lay.length - 1 ? '' : 'disabled'}>↓</button></div>`).join('');
    };
    const writeLayout = (lay: { k: string; on: boolean }[]) => { secInput.value = lay.map((x) => (x.on ? '' : '-') + x.k).join(','); drawLayout(); render(); };
    q('[data-pf-layout]').addEventListener('click', (ev) => {
      const t = ev.target as HTMLElement;
      const row = t.closest<HTMLElement>('[data-li]');
      if (!row) return;
      const lay = readLayout(), i = Number(row.dataset.li);
      if (t.matches('[data-lk]')) { lay[i].on = (t as HTMLInputElement).checked; return writeLayout(lay); }
      const m = t.closest<HTMLElement>('[data-lm]');
      if (m) { const j = i + Number(m.dataset.lm); [lay[i], lay[j]] = [lay[j], lay[i]]; writeLayout(lay); }
    });

    const values = () => {
      const v: Record<string, string> = {};
      root.querySelectorAll<HTMLInputElement>('[data-pf-fields] [name]').forEach((el) => (v[el.name] = el.value));
      const clean = (s: string) => String(s || '').replace(/[|\n]/g, ' ').trim();
      v.projects = projects.map((p) => [p.title || ' ', p.cat, p.year, p.desc, p.link].map(clean).join(' | ')).join('\n');
      return v;
    };
    let editMode = true;
    const html = (preview = false) => renderPortfolio(style, {
      ...values(), avatar,
      projectDetails: projects.map(({ challenge, solution, result, gallery }) => ({ challenge, solution, result, gallery }))
    }, projects.map((p) => p.img || p.orig), lang, { edit: preview && editMode });

    let cinemaMode = false;
    const fit = () => {
      const h = device >= 1280 ? (cinemaMode ? 980 : 900) : 760;
      iframe.style.width = device + 'px';
      iframe.style.height = h + 'px';
      const s = Math.min(1, (frame.clientWidth - 24) / device);
      scaler.style.width = device + 'px';
      scaler.style.transform = `scale(${s})`;
      scaler.style.height = h * s + 'px';
      scaler.style.marginLeft = device >= 1280 ? '0' : `${Math.max(0, (frame.clientWidth - 24 - device * s) / 2)}px`;
    };

    root.querySelectorAll<HTMLElement>('[data-studio-tab]').forEach((tabBtn) => {
      tabBtn.addEventListener('click', () => {
        const target = tabBtn.dataset.studioTab!;
        root.querySelectorAll<HTMLElement>('[data-studio-tab]').forEach((b) => {
          const active = b === tabBtn;
          b.classList.toggle('bg-slate-900', active);
          b.classList.toggle('text-white', active);
          b.classList.toggle('text-slate-600', !active);
        });
        root.querySelectorAll<HTMLElement>('[data-studio-panel]').forEach((panel) => {
          panel.hidden = panel.dataset.studioPanel !== target;
        });
      });
    });

    const cinemaBtn = root.querySelector<HTMLElement>('[data-pf-cinema]');
    const stageEl = root.querySelector<HTMLElement>('[data-pf-stage]');
    cinemaBtn?.addEventListener('click', () => {
      cinemaMode = !cinemaMode;
      stageEl?.classList.toggle('lg:col-span-2', cinemaMode);
      stageEl?.classList.toggle('lg:order-first', cinemaMode);
      cinemaBtn.classList.toggle('!bg-slate-900', cinemaMode);
      cinemaBtn.classList.toggle('!text-white', cinemaMode);
      cinemaBtn.textContent = cinemaMode ? L('◱ Thu gọn bàn dựng', '◱ Split View') : L('⛶ Rộng 100%', '⛶ Full Stage');
      setTimeout(fit, 50);
    });

    root.querySelector<HTMLElement>('[data-pf-print]')?.addEventListener('click', () => {
      try {
        iframe.contentWindow?.focus();
        iframe.contentWindow?.print();
      } catch {
        const w = window.open('', '_blank');
        if (w) { w.document.write(html()); w.document.close(); w.focus(); setTimeout(() => w.print(), 350); }
      }
    });

    let timer = 0;
    const render = (quiet: any = false) => {
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (quiet !== true) iframe.srcdoc = html(true);
        const { projects: _txt, ...rest } = values();
        const projectList = projects.map(({ orig, img, edit, gallery, open, ...p }) => p);
        try { localStorage.setItem(storeKey, JSON.stringify({ ...rest, projectList })); } catch { /* quota */ }
        try { localStorage.setItem(storeKey + ':img', JSON.stringify(projects.map(({ orig, img, edit, gallery }) => ({ orig, img, edit, gallery })))); }
        catch { try { localStorage.removeItem(storeKey + ':img'); } catch { /* blocked */ } }
      }, 250);
    };

    const markStyle = () => root.querySelectorAll<HTMLElement>('[data-style]').forEach((b) => {
      b.classList.toggle('border-brand-600', b.dataset.style === style);
      b.classList.toggle('border-slate-200', b.dataset.style !== style);
    });
    const inp = 'w-full rounded-lg border border-slate-300 px-2 py-1 text-sm focus:border-brand-500 focus:outline-none';
    const drawProjects = () => {
      q('[data-pf-count]').textContent = `(${projects.length})`;
      q('[data-pf-projects]').innerHTML = projects.map((p, i) => {
        const src = p.img || p.orig;
        const pic = src
          ? `<button type="button" data-pa="edit" class="group relative block aspect-[4/3] w-full overflow-hidden rounded-lg bg-slate-100" title="${L('Chỉnh sửa ảnh', 'Edit image')}"><img src="${src}" alt="" class="h-full w-full object-cover" /><span class="absolute inset-0 flex items-center justify-center bg-black/50 text-xs font-semibold text-white opacity-0 transition group-hover:opacity-100">✎ ${L('Chỉnh ảnh', 'Edit')}</span></button>`
          : `<label class="flex aspect-[4/3] w-full cursor-pointer flex-col items-center justify-center rounded-lg border-2 border-dashed border-slate-300 bg-slate-50 text-xs text-slate-500 hover:border-brand-500">⬆<span>${L('Thêm ảnh', 'Add image')}</span><input type="file" accept="image/*" class="hidden" data-pa="file" /></label>`;
        return `<div class="relative grid grid-cols-[96px_minmax(0,1fr)] gap-3 rounded-xl border border-slate-200 bg-white p-2.5 pl-6" data-pi="${i}"><span class="absolute left-1 top-1/2 -translate-y-1/2 cursor-grab select-none text-lg leading-none text-slate-300 hover:text-slate-500" data-drag title="drag">⠿</span>
<div class="space-y-1">${pic}
<div class="flex justify-between text-xs">${src ? `<label class="cursor-pointer text-brand-600 hover:underline" title="${L('Đổi ảnh khác', 'Replace')}">${L('Đổi', 'Swap')}<input type="file" accept="image/*" class="hidden" data-pa="file" /></label>` : '<span></span>'}<span class="text-slate-400">#${i + 1}</span></div></div>
<div class="grid gap-1.5">
<div class="flex gap-1.5"><input class="${inp} font-semibold" data-pk="title" value="${escapeHtml(p.title)}" placeholder="${L('Tên dự án', 'Project title')}" />
<button type="button" data-pa="up" class="rounded px-1.5 text-slate-400 hover:bg-slate-100 disabled:opacity-30" ${i ? '' : 'disabled'} title="${L('Lên', 'Up')}">↑</button>
<button type="button" data-pa="down" class="rounded px-1.5 text-slate-400 hover:bg-slate-100 disabled:opacity-30" ${i < projects.length - 1 ? '' : 'disabled'} title="${L('Xuống', 'Down')}">↓</button>
<button type="button" data-pa="del" class="rounded px-1.5 text-slate-400 hover:bg-red-50 hover:text-red-600" title="${L('Xóa', 'Delete')}">✕</button></div>
<div class="grid grid-cols-[minmax(0,1fr)_70px] gap-1.5"><input class="${inp}" data-pk="cat" value="${escapeHtml(p.cat)}" placeholder="${L('Lĩnh vực (Branding, Vẽ tay, 3D…)', 'Category')}" /><input class="${inp}" data-pk="year" value="${escapeHtml(p.year)}" placeholder="${L('Năm', 'Year')}" /></div>
<textarea class="${inp}" rows="2" data-pk="desc" placeholder="${L('Mô tả: vấn đề – cách làm – kết quả', 'Problem – process – result')}">${escapeHtml(p.desc)}</textarea>
<input class="${inp}" data-pk="link" value="${escapeHtml(p.link)}" placeholder="https://… (${L('không bắt buộc', 'optional')})" /></div>
<details class="col-span-2 rounded-lg bg-slate-50 px-2.5 py-1.5" data-pcs${p.open ? ' open' : ''}><summary class="cursor-pointer text-sm font-semibold text-brand-700">${L('Case study – kể quá trình tư duy', 'Case study – tell the story')} ${p.challenge || p.solution || p.result || p.gallery.length ? '✓' : ''}</summary>
<div class="mt-2 grid gap-1.5">
<textarea class="${inp}" rows="2" data-pk="challenge" placeholder="${L('Thử thách: khách hàng gặp vấn đề gì? Mục tiêu là gì?', 'Challenge: what problem, what goal?')}">${escapeHtml(p.challenge)}</textarea>
<textarea class="${inp}" rows="2" data-pk="solution" placeholder="${L('Giải pháp: bạn nghiên cứu, phác thảo và thiết kế thế nào?', 'Solution: how did you research, sketch, design?')}">${escapeHtml(p.solution)}</textarea>
<textarea class="${inp}" rows="2" data-pk="result" placeholder="${L('Kết quả: con số, phản hồi, giải thưởng (VD: doanh số +30%)', 'Result: numbers, feedback, awards')}">${escapeHtml(p.result)}</textarea>
<div class="text-xs font-semibold text-slate-600">${L('Bộ ảnh quá trình (phác thảo tay, màu nước, mockup) – tối đa 8', 'Process gallery (hand sketches, mockups) – up to 8')}</div>
<div class="grid grid-cols-4 gap-1.5">${p.gallery.map((g, k) => `<div class="group relative"><button type="button" data-pa="gedit" data-g="${k}" class="block w-full"><img src="${g}" alt="" class="aspect-square w-full rounded object-cover" /></button><button type="button" data-pa="gdel" data-g="${k}" class="absolute -right-1 -top-1 hidden h-5 w-5 rounded-full bg-red-600 text-xs text-white group-hover:block" aria-label="${L('Xóa ảnh', 'Remove')}">✕</button></div>`).join('')}
${p.gallery.length < 8 ? `<label class="flex aspect-square cursor-pointer items-center justify-center rounded border-2 border-dashed border-slate-300 text-lg text-slate-400 hover:border-brand-500">＋<input type="file" accept="image/*" multiple class="hidden" data-pa="gfile" /></label>` : ''}</div></div></details></div>`;
      }).join('') || `<p class="text-center text-sm text-slate-500">${L('Chưa có dự án nào – tải sản phẩm lên để bắt đầu.', 'No projects yet – upload your work.')}</p>`;
    };
    const nameOf = (f: File) => f.name.replace(/\.[^.]+$/, '').replace(/[-_]+/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 60);
    const addFiles = async (files: File[]) => {
      const list = files.filter((f) => f.type.startsWith('image/')).slice(0, 30);
      for (const f of list) {
        try { projects.push(blank({ title: nameOf(f), orig: await shrink(f) })); } catch { /* unreadable */ }
      }
      drawProjects(); render();
    };

    root.addEventListener('click', (ev) => {
      const t = ev.target as HTMLElement;
      const s = t.closest<HTMLElement>('[data-style]');
      if (s) {
        style = s.dataset.style!;
        history.replaceState(null, '', location.pathname + '?style=' + style);
        markStyle(); render();
        if (innerWidth < 1024) q('[data-pf-form]').scrollIntoView({ behavior: 'smooth' });
        return;
      }
      const d = t.closest<HTMLElement>('[data-device]');
      if (d) {
        device = Number(d.dataset.device);
        root.querySelectorAll<HTMLElement>('[data-device]').forEach((b) => {
          const on = b === d;
          b.classList.toggle('bg-slate-900', on); b.classList.toggle('text-white', on);
        });
        fit();
      }
    });

    q('[data-pf-fields]').addEventListener('input', (ev) => {
      const t = ev.target as HTMLElement;
      const vwrap = t.closest<HTMLElement>('[data-vwrap]');
      if (vwrap) {
        const fname = vwrap.dataset.vwrap!;
        if (t.matches('[data-vcell]')) writeVisualToTextarea(fname);
        else if (t.matches('textarea[name]')) drawVisualList(fname);
      }
      render();
    });

    let avatarOrig = '';
    let avatarEditState: any = null;
    const syncAvatarUi = () => {
      const box = root.querySelector<HTMLElement>('[data-pf-avatar-preview]');
      const editBtn = root.querySelector<HTMLElement>('[data-pf-avatar-edit]');
      const delBtn = root.querySelector<HTMLElement>('[data-pf-avatar-del]');
      const okSrc = safeImageSrc(avatar);
      if (box) box.innerHTML = okSrc ? `<img src="${okSrc}" alt="" class="h-full w-full object-cover" />` : '👤';
      editBtn?.classList.toggle('hidden', !avatar);
      delBtn?.classList.toggle('hidden', !avatar);
    };

    q<HTMLInputElement>('[data-pf-avatar]').addEventListener('change', async (ev) => {
      const f = (ev.target as HTMLInputElement).files?.[0];
      if (f) {
        try {
          avatarOrig = await shrink(f, 800);
          avatar = avatarOrig;
          avatarEditState = null;
          syncAvatarUi();
          render();
        } catch { /* unreadable */ }
      }
    });
    root.querySelector<HTMLElement>('[data-pf-avatar-edit]')?.addEventListener('click', async () => {
      if (!avatarOrig && !avatar) return;
      const res: any = await openImageEditor(avatarOrig || avatar, avatarEditState || { ratio: '1', outWidth: 600 }, lang);
      if (!res) return;
      avatar = res.dataUrl;
      avatarEditState = res.state;
      syncAvatarUi();
      render();
    });
    root.querySelector<HTMLElement>('[data-pf-avatar-del]')?.addEventListener('click', () => {
      avatar = ''; avatarOrig = ''; avatarEditState = null;
      syncAvatarUi();
      render();
    });
    q<HTMLInputElement>('[data-pf-bulk]').addEventListener('change', (ev) => {
      const el = ev.target as HTMLInputElement;
      addFiles([...(el.files || [])]); el.value = '';
    });
    q('[data-pf-add]').addEventListener('click', () => { projects.push(blank()); drawProjects(); render(); });
    const drop = q('[data-pf-drop]');
    const hot = (on: boolean) => ['border-brand-500', 'bg-brand-50'].forEach((c) => drop.classList.toggle(c, on));
    drop.addEventListener('dragover', (ev) => { ev.preventDefault(); hot(true); });
    drop.addEventListener('dragleave', () => hot(false));
    drop.addEventListener('drop', (ev) => { ev.preventDefault(); hot(false); addFiles([...(ev.dataTransfer?.files || [])]); });

    const list = q('[data-pf-projects]');
    list.addEventListener('toggle', (ev) => {
      const d = ev.target as HTMLDetailsElement;
      const card = d.closest<HTMLElement>('[data-pi]');
      if (d.matches('[data-pcs]') && card) projects[Number(card.dataset.pi)].open = d.open;
    }, true);
    list.addEventListener('input', (ev) => {
      const el = ev.target as HTMLInputElement;
      const card = el.closest<HTMLElement>('[data-pi]');
      if (!card || !el.dataset.pk) return;
      (projects[Number(card.dataset.pi)] as any)[el.dataset.pk] = el.value;
      render();
    });
    list.addEventListener('change', async (ev) => {
      const el = ev.target as HTMLInputElement;
      const card = el.closest<HTMLElement>('[data-pi]');
      if (!card || !el.files?.[0]) return;
      const p = projects[Number(card.dataset.pi)];
      if (el.dataset.pa === 'gfile') {
        for (const f of [...el.files].slice(0, 8 - p.gallery.length)) { try { p.gallery.push(await shrink(f, 1200)); } catch { /* unreadable */ } }
        p.open = true; drawProjects(); return render();
      }
      if (el.dataset.pa !== 'file') return;
      try { p.orig = await shrink(el.files[0]); p.img = ''; p.edit = null; if (!p.title) p.title = nameOf(el.files[0]); } catch { return; }
      drawProjects(); render();
    });
    list.addEventListener('click', async (ev) => {
      const b = (ev.target as HTMLElement).closest<HTMLElement>('button[data-pa]');
      const card = b?.closest<HTMLElement>('[data-pi]');
      if (!b || !card) return;
      const i = Number(card.dataset.pi);
      const act = b.dataset.pa;
      if (act === 'del') { if (!confirm(L('Xóa dự án này?', 'Delete this project?'))) return; projects.splice(i, 1); }
      else if (act === 'up' && i > 0) [projects[i - 1], projects[i]] = [projects[i], projects[i - 1]];
      else if (act === 'down' && i < projects.length - 1) [projects[i + 1], projects[i]] = [projects[i], projects[i + 1]];
      else if (act === 'edit') {
        const p = projects[i];
        const res = await openImageEditor(p.orig || p.img, p.edit, lang);
        if (!res) return;
        if (!p.orig) p.orig = p.img;
        p.img = res.dataUrl; p.edit = res.state;
      } else if (act === 'gdel') projects[i].gallery.splice(Number(b.dataset.g), 1);
      else if (act === 'gedit') {
        const p = projects[i], k = Number(b.dataset.g);
        const res = await openImageEditor(p.gallery[k], null, lang);
        if (!res) return;
        p.gallery[k] = res.dataUrl;
      } else return;
      drawProjects(); render();
    });
    q('[data-pf-download]').addEventListener('click', () => {
      const name = (values().name || 'portfolio').normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/gi, 'd').replace(/[^a-z0-9]+/gi, '-').toLowerCase();
      downloadBlob(`${name}-portfolio.html`, new Blob([html()], { type: 'text/html;charset=utf-8' }));
    });
    window.addEventListener('resize', fit);

    // Lightweight live thumbnails: omit extra long-scroll sections inside small preview cards so all thumbnails render fast.
    const thumbValues = { ...Object.fromEntries(fields.map((f: any) => [f.name, f.default ?? ''])), sections: '', availability: '', manifesto: '', signature: '' };
    const thumbIo = new IntersectionObserver((entries) => entries.forEach((en) => {
      if (!en.isIntersecting) return;
      const box = en.target as HTMLElement;
      thumbIo.unobserve(box);
      const f = document.createElement('iframe');
      f.setAttribute('sandbox', 'allow-scripts');
      f.setAttribute('loading', 'lazy');
      f.setAttribute('tabindex', '-1');
      f.title = box.dataset.thumb!;
      f.style.cssText = `width:1280px;height:880px;border:0;transform:scale(${box.clientWidth / 1280});transform-origin:top left;pointer-events:none`;
      f.srcdoc = renderPortfolio(box.dataset.thumb!, thumbValues, [], lang);
      box.appendChild(f);
    }), { rootMargin: '120px' });
    root.querySelectorAll('[data-thumb]').forEach((el) => thumbIo.observe(el));

    let pfExpanded = false;
    let activeField = '';
    const pfMoreBtn = root.querySelector<HTMLElement>('[data-pf-more]');
    const updateStyleGrid = () => {
      const cards = [...root.querySelectorAll<HTMLElement>('[data-style]')];
      const matching = cards.filter((c) => !activeField || c.dataset.fields!.split(' ').includes(activeField));
      cards.forEach((c) => { c.hidden = true; });
      const limit = pfExpanded || activeField ? matching.length : 8;
      matching.slice(0, limit).forEach((c) => {
        c.hidden = false;
        const th = c.querySelector('[data-thumb]');
        if (th && !th.firstChild) thumbIo.observe(th);
      });
      if (pfMoreBtn) {
        pfMoreBtn.classList.toggle('hidden', !!activeField || matching.length <= 8);
        pfMoreBtn.textContent = pfExpanded
          ? L('↑ Thu gọn danh sách mẫu', '↑ Show fewer templates')
          : L(`Xem tất cả ${matching.length} mẫu Portfolio (+${matching.length - 8})`, `Show all ${matching.length} templates (+${matching.length - 8})`);
      }
    };
    pfMoreBtn?.addEventListener('click', () => {
      pfExpanded = !pfExpanded;
      updateStyleGrid();
    });

    root.querySelectorAll<HTMLElement>('[data-field]').forEach((b) => b.addEventListener('click', () => {
      activeField = b.dataset.field!;
      root.querySelectorAll<HTMLElement>('[data-field]').forEach((x) => ['!border-brand-600', '!bg-brand-600', '!text-white'].forEach((c) => x.classList.toggle(c, x === b)));
      updateStyleGrid();
    }));

    const colorInput = q<HTMLInputElement>('[data-pf-fields] [name="color"]');

    root.querySelectorAll<HTMLElement>('[data-preset]').forEach((btn) => btn.addEventListener('click', () => {
      const pr = PORTFOLIO_PRESETS.find((x) => x.id === btn.dataset.preset);
      if (!pr) return;
      const pLabel = pr.label?.[lang] || (pr as any)[lang]?.label || pr.id;
      if (!confirm(L(`Điền bộ hồ sơ mẫu chuyên sâu "${pLabel}"? Nghề, tuyên ngôn, chữ ký tay, bảng giá, dự án, Case Study, kinh nghiệm và chất liệu giấy sẽ được cập nhật.`, `Fill "${pLabel}" complete preset? Role, manifesto, signature, pricing, projects, case studies and paper texture will be updated.`))) return;
      const c = (pr as any)[lang] || {};
      for (const k of ['role', 'availability', 'manifesto', 'signature', 'bio', 'skills', 'services', 'pricing', 'process', 'stats', 'experience', 'awards', 'testimonials', 'clients']) {
        const el = root.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-pf-fields] [name="${k}"]`);
        if (el && c[k] !== undefined) el.value = c[k];
      }
      for (const metaKey of ['paperTexture', 'handSticker']) {
        const el = root.querySelector<HTMLSelectElement>(`[data-pf-fields] [name="${metaKey}"]`);
        const metaVal = c[metaKey] ?? (pr as any)[metaKey];
        if (el && metaVal !== undefined) el.value = metaVal;
      }
      const isHand = ['illustrator_hand', 'oriental_craft', 'comic_game'].includes(pr.id) || ['inkwash', 'watercolor', 'botanical', 'comic', 'scrapbook', 'risograph', 'tarot_alchemy', 'clay_play'].includes(pr.style);
      const coverEl = root.querySelector<HTMLInputElement>('[data-pf-fields] [name="coverMode"]');
      if (coverEl) coverEl.value = isHand ? 'hand' : 'behance';
      const withPhoto = projects.filter((p) => p.img || p.orig);
      const next = fromText(c.projects);
      const details = Array.isArray(c.projectDetails) ? c.projectDetails : [];
      next.forEach((p, i) => {
        if (details[i]) Object.assign(p, { challenge: details[i].challenge || '', solution: details[i].solution || '', result: details[i].result || '' });
        const o = withPhoto[i];
        if (o) Object.assign(p, { orig: o.orig, img: o.img, edit: o.edit, gallery: o.gallery });
        else p.orig = isHand ? handDrawnPlaceholder(p.title, i, pr.color) : placeholder(p.title, i, pr.color);
      });
      projects = [...next, ...withPhoto.slice(next.length)];
      colorInput.value = pr.color;
      style = pr.style;
      history.replaceState(null, '', location.pathname + '?style=' + style);
      root.querySelectorAll<HTMLElement>('[data-preset]').forEach((b) => ['!border-brand-600', '!bg-brand-600', '!text-white'].forEach((cl) => b.classList.toggle(cl, b === btn)));
      syncAllVisualLists(); drawProjects(); markStyle(); render();
    }));

    const ghInput = root.querySelector<HTMLInputElement>('[data-gh-user]');
    const ghStatus = root.querySelector<HTMLElement>('[data-gh-status]');
    const discBox = root.querySelector<HTMLElement>('[data-discovery-results]');

    const syncGitHub = async (username: string) => {
      const clean = username.trim().replace(/^@/, '');
      if (!clean) { alert(L('Vui lòng nhập GitHub username.', 'Please enter a GitHub username.')); return; }
      if (ghStatus) ghStatus.textContent = L(`⏳ Đang nạp hồ sơ @${clean}...`, `⏳ Loading @${clean}...`);
      try {
        const [uRes, rRes] = await Promise.all([
          fetch(`https://api.github.com/users/${encodeURIComponent(clean)}`),
          fetch(`https://api.github.com/users/${encodeURIComponent(clean)}/repos?sort=pushed&per_page=40`)
        ]);
        if (!uRes.ok) throw new Error(`HTTP ${uRes.status}`);
        const user = await uRes.json();
        const repos: any[] = rRes.ok ? await rRes.json() : [];
        const sorted = [...repos].sort((a, b) => (b.stargazers_count || 0) - (a.stargazers_count || 0));
        const topRepos = sorted.slice(0, 6);
        const totalStars = repos.reduce((acc, r) => acc + (r.stargazers_count || 0), 0);
        const langs = [...new Set(repos.map((r) => r.language).filter(Boolean))];
        const topics = [...new Set(repos.flatMap((r) => Array.isArray(r.topics) ? r.topics : []))].slice(0, 8);
        const years = Math.max(1, new Date().getFullYear() - new Date(user.created_at || Date.now()).getFullYear());

        const setField = (name: string, val: string) => {
          const el = root.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-pf-fields] [name="${name}"]`);
          if (el && val) el.value = val;
        };
        setField('name', user.name || user.login);
        setField('signature', user.name || user.login);
        setField('role', user.company ? `${L('Kỹ sư Sáng tạo & Tác giả Mã nguồn mở', 'Creative Technologist & Open-Source Author')} @ ${user.company}` : L('Kỹ sư Phần mềm & Nhà Sáng tạo Độc lập', 'Creative Technologist & Open-Source Creator'));
        setField('bio', user.bio || L(`Nhà phát triển phần mềm và tác giả của ${user.public_repos || topRepos.length} dự án mã nguồn mở trên GitHub với ${totalStars.toLocaleString()} lượt sao.`, `Open-source creator maintaining ${user.public_repos || topRepos.length} public repositories with ${totalStars.toLocaleString()} stars on GitHub.`));
        setField('location', user.location || 'Global / Remote');
        if (user.email) setField('email', user.email);
        const linkLines = [`GitHub | ${user.html_url}`];
        if (user.blog) linkLines.push(`Website | ${/^https?:\/\//.test(user.blog) ? user.blog : 'https://' + user.blog}`);
        if (user.twitter_username) linkLines.push(`X / Twitter | https://x.com/${user.twitter_username}`);
        setField('links', linkLines.join('\n'));
        if (langs.length || topics.length) setField('skills', [...langs, ...topics].slice(0, 12).join(', '));
        setField('stats', `${user.public_repos || topRepos.length} | Public Repos\n${totalStars.toLocaleString()}★ | GitHub Stars\n${(user.followers || 0).toLocaleString()} | Followers\n${years}+ | ${L('Năm sáng tạo', 'Years active')}`);

        if (user.avatar_url) avatar = user.avatar_url;
        const isHandStyle = ['inkwash', 'watercolor', 'botanical', 'comic', 'scrapbook', 'risograph', 'tarot_alchemy', 'clay_play'].includes(style);
        if (topRepos.length) {
          projects = topRepos.map((r, idx) => blank({
            title: r.name,
            cat: r.language || 'Creative Source',
            year: String(new Date(r.pushed_at || r.created_at || Date.now()).getFullYear()),
            desc: (r.description || L('Dự án sáng tạo mã nguồn mở trên GitHub.', 'Open-source creative project on GitHub.')) + ` (★ ${(r.stargazers_count || 0).toLocaleString()} · ⑂ ${r.forks_count || 0})`,
            link: r.homepage && /^https?:\/\//.test(r.homepage) ? r.homepage : r.html_url,
            orig: isHandStyle ? handDrawnPlaceholder(r.name, idx, colorInput.value || '#b91c1c') : placeholder(r.name, idx, colorInput.value || '#10b981'),
            challenge: L(`Thiết kế và xây dựng giải pháp ${r.language || 'mã nguồn mở'} tối ưu trải nghiệm, tốc độ cao và dễ tùy biến cho cộng đồng.`, `Designing a fast, customizable ${r.language || 'open-source'} project for the community.`),
            solution: L(`Kiến trúc module hóa bằng ${r.language || 'TypeScript/JS'}, giao diện trực quan và tài liệu hướng dẫn chi tiết.`, `Modular architecture in ${r.language || 'modern stack'} with clean API and interactive demos.`),
            result: L(`Đạt ${(r.stargazers_count || 0).toLocaleString()} lượt Star ★, ${(r.forks_count || 0).toLocaleString()} bản Fork và được sử dụng rộng rãi.`, `Reached ${(r.stargazers_count || 0).toLocaleString()} ★ stars and ${(r.forks_count || 0).toLocaleString()} forks on GitHub.`)
          }));
        }
        syncAllVisualLists(); drawProjects(); render();
        if (ghStatus) ghStatus.textContent = `✓ @${user.login} (${topRepos.length} repos, ★${totalStars.toLocaleString()})`;
      } catch {
        if (ghStatus) ghStatus.textContent = L('⚠ Không tìm thấy @username này. Hãy thử bấm "🔍 Tìm Nhiều Mẫu" để tìm theo từ khóa!', '⚠ Username not found. Try clicking "Search Creators" to search by topic!');
      }
    };

    const searchCreatorsByTopic = async (rawQuery: string) => {
      const qStr = (rawQuery || 'creative portfolio webgl').trim();
      if (!discBox) return;
      if (ghStatus) ghStatus.textContent = L(`⏳ Đang tìm các tác giả về "${qStr}"...`, `⏳ Searching creators for "${qStr}"...`);
      discBox.classList.remove('hidden');
      discBox.classList.add('grid');
      discBox.innerHTML = `<div class="col-span-2 py-3 text-center text-xs text-slate-500">${L('⏳ Đang truy vấn GitHub Search API...', '⏳ Querying GitHub Search API...')}</div>`;
      try {
        const isUserQuery = qStr.includes('location:') || qStr.includes('followers:');
        const url = isUserQuery
          ? `https://api.github.com/search/users?q=${encodeURIComponent(qStr)}&per_page=8`
          : `https://api.github.com/search/repositories?q=${encodeURIComponent(qStr)}&sort=stars&per_page=8`;
        const res = await fetch(url);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        const items: any[] = Array.isArray(data.items) ? data.items : [];
        const seen = new Set<string>();
        const creators: { login: string; avatar: string; desc: string; stars?: number; repo?: string }[] = [];
        for (const it of items) {
          const login = isUserQuery ? it.login : it.owner?.login;
          const av = isUserQuery ? it.avatar_url : it.owner?.avatar_url;
          if (!login || seen.has(login)) continue;
          seen.add(login);
          creators.push({
            login,
            avatar: av || '',
            desc: isUserQuery ? L('Tác giả nổi bật trên GitHub', 'Featured GitHub Creator') : `${it.name}: ${(it.description || '').slice(0, 60)}`,
            stars: it.stargazers_count,
            repo: it.name
          });
          if (creators.length >= 6) break;
        }
        if (!creators.length) {
          discBox.innerHTML = `<div class="col-span-2 py-2 text-center text-xs text-slate-500">${L('Không tìm thấy kết quả. Hãy thử từ khóa khác (VD: threejs, figma, shader, game).', 'No results found. Try another keyword (e.g. threejs, figma, shader, game).')}</div>`;
          return;
        }
        discBox.innerHTML = creators.map((c) => `
          <div class="flex items-center gap-2.5 rounded-lg border border-slate-200 bg-slate-50/90 p-2 transition hover:border-brand-400 hover:bg-white">
            <img src="${safeImageSrc(c.avatar)}" alt="" class="h-9 w-9 shrink-0 rounded-full border border-slate-200 object-cover" loading="lazy" />
            <div class="min-w-0 flex-1">
              <div class="truncate text-xs font-bold text-slate-800">@${escapeHtml(c.login)} ${c.stars ? `<span class="text-[10px] font-semibold text-amber-600">★${c.stars.toLocaleString()}</span>` : ''}</div>
              <div class="truncate text-[11px] text-slate-500">${escapeHtml(c.desc)}</div>
            </div>
            <button type="button" data-pick-creator="${escapeHtml(c.login)}" class="shrink-0 rounded-md bg-brand-600 px-2 py-1 text-[11px] font-bold text-white hover:bg-brand-700">⚡ ${L('Nạp mẫu', 'Load')}</button>
          </div>
        `).join('');
        if (ghStatus) ghStatus.textContent = L(`✓ Tìm thấy ${creators.length} tác giả thực tế`, `✓ Found ${creators.length} creators`);
      } catch {
        discBox.innerHTML = `<div class="col-span-2 py-2 text-center text-xs text-amber-700">${L('⚠ Tạm vượt giới hạn tìm kiếm GitHub API. Vui lòng thử lại sau ít phút.', '⚠ GitHub Search rate limit reached. Please try again in a few minutes.')}</div>`;
      }
    };

    root.querySelector<HTMLElement>('[data-gh-fetch]')?.addEventListener('click', () => syncGitHub(ghInput?.value || ''));
    root.querySelector<HTMLElement>('[data-gh-search]')?.addEventListener('click', () => searchCreatorsByTopic(ghInput?.value || 'creative coding webgl'));
    ghInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        const v = ghInput.value.trim();
        if (v.includes(' ') || v.includes(':')) searchCreatorsByTopic(v);
        else syncGitHub(v);
      }
    });
    root.querySelectorAll<HTMLElement>('[data-topic-query]').forEach((btn) => btn.addEventListener('click', () => {
      const qStr = btn.dataset.topicQuery || '';
      if (ghInput) ghInput.value = qStr;
      searchCreatorsByTopic(qStr);
    }));
    discBox?.addEventListener('click', (ev) => {
      const btn = (ev.target as HTMLElement).closest<HTMLElement>('[data-pick-creator]');
      if (!btn) return;
      const login = btn.dataset.pickCreator || '';
      if (ghInput) ghInput.value = login;
      syncGitHub(login);
    });
    root.querySelectorAll<HTMLElement>('[data-gh-sample]').forEach((btn) => btn.addEventListener('click', () => {
      if (ghInput) ghInput.value = btn.dataset.ghSample || '';
      syncGitHub(btn.dataset.ghSample || '');
    }));

    root.querySelectorAll<HTMLElement>('[data-os-theme]').forEach((btn) => btn.addEventListener('click', () => {
      const th = OPEN_SOURCE_THEMES.find((x) => x.id === btn.dataset.osTheme);
      if (!th) return;
      style = th.style;
      colorInput.value = th.color;
      const fontEl = root.querySelector<HTMLSelectElement>('[data-pf-fields] [name="font"]');
      if (fontEl) fontEl.value = th.font;
      const texEl = root.querySelector<HTMLSelectElement>('[data-pf-fields] [name="paperTexture"]');
      if (texEl && (th as any).tex !== undefined) texEl.value = (th as any).tex;
      const stkEl = root.querySelector<HTMLSelectElement>('[data-pf-fields] [name="handSticker"]');
      if (stkEl && (th as any).stk !== undefined) stkEl.value = (th as any).stk;
      const isHand = ['inkwash', 'watercolor', 'botanical', 'comic', 'scrapbook', 'risograph', 'tarot_alchemy', 'clay_play', 'bauhaus_art', 'cyber_ink'].includes(th.style);
      const coverEl = root.querySelector<HTMLInputElement>('[data-pf-fields] [name="coverMode"]');
      if (coverEl) coverEl.value = isHand ? 'hand' : 'behance';
      projects.forEach((p, idx) => {
        if (!p.img && (!p.orig || p.orig.startsWith('data:image/svg+xml'))) {
          p.orig = isHand ? handDrawnPlaceholder(p.title || `Art ${idx + 1}`, idx, th.color) : placeholder(p.title || `Project ${idx + 1}`, idx, th.color);
        }
      });
      history.replaceState(null, '', location.pathname + '?style=' + style);
      drawProjects(); markStyle(); render();
    }));

    let diceIdx = 0;
    const diceStyles = ['notionists', 'lorelei', 'croodles', 'adventurer', 'open-peeps', 'micah'];
    root.querySelector<HTMLElement>('[data-os-avatar]')?.addEventListener('click', () => {
      const seed = encodeURIComponent((values().name || 'Artist') + '-' + diceIdx);
      const st = diceStyles[diceIdx % diceStyles.length];
      diceIdx++;
      avatar = `https://api.dicebear.com/9.x/${st}/svg?seed=${seed}&backgroundColor=fbf7ef,f6efe2,ffd5dc,ffdfbf,d1d4f9`;
      avatarOrig = avatar;
      syncAvatarUi();
      render();
    });
    root.querySelector<HTMLElement>('[data-hand-covers]')?.addEventListener('click', () => {
      const c = colorInput.value || '#b91c1c';
      const coverEl = root.querySelector<HTMLInputElement>('[data-pf-fields] [name="coverMode"]');
      if (coverEl) coverEl.value = 'hand';
      projects.forEach((p, idx) => { p.orig = handDrawnPlaceholder(p.title || `Artwork ${idx + 1}`, idx, c); p.img = ''; });
      drawProjects(); render();
    });
    root.querySelector<HTMLElement>('[data-os-covers]')?.addEventListener('click', () => {
      const c = colorInput.value || '#2563eb';
      const coverEl = root.querySelector<HTMLInputElement>('[data-pf-fields] [name="coverMode"]');
      if (coverEl) coverEl.value = 'behance';
      projects.forEach((p, idx) => { p.orig = placeholder(p.title || `Project ${idx + 1}`, idx, c); p.img = ''; });
      drawProjects(); render();
    });

    root.querySelector<HTMLElement>('[data-pf-export-json]')?.addEventListener('click', () => {
      const payload = { style, avatar, values: values(), projects };
      downloadBlob('portfolio-data.json', new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' }));
    });
    root.querySelector<HTMLInputElement>('[data-pf-import-json]')?.addEventListener('change', async (ev) => {
      const f = (ev.target as HTMLInputElement).files?.[0];
      if (!f) return;
      try {
        const data = JSON.parse(await f.text());
        if (data.style) style = data.style;
        if (data.avatar) avatar = data.avatar;
        if (data.values) {
          Object.entries(data.values).forEach(([k, val]) => {
            const el = root.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-pf-fields] [name="${k}"]`);
            if (el && typeof val === 'string') el.value = val;
          });
        }
        if (Array.isArray(data.projects)) projects = data.projects.map((p: any) => blank(p));
        syncAllVisualLists(); drawProjects(); markStyle(); render();
      } catch { alert(L('File JSON không hợp lệ.', 'Invalid JSON file.')); }
    });

    q('[data-pf-fields]').addEventListener('click', async (ev) => {
      const t = ev.target as HTMLElement;
      const snip = t.closest<HTMLElement>('[data-snip-target]');
      if (snip) {
        const targetName = snip.dataset.snipTarget!;
        const targetEl = root.querySelector<HTMLInputElement>(`[data-pf-fields] [name="${targetName}"]`);
        if (targetEl) { targetEl.value = snip.dataset.snipVal || ''; render(); }
        return;
      }
      const vadd = t.closest<HTMLElement>('[data-vadd]');
      if (vadd) {
        const fname = vadd.dataset.vadd!;
        const schema = ROW_SCHEMAS[fname];
        const ta = root.querySelector<HTMLTextAreaElement>(`[data-pf-fields] [name="${fname}"]`);
        if (schema && ta) {
          const cur = ta.value.trim();
          ta.value = (cur ? cur + '\n' : '') + schema.sample.join(' | ');
          drawVisualList(fname); render();
        }
        return;
      }
      const vdel = t.closest<HTMLElement>('[data-vdel]');
      if (vdel) {
        const vwrap = vdel.closest<HTMLElement>('[data-vwrap]');
        const row = vdel.closest<HTMLElement>('[data-vrow]');
        if (vwrap && row) {
          row.remove();
          writeVisualToTextarea(vwrap.dataset.vwrap!);
          drawVisualList(vwrap.dataset.vwrap!);
          render();
        }
        return;
      }
      const sw = t.closest<HTMLElement>('[data-sw]');
      if (sw) { colorInput.value = sw.dataset.sw!; return render(); }
      const pick = t.closest<HTMLButtonElement>('[data-sw-pick]');
      if (!pick) return;
      const src = projects.map((p) => p.img || p.orig).find(Boolean);
      if (!src) { alert(L('Hãy tải ít nhất 1 ảnh sản phẩm trước.', 'Upload at least one project image first.')); return; }
      const c = await dominant(src);
      if (c) { colorInput.value = c; render(); }
    });

    const sortable = (box: HTMLElement, attr: string, move: (from: number, to: number) => void) => {
      let from = -1, over = -1;
      const mark = (i: number) => box.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((el) => {
        const on = Number(el.getAttribute(attr)) === i && i !== from;
        el.classList.toggle('ring-2', on); el.classList.toggle('ring-brand-500', on);
      });
      box.addEventListener('pointerdown', (ev) => {
        const h = (ev.target as HTMLElement).closest('[data-drag]');
        const item = h?.closest<HTMLElement>(`[${attr}]`);
        if (!h || !item) return;
        ev.preventDefault();
        from = over = Number(item.getAttribute(attr));
        item.classList.add('opacity-50');
        (h as HTMLElement).setPointerCapture(ev.pointerId);
      });
      let vy = 0, lastX = 0, lastY = 0, raf = 0;
      const hover = () => {
        const el = document.elementFromPoint(lastX, lastY)?.closest<HTMLElement>(`[${attr}]`);
        if (el && box.contains(el)) { over = Number(el.getAttribute(attr)); mark(over); }
      };
      const tick = () => { if (from < 0 || !vy) { raf = 0; return; } scrollBy(0, vy); hover(); raf = requestAnimationFrame(tick); };
      box.addEventListener('pointermove', (ev) => {
        if (from < 0) return;
        lastX = ev.clientX; lastY = ev.clientY;
        vy = lastY < 90 ? -14 : lastY > innerHeight - 90 ? 14 : 0;
        if (vy && !raf) raf = requestAnimationFrame(tick);
        hover();
      });
      const end = () => {
        vy = 0;
        if (from < 0) return;
        const f = from, t = over;
        from = over = -1;
        box.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((el) => el.classList.remove('opacity-50', 'ring-2', 'ring-brand-500'));
        if (t >= 0 && t !== f) move(f, t);
      };
      box.addEventListener('pointerup', end); box.addEventListener('pointercancel', end);
    };
    const shift = <T,>(arr: T[], f: number, t: number) => { const [x] = arr.splice(f, 1); arr.splice(t, 0, x); return arr; };
    sortable(list, 'data-pi', (f, t) => { shift(projects, f, t); drawProjects(); render(); });
    sortable(q('[data-pf-layout]'), 'data-li', (f, t) => writeLayout(shift(readLayout(), f, t)));

    window.addEventListener('message', (ev) => {
      if (ev.source !== iframe.contentWindow || ev.data?.type !== 'pf-edit') return;
      const key = String(ev.data.key), value = String(ev.data.value).slice(0, 2000);
      const m = /^p(\d+)\.(title|cat|desc|challenge|solution|result)$/.exec(key);
      const f = /^f:(stats|services|pricing|process|testimonials|experience|awards|clients):(\d+):(\d+)$/.exec(key);
      if (m) {
        const p = projects[Number(m[1])];
        if (!p) return;
        (p as any)[m[2]] = value;
        const el = root.querySelector<HTMLInputElement>(`[data-pi="${m[1]}"] [data-pk="${m[2]}"]`);
        if (el) el.value = value;
      } else if (f) {
        const el = root.querySelector<HTMLTextAreaElement>(`[data-pf-fields] [name="${f[1]}"]`);
        if (!el) return;
        const clean = value.replace(/[|\n]/g, ' ');
        if (f[1] === 'clients') {
          const items = el.value.split(',').map((x) => x.trim()).filter(Boolean);
          if (Number(f[2]) >= items.length) return;
          items[Number(f[2])] = clean.replace(/,/g, ' ');
          el.value = items.join(', ');
        } else {
          const rows = el.value.split('\n');
          const live = rows.map((l, i) => (l.trim() ? i : -1)).filter((i) => i >= 0);
          const at = live[Number(f[2])];
          if (at === undefined) return;
          const cells = rows[at].split('|').map((x) => x.trim());
          cells[Number(f[3])] = clean;
          rows[at] = cells.join(' | ');
          el.value = rows.join('\n');
          drawVisualList(f[1]);
        }
      } else {
        const el = root.querySelector<HTMLInputElement>(`[data-pf-fields] [name="${key}"]`);
        if (!el || !['name', 'role', 'bio', 'location', 'manifesto', 'availability', 'signature'].includes(key)) return;
        el.value = value;
      }
      render(true);
    });
    const editBtn = q<HTMLButtonElement>('[data-pf-editmode]');
    editBtn.addEventListener('click', () => {
      editMode = !editMode;
      editBtn.classList.toggle('!bg-amber-100', editMode); editBtn.classList.toggle('!border-amber-400', editMode);
      editBtn.setAttribute('aria-pressed', String(editMode));
      render();
    });

    drawProjects(); drawLayout(); markStyle(); fit();
    iframe.srcdoc = html(true);
  });
</script>
