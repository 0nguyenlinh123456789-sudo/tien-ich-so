---
interface Props { lang?: 'vi' | 'en'; }
const { lang = 'en' } = Astro.props;
const vi = lang === 'vi';
---
<div data-tool="tip" data-lang={lang} class="grid gap-5 lg:grid-cols-2">
  <form class="card grid content-start gap-3" data-f>
    <div><label class="label">{vi ? 'Hóa đơn' : 'Bill amount'}</label><input class="input text-2xl" type="number" step="0.01" name="bill" value="85" /></div>
    <div><label class="label">{vi ? 'Tip (%)' : 'Tip (%)'}</label>
      <div class="flex flex-wrap gap-2">{[10, 15, 18, 20, 22, 25].map((p) => <label class="cursor-pointer"><input type="radio" name="pct" value={p} checked={p === 18} class="peer sr-only" /><span class="block rounded-xl border border-slate-300 px-3 py-2 font-semibold peer-checked:border-brand-600 peer-checked:bg-brand-600 peer-checked:text-white">{p}%</span></label>)}</div></div>
    <div><label class="label">{vi ? 'Số người chia' : 'Split between'}</label><input class="input" type="number" min="1" name="people" value="2" /></div>
    <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="round" /> {vi ? 'Làm tròn lên mỗi người' : 'Round up per person'}</label>
  </form>
  <div class="card" data-out></div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-tool="tip"]').forEach((root) => {
    const vi = root.dataset.lang === 'vi';
    const form = root.querySelector<HTMLFormElement>('[data-f]')!;
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    const m = (x: number) => x.toLocaleString(vi ? 'vi-VN' : 'en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const calc = () => {
      const f = new FormData(form);
      const bill = Number(f.get('bill')) || 0, pct = Number(f.get('pct')), ppl = Math.max(1, Number(f.get('people')) || 1);
      const tip = (bill * pct) / 100;
      let each = (bill + tip) / ppl;
      if (f.get('round')) each = Math.ceil(each);
      out.innerHTML = `<div class="text-sm text-slate-500">${vi ? 'Mỗi người trả' : 'Each person pays'}</div><div class="text-5xl font-extrabold text-brand-700">${m(each)}</div>
        <div class="table-wrap mt-4"><table class="data-table"><tbody>
        <tr><td>Tip ${pct}%</td><td class="num">${m(tip)}</td></tr><tr><td>${vi ? 'Tổng' : 'Total'}</td><td class="num font-semibold">${m(bill + tip)}</td></tr>
        ${[15, 18, 20].map((p) => `<tr><td class="text-slate-500">${vi ? 'Nếu' : 'At'} ${p}%</td><td class="num text-slate-500">${m(bill * p / 100)}</td></tr>`).join('')}
        </tbody></table></div>`;
    };
    form.addEventListener('input', calc);
    calc();
  });
</script>
