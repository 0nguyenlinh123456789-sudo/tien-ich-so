---
// Quyết toán thuế TNCN năm & thuế thưởng Tết. Logic: src/lib/pit-annual.js
// Căn cứ: Luật Thuế TNCN 109/2025/QH15 (biểu 5 bậc), NQ 110/2025/UBTVQH15 (giảm trừ gia cảnh).
interface Props { lang?: 'vi' | 'en'; }
const { lang = 'vi' } = Astro.props;
const vi = lang === 'vi';
const opt = 'flex-1 cursor-pointer rounded-xl border border-slate-300 p-3 has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50';
---
<div data-tool="pitannual" data-lang={lang} class="grid gap-5 lg:grid-cols-2">
  <form class="card grid content-start gap-3" data-f>
    <div class="flex gap-2">
      <label class={opt}><input type="radio" name="mode" value="annual" class="mr-2" checked />{vi ? 'Quyết toán năm' : 'Annual finalization'}</label>
      <label class={opt}><input type="radio" name="mode" value="bonus" class="mr-2" />{vi ? 'Thuế thưởng Tết' : 'Tết bonus tax'}</label>
    </div>
    <div data-m="annual" class="grid gap-3">
      <div><label class="label">{vi ? 'Tổng lương, thưởng cả năm (trước thuế, đồng)' : 'Total salary and bonuses for the year (pre-tax, VND)'}</label><input class="input text-lg" name="income" data-money inputmode="numeric" value="240.000.000" /></div>
      <div><label class="label">{vi ? 'Bảo hiểm bắt buộc đã đóng cả năm (đồng)' : 'Compulsory insurance paid in the year (VND)'}</label><input class="input" name="ins" data-money inputmode="numeric" value="25.200.000" /></div>
      <div class="grid grid-cols-2 gap-3">
        <div><label class="label">{vi ? 'Số người phụ thuộc' : 'Dependents'}</label><input class="input" name="deps" type="number" inputmode="numeric" min="0" max="20" value="0" /></div>
        <div><label class="label">{vi ? 'Số tháng/người' : 'Months each'}</label><input class="input" name="depm" type="number" inputmode="numeric" min="0" max="12" value="12" /></div>
      </div>
      <div><label class="label">{vi ? 'Thuế đã bị khấu trừ trong năm (đồng)' : 'Tax already withheld (VND)'}</label><input class="input" name="withheld" data-money inputmode="numeric" value="2.000.000" /></div>
      <p class="text-xs text-slate-500">{vi ? 'Phần lương làm thêm giờ trả cao hơn ngày thường được miễn thuế — không nhập phần này.' : 'Overtime pay above the normal rate is tax-exempt — do not include it.'}</p>
    </div>
    <div data-m="bonus" class="grid gap-3" hidden>
      <div><label class="label">{vi ? 'Lương gross tháng nhận thưởng (đồng)' : 'Gross salary of the bonus month (VND)'}</label><input class="input text-lg" name="gross" data-money inputmode="numeric" value="20.000.000" /></div>
      <div><label class="label">{vi ? 'Tiền thưởng / lương tháng 13 (đồng)' : 'Bonus / 13th-month pay (VND)'}</label><input class="input text-lg" name="bonus" data-money inputmode="numeric" value="20.000.000" /></div>
      <div><label class="label">{vi ? 'Bảo hiểm bắt buộc tháng đó (đồng)' : 'Compulsory insurance that month (VND)'}</label><input class="input" name="bins" data-money inputmode="numeric" value="2.100.000" /></div>
      <div><label class="label">{vi ? 'Số người phụ thuộc' : 'Dependents'}</label><input class="input" name="bdeps" type="number" inputmode="numeric" min="0" max="20" value="0" /></div>
    </div>
  </form>
  <div class="card" data-out></div>
</div>

<script>
  import { annualSettlement, bonusTax } from '../../lib/pit-annual.js';
  import { TAX_CONFIG } from '../../lib/salary.js';

  document.querySelectorAll<HTMLElement>('[data-tool="pitannual"]').forEach((root) => {
    const vi = root.dataset.lang !== 'en';
    const form = root.querySelector<HTMLFormElement>('[data-f]')!;
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    const n = (x: number) => (Number.isFinite(x) ? Math.round(x) : 0).toLocaleString('vi-VN');
    const pct = (x: number) => (x * 100).toLocaleString(vi ? 'vi-VN' : 'en-US', { maximumFractionDigits: 2 }) + '%';
    const money = (k: string) => Number(String(new FormData(form).get(k) ?? '').replace(/\D/g, '').slice(0, 15)) || 0;
    // Số nguyên trong [0, max]; chặn NaN/âm/quá lớn.
    const int = (k: string, max: number) => { const v = Math.floor(Number(new FormData(form).get(k))); return Number.isFinite(v) && v > 0 ? Math.min(v, max) : 0; };
    form.querySelectorAll<HTMLInputElement>('[data-money]').forEach((el) => el.addEventListener('input', () => { const d = el.value.replace(/\D/g, '').slice(0, 15); el.value = d ? Number(d).toLocaleString('vi-VN') : ''; }));
    const note = (s: string) => `<p class="mt-3 text-xs text-slate-500">${s}</p>`;
    const row = (l: string, v: string, b = false) => `<div class="flex justify-between gap-3 py-1 text-sm ${b ? 'font-semibold' : ''}"><span class="min-w-0 break-words">${l}</span><span class="shrink-0 whitespace-nowrap">${v}</span></div>`;
    const d = vi ? ' đ' : ' VND';
    const basis = `<details class="mt-3 text-xs text-slate-500"><summary class="cursor-pointer">${vi ? 'Căn cứ pháp lý' : 'Legal basis'}</summary><p class="mt-1">${vi
      ? `Luật Thuế TNCN 109/2025/QH15 (biểu lũy tiến 5 bậc, áp dụng kỳ tính thuế 2026); NQ 110/2025/UBTVQH15 (giảm trừ ${n(TAX_CONFIG.personalDeduction)} đ/tháng bản thân, ${n(TAX_CONFIG.dependentDeduction)} đ/tháng mỗi người phụ thuộc).`
      : `PIT Law 109/2025/QH15 (5-bracket schedule, tax period 2026); Resolution 110/2025/UBTVQH15 (deductions ${n(TAX_CONFIG.personalDeduction)} VND/month self, ${n(TAX_CONFIG.dependentDeduction)} VND/month per dependent).`}</p></details>`;

    const bracketRows = (detail: { from: number; to: number | null; rate: number; taxable: number; tax: number }[]) =>
      detail.filter((x) => x.taxable > 0).map((x) => row(`${pct(x.rate)} × ${n(x.taxable)}`, `${n(x.tax)}${d}`)).join('');

    const calc = () => {
      const mode = String(new FormData(form).get('mode'));
      root.querySelectorAll<HTMLElement>('[data-m]').forEach((el) => (el.hidden = el.dataset.m !== mode));
      let h = '';
      if (mode === 'bonus') {
        const r = bonusTax({ monthlyGross: money('gross'), bonus: money('bonus'), insurance: money('bins'), dependents: int('bdeps', 20) });
        h += `<div class="text-sm text-slate-500">${vi ? 'Thuế phát sinh do thưởng' : 'Extra tax caused by the bonus'}</div><div class="text-4xl font-extrabold text-brand-700">${n(r.bonusTax)}${d}</div><div class="mt-1 text-sm text-slate-600">${vi ? 'Thực nhận từ thưởng' : 'Bonus take-home'}: <b>${n(r.bonusNet)}${d}</b> (${vi ? 'thuế' : 'tax'} ${pct(r.effectiveRate)})</div>`;
        h += `<div class="mt-4 border-t pt-2">`
          + row(vi ? 'Giảm trừ gia cảnh tháng' : 'Monthly deductions', `${n(r.deduction)}${d}`)
          + row(vi ? 'Thu nhập tính thuế tháng không có thưởng' : 'Assessable income without bonus', `${n(r.baseAssess)}${d}`)
          + row(vi ? 'Thuế tháng không có thưởng' : 'Tax without bonus', `${n(r.taxBase)}${d}`)
          + row(vi ? 'Thu nhập tính thuế tháng có thưởng' : 'Assessable income with bonus', `${n(r.withAssess)}${d}`)
          + row(vi ? 'Thuế tháng có thưởng' : 'Tax with bonus', `${n(r.taxWith)}${d}`, true)
          + `</div>`;
        h += note(vi ? 'Thưởng được cộng vào thu nhập tháng chi trả để tạm khấu trừ; quyết toán cuối năm mới ra số thuế chính xác.' : 'The bonus is added to the month paid for provisional withholding; the annual finalization determines the exact tax.');
      } else {
        const r = annualSettlement({ totalTaxableIncome: money('income'), insurance: money('ins'), dependentMonths: int('deps', 20) * int('depm', 12), withheld: money('withheld') });
        const label = r.status === 'pay' ? (vi ? 'Phải nộp thêm' : 'Additional tax due') : r.status === 'refund' ? (vi ? 'Được hoàn' : 'Refund') : (vi ? 'Không chênh lệch' : 'No difference');
        const color = r.status === 'refund' ? 'text-green-700' : 'text-brand-700';
        h += `<div class="text-sm text-slate-500">${label}</div><div class="text-4xl font-extrabold ${color}">${n(Math.abs(r.diff))}${d}</div><div class="mt-1 text-sm text-slate-600">${vi ? 'Thuế TNCN phải nộp cả năm' : 'Annual PIT'}: <b>${n(r.tax)}${d}</b></div>`;
        h += `<div class="mt-4 border-t pt-2">`
          + row(vi ? 'Tổng lương, thưởng cả năm' : 'Total salary and bonuses', `${n(r.income)}${d}`)
          + row(vi ? '− Bảo hiểm bắt buộc' : '− Compulsory insurance', `${n(r.insurance)}${d}`)
          + row(vi ? `− Giảm trừ bản thân (${n(TAX_CONFIG.personalDeduction)} × 12)` : `− Personal deduction (${n(TAX_CONFIG.personalDeduction)} × 12)`, `${n(r.personal)}${d}`)
          + row(vi ? `− Người phụ thuộc (${n(TAX_CONFIG.dependentDeduction)} × ${r.dependentMonths} tháng-người)` : `− Dependents (${n(TAX_CONFIG.dependentDeduction)} × ${r.dependentMonths} person-months)`, `${n(r.dependent)}${d}`)
          + row(vi ? '= Thu nhập tính thuế năm' : '= Annual assessable income', `${n(r.assessable)}${d}`, true)
          + bracketRows(r.brackets)
          + row(vi ? 'Thuế cả năm' : 'Annual tax', `${n(r.tax)}${d}`, true)
          + row(vi ? '− Đã khấu trừ' : '− Withheld', `${n(r.withheld)}${d}`)
          + `</div>`;
        h += note(vi ? 'Biểu lũy tiến năm = ngưỡng bậc tháng × 12; người phụ thuộc × số tháng giảm trừ (tối đa 12).' : 'Annual brackets = monthly thresholds × 12; dependents × months claimed (max 12).');
        h += note(vi ? 'Hạn nộp hồ sơ quyết toán theo thông báo của cơ quan thuế (trước đây: cuối tháng thứ 4 năm sau).' : 'Filing deadline per the tax authority\'s notice (previously: end of the 4th month of the following year).');
      }
      h += basis;
      h += `<p class="mt-3 text-xs font-semibold text-amber-700">${vi ? 'Kết quả ước tính, đối chiếu với cơ quan thuế trước khi kê khai.' : 'Estimate only; confirm with the tax authority before filing.'}</p>`;
      out.innerHTML = h;
    };
    form.addEventListener('input', calc);
    form.addEventListener('change', calc);
    calc();
  });
</script>
