---
import { ELECTRIC_TIERS } from '../../lib/electric.js';
interface Props { lang?: 'vi' | 'en'; }
const { lang = 'vi' } = Astro.props;
const vi = lang === 'vi';
---
<div data-tool="electric" data-lang={lang} class="grid gap-5 lg:grid-cols-2">
  <form class="card grid gap-3" data-f>
    <div class="flex gap-4 text-sm font-semibold">
      <label class="flex items-center gap-1"><input type="radio" name="mode" value="kwh" checked /> {vi ? 'Từ số kWh' : 'From kWh'}</label>
      <label class="flex items-center gap-1"><input type="radio" name="mode" value="bill" /> {vi ? 'Từ số tiền' : 'From bill'}</label>
    </div>
    <div><label class="label" data-vlabel>{vi ? 'Điện dùng trong tháng (kWh)' : 'Monthly use (kWh)'}</label><input class="input text-lg" name="v" type="number" min="0" value="250" /></div>
    <div><label class="label">{vi ? 'Thuế GTGT trên hóa đơn' : 'VAT on your bill'}</label>
      <select class="input" name="vat"><option value="8">8%</option><option value="10">10%</option></select></div>
    <p class="text-xs text-slate-500">{vi ? 'Giá điện sinh hoạt 6 bậc theo Quyết định 1279/QĐ-BCT, hiệu lực 10/5/2025 (chưa gồm thuế). Biểu 5 bậc tại QĐ 14/2025/QĐ-TTg chưa áp dụng.' : 'Residential 6-tier tariff, MoIT Decision 1279/QĐ-BCT effective 10 May 2025 (before VAT).'}</p>
  </form>
  <div class="card" data-out></div>
  <div class="card lg:col-span-2">
    <h2 class="mb-2 font-bold">{vi ? 'Bảng giá điện sinh hoạt' : 'Residential tariff'}</h2>
    <div class="table-wrap"><table class="data-table"><tbody>
      {ELECTRIC_TIERS.map((t, i) => <tr><td>{vi ? 'Bậc' : 'Tier'} {i + 1}</td><td>{t.from}–{t.to === Infinity ? '' : t.to} kWh{t.to === Infinity ? (vi ? ' trở lên' : '+') : ''}</td><td class="num">{t.price.toLocaleString('vi-VN')} đ</td></tr>)}
    </tbody></table></div>
  </div>
</div>

<script>
  import { ELECTRIC_TIERS, electricBill, kwhFromBill } from '../../lib/electric.js';

  document.querySelectorAll<HTMLElement>('[data-tool="electric"]').forEach((root) => {
    const vi = root.dataset.lang !== 'en';
    const form = root.querySelector<HTMLFormElement>('[data-f]')!;
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    const lab = root.querySelector<HTMLElement>('[data-vlabel]')!;
    const n = (x: number) => Math.round(x).toLocaleString('vi-VN');
    const calc = () => {
      const f = new FormData(form);
      const vat = Number(f.get('vat')) / 100;
      const byBill = f.get('mode') === 'bill';
      lab.textContent = byBill ? (vi ? 'Số tiền trên hóa đơn (đồng, gồm thuế)' : 'Bill amount (VND, incl. VAT)') : (vi ? 'Điện dùng trong tháng (kWh)' : 'Monthly use (kWh)');
      const v = Number(f.get('v')) || 0;
      const kwh = byBill ? kwhFromBill(v, vat) : v;
      const r = electricBill(kwh, vat);
      out.innerHTML = `
        <div class="text-sm text-slate-500">${byBill ? (vi ? 'Bạn đã dùng khoảng' : 'You used about') : (vi ? 'Tiền điện phải trả' : 'Your bill')}</div>
        <div class="text-4xl font-extrabold text-brand-700">${byBill ? `${kwh.toFixed(0)} kWh` : `${n(r.total)} đ`}</div>
        <div class="mt-1 text-sm text-slate-500">${vi ? 'Chưa thuế' : 'Before VAT'} ${n(r.subtotal)} đ · ${vi ? 'Thuế' : 'VAT'} ${n(r.tax)} đ · ${vi ? 'Bình quân' : 'Avg'} ${kwh ? n(r.total / kwh) : 0} đ/kWh</div>
        <div class="table-wrap mt-4"><table class="data-table"><tbody>
          ${r.rows.filter((x) => x.kwh > 0).map((x) => `<tr><td>${vi ? 'Bậc' : 'Tier'} ${x.tier}</td><td class="num">${x.kwh.toFixed(0)} kWh × ${n(x.price)}</td><td class="num font-semibold">${n(x.amount)} đ</td></tr>`).join('')}
        </tbody></table></div>
        ${kwh > 400 ? `<p class="mt-3 text-sm text-amber-700">${vi ? `Phần trên 400 kWh bị tính giá cao nhất ${n(ELECTRIC_TIERS[5].price)} đ/kWh.` : 'Usage above 400 kWh is charged at the top tier.'}</p>` : ''}`;
    };
    form.addEventListener('input', calc);
    calc();
  });
</script>
