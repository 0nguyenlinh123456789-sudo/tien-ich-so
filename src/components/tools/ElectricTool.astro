---
import { ELECTRIC_TIERS } from '../../lib/electric.js';
import { currentVat } from '../../lib/vat.js';
interface Props { lang?: 'vi' | 'en'; }
const { lang = 'vi' } = Astro.props;
const vi = lang === 'vi';
const vat0 = Math.round(currentVat() * 100); // theo ngày build; script client chọn lại theo ngày xem trang
---
<div data-tool="electric" data-lang={lang} class="grid gap-5 lg:grid-cols-2">
  <form class="card grid content-start gap-3" data-f>
    <svg class="viz-art" viewBox="0 0 240 56" aria-hidden="true" focusable="false"><circle cx="24" cy="20" r="15" fill="#fde68a" stroke="#d97706" stroke-width="2.5"/><path d="M19 22l5-6 5 6" stroke="#b45309" stroke-width="2" fill="none" stroke-linecap="round"/><rect x="17" y="34" width="14" height="6" rx="1.5" fill="#94a3b8"/><rect x="18" y="41" width="12" height="5" rx="2" fill="#64748b"/><path d="M6 9 3 7M42 9l3-2" stroke="#f5b83d" stroke-width="2.5" stroke-linecap="round"/><path d="M58 28h18" stroke="#94a3b8" stroke-width="3" stroke-dasharray="4 4" stroke-linecap="round"/><rect x="84" y="4" width="92" height="48" rx="8" fill="#eef6ff" stroke="#2f6bff" stroke-width="2.5"/><rect x="92" y="11" width="76" height="20" rx="3" fill="#1a45b8"/><text x="130" y="26" text-anchor="middle" font-size="13" font-weight="700" font-family="monospace" fill="#fde68a">0250</text><text x="130" y="45" text-anchor="middle" font-size="10" font-weight="700" fill="#1a45b8">kWh</text><path d="M184 28h14" stroke="#94a3b8" stroke-width="3" stroke-dasharray="4 4" stroke-linecap="round"/><path d="M222 3 204 30h12l-5 23 21-31h-13l7-19z" fill="#f5b83d" stroke="#b45309" stroke-width="1.5" stroke-linejoin="round"/></svg>
    <div class="flex gap-4 text-sm font-semibold">
      <label class="flex items-center gap-1"><input type="radio" name="mode" value="kwh" checked /> {vi ? 'Từ số kWh' : 'From kWh'}</label>
      <label class="flex items-center gap-1"><input type="radio" name="mode" value="bill" /> {vi ? 'Từ số tiền' : 'From bill'}</label>
    </div>
    <div><label class="label" data-vlabel>{vi ? 'Điện dùng trong tháng (kWh)' : 'Monthly use (kWh)'}</label><input class="input text-lg" name="v" type="number" min="0" value="250" /></div>
    <div><label class="label">{vi ? 'Thuế GTGT trên hóa đơn' : 'VAT on your bill'}</label>
      <select class="input" name="vat"><option value="8" selected={vat0 === 8}>8%</option><option value="10" selected={vat0 === 10}>10%</option></select>
      <p class="mt-1 text-xs text-slate-500" data-vatnote></p></div>
    <p class="text-xs text-slate-500">{vi ? 'Giá điện sinh hoạt 6 bậc theo Quyết định 1279/QĐ-BCT, hiệu lực 10/5/2025 (chưa gồm thuế). Biểu 5 bậc tại QĐ 14/2025/QĐ-TTg chưa áp dụng.' : 'Residential 6-tier tariff, MoIT Decision 1279/QĐ-BCT effective 10 May 2025 (before VAT).'}</p>
  </form>
  <div class="card" data-out></div>
  <div class="card lg:col-span-2">
    <h2 class="mb-2 font-bold">{vi ? 'Bảng giá điện sinh hoạt' : 'Residential tariff'}</h2>
    <div class="table-wrap"><table class="data-table"><tbody>
      {ELECTRIC_TIERS.map((t, i) => <tr><td>{vi ? 'Bậc' : 'Tier'} {i + 1}</td><td>{t.from}–{t.to === Infinity ? '' : t.to} kWh{t.to === Infinity ? (vi ? ' trở lên' : '+') : ''}</td><td class="num">{t.price.toLocaleString('vi-VN')} đ</td></tr>)}
    </tbody></table></div>
  </div>
</div>

<script>
  import { ELECTRIC_TIERS, electricBill, kwhFromBill } from '../../lib/electric.js';
  import { barStack, statCards } from '../../lib/viz.js';
  import { currentVat, vatCutActive } from '../../lib/vat.js';
  // Màu bậc 1→6 tăng dần độ "nóng": xanh dương, xanh ngọc, lam, tím, cam, đỏ
  const TIER_C = [1, 2, 6, 5, 3, 4];

  document.querySelectorAll<HTMLElement>('[data-tool="electric"]').forEach((root) => {
    const vi = root.dataset.lang !== 'en';
    const form = root.querySelector<HTMLFormElement>('[data-f]')!;
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    const lab = root.querySelector<HTMLElement>('[data-vlabel]')!;
    const n = (x: number) => Math.round(x).toLocaleString('vi-VN');
    // HTML tĩnh build sẵn: chọn lại VAT mặc định theo ngày hiện tại của người xem.
    (form.elements.namedItem('vat') as HTMLSelectElement).value = String(Math.round(currentVat() * 100));
    root.querySelector<HTMLElement>('[data-vatnote]')!.textContent = vatCutActive()
      ? (vi ? 'Mặc định 8%: giảm thuế GTGT từ 10% xuống 8% đến hết 31/12/2026 (NQ 204/2025/QH15, NĐ 174/2025/NĐ-CP). Đổi sang 10% nếu hóa đơn của bạn ghi 10%.' : 'Default 8%: VAT cut from 10% to 8% until 31 Dec 2026 (Resolution 204/2025/QH15).')
      : (vi ? 'Mặc định 10%: mức giảm 8% đã hết hạn 31/12/2026 (trừ khi có nghị quyết gia hạn). Chọn 8% nếu hóa đơn của bạn vẫn ghi 8%.' : 'Default 10%: the 8% VAT cut expired on 31 Dec 2026 (unless extended).');
    const calc = () => {
      const f = new FormData(form);
      const vat = Number(f.get('vat')) / 100;
      const byBill = f.get('mode') === 'bill';
      lab.textContent = byBill ? (vi ? 'Số tiền trên hóa đơn (đồng, gồm thuế)' : 'Bill amount (VND, incl. VAT)') : (vi ? 'Điện dùng trong tháng (kWh)' : 'Monthly use (kWh)');
      const v = Number(f.get('v')) || 0;
      const kwh = byBill ? kwhFromBill(v, vat) : v;
      const r = electricBill(kwh, vat);
      out.innerHTML = `
        <div class="text-sm text-slate-500">${byBill ? (vi ? 'Bạn đã dùng khoảng' : 'You used about') : (vi ? 'Tiền điện phải trả' : 'Your bill')}</div>
        <div class="text-4xl font-extrabold text-brand-700">${byBill ? `${kwh.toFixed(0)} kWh` : `${n(r.total)} đ`}</div>
        <div class="mt-3">${statCards([
          { label: vi ? 'Tổng tiền' : 'Total', value: `${n(r.total)} đ`, tone: 'brand' },
          { label: vi ? 'Chưa thuế' : 'Before VAT', value: `${n(r.subtotal)} đ`, tone: 'sky' },
          { label: vi ? `Thuế GTGT ${Math.round(vat * 100)}%` : `VAT ${Math.round(vat * 100)}%`, value: `${n(r.tax)} đ`, tone: 'amber' },
          { label: vi ? 'Bình quân / kWh' : 'Avg / kWh', value: `${kwh ? n(r.total / kwh) : 0} đ`, tone: 'green' }
        ])}</div>
        ${barStack(r.rows.filter((x) => x.kwh > 0).map((x) => ({ label: `${vi ? 'Bậc' : 'Tier'} ${x.tier} · ${x.kwh.toFixed(0)} kWh`, value: x.amount, color: `var(--viz-${TIER_C[x.tier - 1] || 1})` })), { title: vi ? 'Tiền điện theo bậc (chưa thuế)' : 'Charge by tier (before VAT)', format: (v: number) => `${n(v)} đ` })}
        <div class="table-wrap mt-4"><table class="data-table"><tbody>
          ${r.rows.filter((x) => x.kwh > 0).map((x) => `<tr><td>${vi ? 'Bậc' : 'Tier'} ${x.tier}</td><td class="num">${x.kwh.toFixed(0)} kWh × ${n(x.price)}</td><td class="num font-semibold">${n(x.amount)} đ</td></tr>`).join('')}
        </tbody></table></div>
        ${kwh > 400 ? `<p class="mt-3 text-sm text-amber-700">${vi ? `Phần trên 400 kWh bị tính giá cao nhất ${n(ELECTRIC_TIERS[5].price)} đ/kWh.` : 'Usage above 400 kWh is charged at the top tier.'}</p>` : ''}`;
    };
    form.addEventListener('input', calc);
    calc();
  });
</script>
