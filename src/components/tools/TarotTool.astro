---
import MonetizedResult from '../MonetizedResult.astro';

interface Props { lang?: 'vi' | 'en'; }
const { lang = 'vi' } = Astro.props;
const vi = lang === 'vi';
const spreads = [
  ['one', vi ? '1 lá – Thông điệp hôm nay' : '1 card – Daily message'],
  ['three', vi ? '3 lá – Quá khứ / Hiện tại / Tương lai' : '3 cards – Past / Present / Future'],
  ['love', vi ? '3 lá – Tình yêu' : '3 cards – Love'],
  ['career', vi ? '4 lá – Sự nghiệp & Tài chính' : '4 cards – Career & Money']
];
---
<div data-tool="tarot" data-lang={lang}>
  <form class="card grid gap-4 md:grid-cols-3" data-tool-form>
    <div class="md:col-span-2">
      <label class="label" for="tr-q">{vi ? 'Câu hỏi của bạn (tập trung suy nghĩ khi bốc bài)' : 'Your question (focus while drawing)'}</label>
      <input id="tr-q" name="question" class="input" data-no-url placeholder={vi ? 'VD: Công việc của tôi tháng tới thế nào?' : 'e.g. What should I focus on this month?'} />
    </div>
    <div>
      <label class="label" for="tr-s">{vi ? 'Kiểu trải bài' : 'Spread'}</label>
      <select id="tr-s" name="spread" class="input">
        {spreads.map(([v, l]) => <option value={v} selected={v === 'three'}>{l}</option>)}
      </select>
    </div>
    <div class="md:col-span-3"><button class="btn-primary" type="submit">🃏 {vi ? 'Xào bài & Bốc' : 'Shuffle & Draw'}</button></div>
  </form>

  <MonetizedResult context="destiny" lang={lang}>
    <div data-out="question" class="mb-4 text-slate-600 italic"></div>
    <div data-out="cards" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4"></div>
    <div slot="bottom"><div data-out="reading" class="prose-lite mt-6"></div></div>
  </MonetizedResult>
</div>

<script>
  import { drawSpread } from '../../lib/tarot.js';
  import { escapeHtml } from '../../lib/format.js';
  import { showResult } from '../../scripts/form-state.js';

  // Minh họa đầu thẻ: ba lá bài xòe + trăng sao (aria-hidden).
  const ART = '<svg class="viz-art" viewBox="0 0 240 56" aria-hidden="true" focusable="false"><g stroke="#f5b83d" stroke-width="1.5"><rect x="88" y="8" width="28" height="44" rx="4" fill="#4c1d95" transform="rotate(-14 102 30)"/><rect x="106" y="4" width="28" height="44" rx="4" fill="#6d28d9"/><rect x="124" y="8" width="28" height="44" rx="4" fill="#7c3aed" transform="rotate(14 138 30)"/></g><path d="M120 18l2.5 6 6 .5-4.6 4 1.4 6-5.3-3.3-5.3 3.3 1.4-6-4.6-4 6-.5z" fill="#fde68a"/><circle cx="40" cy="26" r="12" fill="#fde68a"/><circle cx="46" cy="22" r="11" fill="#fff"/><g fill="#a78bfa"><circle cx="70" cy="12" r="2"/><circle cx="180" cy="16" r="2.5"/><circle cx="205" cy="38" r="2"/><circle cx="18" cy="46" r="1.5"/></g></svg>';
  // Họa tiết mặt sau lá bài (SVG, aria-hidden).
  const BACK = '<svg class="tarot-pat" viewBox="0 0 100 160" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect x="6" y="6" width="88" height="148" rx="6" fill="none" stroke="#fcd34d" stroke-opacity=".7"/><rect x="11" y="11" width="78" height="138" rx="4" fill="none" stroke="#fcd34d" stroke-opacity=".35"/><circle cx="50" cy="80" r="22" fill="none" stroke="#fcd34d" stroke-opacity=".6"/><path d="M50 52l5 22 22 6-22 6-5 22-5-22-22-6 22-6z" fill="#fde68a" fill-opacity=".85"/><g fill="#fde68a" fill-opacity=".6"><circle cx="50" cy="24" r="3"/><circle cx="50" cy="136" r="3"/><circle cx="22" cy="40" r="1.5"/><circle cx="78" cy="40" r="1.5"/><circle cx="22" cy="120" r="1.5"/><circle cx="78" cy="120" r="1.5"/></g></svg>';

  const T = {
    vi: { reversed: 'Ngược', upright: 'Xuôi', reading: 'Luận giải tổng hợp', major: 'Lá Ẩn Chính – sự kiện lớn, bài học quan trọng', majorCount: 'Số lá Ẩn Chính', flip: 'Chạm để lật', q: 'Câu hỏi',
      sum: (n: number) => n >= 2 ? 'Nhiều lá Ẩn Chính xuất hiện: đây là giai đoạn mang tính bước ngoặt, các quyết định lúc này có ảnh hưởng lâu dài.' : 'Phần lớn là lá Ẩn Phụ: vấn đề nằm trong tầm kiểm soát của bạn qua các hành động hằng ngày.',
      rev: (n: number) => n >= 2 ? 'Có nhiều lá ngược – năng lượng đang bị cản trở, hãy chậm lại và xem xét điều gì đang kìm hãm bạn.' : 'Năng lượng nhìn chung thuận chiều, hãy tự tin hành động.' },
    en: { reversed: 'Reversed', upright: 'Upright', reading: 'Overall reading', major: 'Major Arcana – big lessons and turning points', majorCount: 'Major Arcana count', flip: 'Tap to flip', q: 'Question',
      sum: (n: number) => n >= 2 ? 'Several Major Arcana: this is a pivotal period; decisions now have long-term impact.' : 'Mostly Minor Arcana: the situation is in your hands through everyday actions.',
      rev: (n: number) => n >= 2 ? 'Several reversed cards – energy is blocked; slow down and see what is holding you back.' : 'The energy is mostly flowing – act with confidence.' }
  };

  document.querySelectorAll<HTMLElement>('[data-tool="tarot"]').forEach((root) => {
    const lang = (root.dataset.lang === 'en' ? 'en' : 'vi') as 'vi' | 'en';
    const L = T[lang];
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const form = root.querySelector<HTMLFormElement>('[data-tool-form]')!;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const q = String(fd.get('question') || '').trim();
      const draw = drawSpread(String(fd.get('spread') || 'three'));
      out('question').innerHTML = `${ART}${q ? `<span>${escapeHtml(`${L.q}: “${q}”`)}</span>` : ''}`;
      out('cards').innerHTML = draw.map((d: any, i: number) => `
        <button type="button" class="tarot-card h-80 w-full min-w-0 text-left" data-idx="${i}" aria-label="${escapeHtml(`${L.flip}: ${d.position[lang]} – ${d.card.name[lang]} (${d.reversed ? L.reversed : L.upright})`)}">
          <div class="tarot-inner h-full w-full">
            <div class="tarot-face tarot-cover grid place-items-center rounded-2xl text-white shadow-lg">
              ${BACK}
              <div class="relative text-center"><div class="text-sm font-semibold">${escapeHtml(d.position[lang])}</div><div class="mt-1 text-xs opacity-70">${L.flip}</div></div>
            </div>
            <div class="tarot-face tarot-back-face tarot-front flex flex-col overflow-auto rounded-2xl p-4 shadow-lg">
              <div class="flex items-center justify-between gap-2 text-xs font-semibold uppercase text-amber-700"><span class="min-w-0 truncate">${escapeHtml(d.position[lang])}</span><span class="shrink-0">${i + 1}/${draw.length}</span></div>
              <div class="tarot-sym my-3 text-center text-5xl ${d.reversed ? 'rotate-180' : ''}" aria-hidden="true">${escapeHtml(d.card.symbol)}</div>
              <div class="text-center text-lg font-bold">${escapeHtml(d.card.name[lang])}</div>
              <div class="mt-1 text-center"><span class="tarot-dir ${d.reversed ? 'is-rev' : 'is-up'}"><span aria-hidden="true">${d.reversed ? '▼' : '▲'}</span> ${d.reversed ? L.reversed : L.upright}</span></div>
              <p class="mt-3 text-sm text-slate-700">${(d.reversed ? d.card.reversed : d.card.upright)[lang]}</p>
            </div>
          </div>
        </button>`).join('');
      out('cards').querySelectorAll<HTMLElement>('.tarot-card').forEach((c, i) => {
        c.addEventListener('click', () => c.classList.toggle('flipped'));
        setTimeout(() => c.classList.add('flipped'), 500 + i * 450);
      });
      const majors = draw.filter((d: any) => d.card.arcana === 'major').length;
      const revs = draw.filter((d: any) => d.reversed).length;
      out('reading').innerHTML = `<h2>${L.reading}</h2>
        ${draw.map((d: any) => `<h3>${escapeHtml(d.position[lang])}: ${d.card.name[lang]} (${d.reversed ? L.reversed : L.upright})</h3>
          <p>${(d.reversed ? d.card.reversed : d.card.upright)[lang]} ${d.card.arcana === 'major' ? `<em>${L.major}.</em>` : ''}</p>`).join('')}
        <p><b>${L.majorCount}: ${majors}/${draw.length}.</b> ${L.sum(majors)}</p>
        <p>${L.rev(revs)}</p>`;
      showResult(root);
      root.querySelector('[data-monetized]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>

