---
// Tính tuổi nghỉ hưu. Logic: src/lib/retirement-age.js (NĐ 135/2020/NĐ-CP; Điều 169 BLLĐ 2019)
import { requiredMonths } from '../../lib/retirement-age.js';
interface Props { lang?: 'vi' | 'en'; }
const { lang = 'vi' } = Astro.props;
const vi = lang === 'vi';
const blk = 'flex-1 min-w-0 cursor-pointer rounded-xl border border-slate-300 p-3 text-sm has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50';
const fmt = (m: number) => (vi ? `${Math.floor(m / 12)} tuổi${m % 12 ? ` ${m % 12} tháng` : ''}` : `${Math.floor(m / 12)}y${m % 12 ? ` ${m % 12}m` : ''}`);
const years = Array.from({ length: 15 }, (_, i) => 2021 + i);
---
<div data-tool="retireage" data-lang={lang} class="grid gap-5 lg:grid-cols-2">
  <form class="card grid min-w-0 content-start gap-3" data-f>
    <div class="min-w-0"><label class="label">{vi ? 'Giới tính' : 'Sex'}</label>
      <div class="flex gap-2">
        <label class={blk}><input type="radio" name="sex" value="male" class="mr-2" checked />{vi ? 'Nam' : 'Male'}</label>
        <label class={blk}><input type="radio" name="sex" value="female" class="mr-2" />{vi ? 'Nữ' : 'Female'}</label>
      </div></div>
    <div class="flex gap-2">
      <div class="min-w-0 flex-1"><label class="label">{vi ? 'Tháng sinh' : 'Birth month'}</label><select class="input w-full min-w-0" name="month">{Array.from({ length: 12 }, (_, i) => <option value={i + 1} selected={i === 5}>{i + 1}</option>)}</select></div>
      <div class="min-w-0 flex-1"><label class="label">{vi ? 'Năm sinh' : 'Birth year'}</label><input class="input w-full min-w-0" name="year" inputmode="numeric" maxlength="4" value="1970" /></div>
    </div>
    <label class="flex min-w-0 cursor-pointer items-start gap-2 text-sm"><input type="checkbox" name="early" class="mt-1" /><span class="min-w-0 break-words">{vi ? 'Nghỉ hưu sớm (đủ 15 năm nghề nặng nhọc, độc hại hoặc vùng đặc biệt khó khăn, hoặc suy giảm khả năng lao động từ 61%) – tối đa 5 tuổi' : 'Early retirement (15+ years in arduous/hazardous jobs or extremely difficult areas, or work capacity reduced by 61%+) – up to 5 years earlier'}</span></label>
    <details class="text-xs text-slate-500"><summary class="cursor-pointer">{vi ? 'Lộ trình tuổi nghỉ hưu 2021–2035' : 'Retirement age schedule 2021–2035'}</summary>
      <table class="mt-2 w-full text-left"><thead><tr><th>{vi ? 'Năm' : 'Year'}</th><th>{vi ? 'Nam' : 'Male'}</th><th>{vi ? 'Nữ' : 'Female'}</th></tr></thead>
        <tbody>{years.map((y) => <tr><td>{y}</td><td>{fmt(requiredMonths('male', y))}</td><td>{fmt(requiredMonths('female', y))}</td></tr>)}</tbody></table></details>
  </form>
  <div class="card min-w-0" data-out></div>
</div>

<script>
  import { retirementAge, MIN_YEAR, MAX_YEAR } from '../../lib/retirement-age.js';

  document.querySelectorAll<HTMLElement>('[data-tool="retireage"]').forEach((root) => {
    const vi = root.dataset.lang !== 'en';
    const form = root.querySelector<HTMLFormElement>('[data-f]')!;
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    const get = (k: string) => String(new FormData(form).get(k) ?? '');
    const yEl = form.querySelector<HTMLInputElement>('[name="year"]')!;
    yEl.addEventListener('input', () => { yEl.value = yEl.value.replace(/\D/g, '').slice(0, 4); });
    const note = (s: string) => `<p class="mt-3 text-xs text-slate-500">${s}</p>`;
    const row = (l: string, v: string, b = false) => `<div class="flex justify-between gap-3 py-1 text-sm ${b ? 'font-semibold' : ''}"><span class="min-w-0 break-words">${l}</span><span class="min-w-0 break-words text-right">${v}</span></div>`;
    const p2 = (x: number) => String(x).padStart(2, '0');
    const en = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;
    const age = (y: number, m: number) => (vi ? `${y} tuổi${m ? ` ${m} tháng` : ''}` : `${en(y, 'year')}${m ? ` ${en(m, 'month')}` : ''}`);

    const calc = () => {
      const r = retirementAge({ sex: get('sex'), month: Number(get('month')), year: Number(get('year')), early: get('early') === 'on', now: new Date() });
      if (r.invalid) {
        out.innerHTML = `<div class="rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm font-semibold text-amber-800">${vi ? `Nhập năm sinh từ ${MIN_YEAR} đến ${MAX_YEAR}.` : `Enter a birth year from ${MIN_YEAR} to ${MAX_YEAR}.`}</div>`;
        return;
      }
      let h = `<div class="text-sm text-slate-500">${vi ? 'Tuổi nghỉ hưu' : 'Retirement age'}${r.early ? (vi ? ' (nghỉ hưu sớm)' : ' (early)') : ''}</div><div class="text-4xl font-extrabold text-brand-700 break-words">${age(r.ageYears, r.ageMonths)}</div>`;
      const left = r.reached ? (vi ? 'Đã đủ tuổi' : 'Already reached')
        : (r.leftYears || r.leftMonths) ? (vi ? `${r.leftYears} năm ${r.leftMonths} tháng` : `${en(r.leftYears, 'year')} ${en(r.leftMonths, 'month')}`)
        : (vi ? 'Đủ tuổi trong tháng này' : 'Reached this month');
      h += `<div class="mt-4 border-t pt-2">${row(vi ? 'Thời điểm nghỉ hưu' : 'Retirement date', `${p2(r.retireDay)}/${p2(r.retireMonth)}/${r.retireYear}`, true)}${row(vi ? 'Hưởng lương hưu từ' : 'Pension starts', `01/${p2(r.pensionMonth)}/${r.pensionYear}`)}${row(vi ? 'Còn lại (tính từ hôm nay)' : 'Time left (from today)', left)}</div>`;
      if (r.retireYear < 2021) h += note(vi ? 'Mốc này trước năm 2021 nên áp dụng quy định cũ (BLLĐ 2012, Luật BHXH 2014); đối chiếu với cơ quan BHXH.' : 'This falls before 2021, when the previous rules (Labour Code 2012) applied; check with the social insurance agency.');
      h += note(vi ? 'Thời điểm nghỉ hưu là kết thúc ngày cuối cùng của tháng đủ tuổi; lương hưu hưởng từ ngày 01 tháng liền kề.' : 'Retirement takes effect at the end of the last day of the month you reach the age; the pension starts on the 1st of the following month.');
      h += note(vi ? 'Điều kiện hưởng lương hưu: đủ tuổi và từ đủ 15 năm đóng BHXH (Luật BHXH 41/2024/QH15, Điều 64).' : 'Pension eligibility: retirement age plus at least 15 years of social insurance contributions (Social Insurance Law 41/2024/QH15, Art. 64).');
      h += note(vi ? 'Nghỉ hưu muộn: tối đa thêm 5 tuổi nếu thỏa thuận với người sử dụng lao động (Điều 169 k4 BLLĐ).' : 'Later retirement: up to 5 more years by agreement with the employer (Labour Code Art. 169(4)).');
      h += note(vi ? 'Một số ngành nghề đặc thù (giáo viên mầm non, quân đội, công an...) có quy định riêng.' : 'Some special occupations (preschool teachers, military, police...) have separate rules.');
      h += `<details class="mt-3 text-xs text-slate-500"><summary class="cursor-pointer">${vi ? 'Căn cứ pháp lý' : 'Legal basis'}</summary><p class="mt-1">${vi ? 'Điều 169 Bộ luật Lao động 45/2019/QH14; NĐ 135/2020/NĐ-CP (Điều 3, 4, 5, Phụ lục I, II): từ năm 2021 tuổi nghỉ hưu nam 60 tuổi 3 tháng, nữ 55 tuổi 4 tháng; sau đó mỗi năm tăng nam 3 tháng (đến 62 tuổi năm 2028), nữ 4 tháng (đến 60 tuổi năm 2035). Nghỉ hưu sớm thấp hơn tối đa 5 tuổi.' : 'Labour Code 45/2019/QH14 Art. 169; Decree 135/2020/ND-CP (Art. 3, 4, 5, Appendices I, II): from 2021 the age is 60y3m for men and 55y4m for women, rising by 3 months/year for men (to 62 in 2028) and 4 months/year for women (to 60 in 2035). Early retirement: up to 5 years lower.'}</p></details>`;
      h += `<p class="mt-3 text-xs font-semibold text-amber-700">${vi ? 'Tham khảo; quyết định chính thức theo cơ quan BHXH. Cập nhật 10/2026.' : 'Reference only; the official decision is made by the social insurance agency. Updated 10/2026.'}</p>`;
      out.innerHTML = h;
    };
    form.addEventListener('input', calc);
    form.addEventListener('change', calc);
    calc();
  });
</script>
