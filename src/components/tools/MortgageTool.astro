---
interface Props { lang?: 'vi' | 'en'; }
const { lang = 'en' } = Astro.props;
const vi = lang === 'vi';
const F = (n: string, l: string, v: string, step = 'any') => ({ n, l, v, step });
const fields = [
  F('price', vi ? 'Giá nhà ($)' : 'Home price ($)', '400000'), F('down', vi ? 'Trả trước (%)' : 'Down payment (%)', '20'),
  F('rate', vi ? 'Lãi suất (%/năm)' : 'Interest rate (%)', '6.5'), F('years', vi ? 'Thời hạn (năm)' : 'Term (years)', '30', '1'),
  F('tax', vi ? 'Thuế nhà đất ($/năm)' : 'Property tax ($/yr)', '4000'), F('ins', vi ? 'Bảo hiểm nhà ($/năm)' : 'Home insurance ($/yr)', '1500'),
  F('hoa', vi ? 'Phí HOA ($/tháng)' : 'HOA ($/mo)', '0'), F('extra', vi ? 'Trả thêm gốc ($/tháng)' : 'Extra principal ($/mo)', '0')
];
---
<div data-tool="mortgage" data-lang={lang} class="grid gap-5 lg:grid-cols-2">
  <form class="card grid grid-cols-2 gap-3" data-f>
    {fields.map((f) => <div><label class="label">{f.l}</label><input class="input" type="number" min="0" step={f.step} name={f.n} value={f.v} /></div>)}
    <p class="col-span-2 text-xs text-slate-500">{vi ? 'PMI ~0,5%/năm được cộng khi trả trước dưới 20% (ước tính).' : 'PMI is estimated at 0.5%/yr of the loan when the down payment is under 20%.'}</p>
  </form>
  <div class="card" data-out></div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-tool="mortgage"]').forEach((root) => {
    const vi = root.dataset.lang === 'vi';
    const form = root.querySelector<HTMLFormElement>('[data-f]')!;
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    const $ = (x: number) => '$' + Math.round(x).toLocaleString('en-US');
    const calc = () => {
      const f = Object.fromEntries([...new FormData(form)].map(([k, v]) => [k, Number(v) || 0]));
      const loan = f.price * (1 - f.down / 100);
      const r = f.rate / 1200, n = f.years * 12;
      if (!(n > 0) || !(loan > 0)) { out.innerHTML = ''; return; }
      const pi = r ? (loan * r) / (1 - (1 + r) ** -n) : loan / n;
      const pmi = f.down < 20 ? (loan * 0.005) / 12 : 0;
      const total = pi + f.tax / 12 + f.ins / 12 + f.hoa + pmi;
      // Amortization with extra principal.
      let bal = loan, months = 0, interest = 0;
      while (bal > 0.01 && months < 1200) { const i = bal * r; interest += i; bal -= Math.min(bal, pi - i + f.extra); months++; }
      let base = 0; { let b = loan; for (let k = 0; k < n; k++) { const i = b * r; base += i; b -= pi - i; } }
      const seg = [[pi, '#1f55e6', vi ? 'Gốc + lãi' : 'Principal & interest'], [f.tax / 12, '#0ea5e9', vi ? 'Thuế' : 'Tax'], [f.ins / 12, '#16a34a', vi ? 'Bảo hiểm' : 'Insurance'], [f.hoa + pmi, '#f59e0b', 'HOA + PMI']];
      out.innerHTML = `
        <div class="text-sm text-slate-500">${vi ? 'Trả mỗi tháng' : 'Monthly payment'}</div>
        <div class="text-5xl font-extrabold text-brand-700">${$(total)}</div>
        <div class="mt-4 flex h-3 overflow-hidden rounded-full">${seg.map(([v, c]) => `<span style="width:${(Number(v) / total) * 100}%;background:${c}"></span>`).join('')}</div>
        <div class="mt-2 grid grid-cols-2 gap-1 text-sm">${seg.map(([v, c, l]) => `<div><span class="mr-1 inline-block h-2 w-2 rounded-full" style="background:${c}"></span>${l}: <b>${$(Number(v))}</b></div>`).join('')}</div>
        <div class="table-wrap mt-4"><table class="data-table"><tbody>
          <tr><td>${vi ? 'Khoản vay' : 'Loan amount'}</td><td class="num">${$(loan)}</td></tr>
          <tr><td>${vi ? 'Tổng tiền lãi' : 'Total interest'}</td><td class="num">${$(interest)}</td></tr>
          <tr><td>${vi ? 'Trả xong sau' : 'Paid off in'}</td><td class="num">${Math.floor(months / 12)}y ${months % 12}m</td></tr>
          ${f.extra ? `<tr><td>${vi ? 'Tiết kiệm nhờ trả thêm' : 'Saved by extra payments'}</td><td class="num font-semibold text-emerald-700">${$(base - interest)}</td></tr>` : ''}
        </tbody></table></div>`;
    };
    form.addEventListener('input', calc);
    calc();
  });
</script>
