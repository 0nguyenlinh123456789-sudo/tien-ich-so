---
// Self-authored letters with no mandated legal form. Court forms (divorce) are only linked, never reproduced.
interface Props { lang?: 'vi' | 'en'; preset?: Record<string, any>; }
const { lang = 'vi', preset = {} } = Astro.props;
const start = preset.kind || 'nghiviec';
const KIND_ICON: Record<string, string> = { nghiviec: '🚪', xinviec: '💼', nghiphep: '🏖️', nghihoc: '🎒', uyquyen: '🤝', emailcv: '✉️' };
const KINDS = [['nghiviec', 'Xin nghỉ việc'], ['xinviec', 'Xin việc'], ['nghiphep', 'Xin nghỉ phép'], ['nghihoc', 'Xin nghỉ học'], ['uyquyen', 'Giấy ủy quyền'], ['emailcv', 'Email gửi CV']];
---
<div data-tool="forms" data-lang={lang} class="grid gap-5 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
  <form class="card grid min-w-0 content-start gap-3" data-f>
    <svg class="viz-art" viewBox="0 0 240 56" aria-hidden="true" focusable="false"><rect x="8" y="4" width="40" height="50" rx="4" fill="#fff" stroke="#2f6bff" stroke-width="2.5"/><path d="M16 14h24M16 22h24M16 30h24M16 38h14" stroke="#93b8ff" stroke-width="3" stroke-linecap="round"/><path d="M30 46c4-4 6 2 10-2" stroke="#1a45b8" stroke-width="2" fill="none" stroke-linecap="round"/><rect x="62" y="10" width="40" height="44" rx="4" fill="#f0fdfa" stroke="#0d9488" stroke-width="2.5"/><path d="M70 20h24M70 28h24M70 36h16" stroke="#5eead4" stroke-width="3" stroke-linecap="round"/><path d="M118 44l40-34 8 8-40 34-11 3z" fill="#fde68a" stroke="#d97706" stroke-width="2.5" stroke-linejoin="round"/><path d="M150 18l8 8" stroke="#d97706" stroke-width="2.5"/><circle cx="206" cy="30" r="20" fill="none" stroke="#e11d48" stroke-width="3"/><circle cx="206" cy="30" r="13" fill="none" stroke="#e11d48" stroke-width="1.5"/><path d="M199 30l5 5 9-10" stroke="#e11d48" stroke-width="3" fill="none" stroke-linecap="round"/></svg>
    <div class="grid grid-cols-2 gap-2 sm:grid-cols-3" data-kinds role="group" aria-label="Chọn mẫu đơn">
      {KINDS.map(([k, l]) => <button type="button" data-kind={k} aria-pressed={k === start ? 'true' : 'false'} class={`form-kind ${k === start ? 'is-on' : ''}`}><span aria-hidden="true">{KIND_ICON[k]}</span>{l}</button>)}
    </div>
    <input type="hidden" name="kind" value={start} />
    <div><label class="label">Kính gửi</label><input class="input" name="to" value="Ban Giám đốc Công ty …" /></div>
    <div class="grid grid-cols-2 gap-2">
      <div><label class="label">Họ và tên</label><input class="input" name="name" placeholder="Nguyễn Văn A" /></div>
      <div><label class="label">Ngày sinh</label><input class="input" name="dob" placeholder="01/01/1995" /></div>
    </div>
    <div class="grid grid-cols-2 gap-2">
      <div><label class="label" data-l="role">Chức vụ / Lớp</label><input class="input" name="role" /></div>
      <div><label class="label" data-l="dept">Bộ phận / Trường</label><input class="input" name="dept" /></div>
    </div>
    <div class="grid grid-cols-2 gap-2" data-dates>
      <div><label class="label" data-l="from">Từ ngày</label><input class="input" name="from" type="date" /></div>
      <div><label class="label">Đến ngày</label><input class="input" name="until" type="date" /></div>
    </div>
    <div><label class="label">Lý do</label><textarea class="input" name="reason" rows="3"></textarea></div>
    <div><label class="label">Người bàn giao / ghi chú</label><input class="input" name="handover" /></div>
    <div><label class="label">Nơi viết</label><input class="input" name="place" value="TP. Hồ Chí Minh" /></div>
    <p class="text-xs text-slate-500" data-tip></p>
  </form>
  <div class="grid content-start gap-3">
    <div class="flex gap-2"><button type="button" class="btn-primary" data-print>🖨 In / Lưu PDF</button><button type="button" class="btn-ghost" data-copy>📋 Copy</button></div>
    <article class="card font-serif text-[15px] leading-relaxed" data-doc style="min-height:560px"></article>
  </div>
</div>

<script>
  import { escapeHtml as esc } from '../../lib/format.js';
  import { gate } from '../../scripts/download-gate.js';
  document.querySelectorAll<HTMLElement>('[data-tool="forms"]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-f]')!;
    const doc = root.querySelector<HTMLElement>('[data-doc]')!;
    const tip = root.querySelector<HTMLElement>('[data-tip]')!;
    const dot = (s: string, w = 18) => (s ? `<b>${esc(s)}</b>` : '.'.repeat(w));
    const vd = (s: string) => (s ? s.split('-').reverse().join('/') : '');
    const kindIn = form.elements.namedItem('kind') as HTMLInputElement;
    const TIPS: Record<string, string> = {
      nghiviec: 'Báo trước theo Điều 35 Bộ luật Lao động 2019: ít nhất 45 ngày (HĐ không xác định thời hạn), 30 ngày (HĐ 12–36 tháng), 3 ngày làm việc (HĐ dưới 12 tháng). Một số ngành nghề đặc thù có thời hạn khác.',
      xinviec: 'Đơn xin việc nên ngắn gọn, nêu vị trí, kinh nghiệm chính và đính kèm CV.',
      nghiphep: 'Người làm đủ 12 tháng được nghỉ hằng năm ít nhất 12 ngày làm việc (Điều 113 Bộ luật Lao động 2019).',
      nghihoc: 'Nộp cho giáo viên chủ nhiệm; học sinh dưới 18 tuổi cần phụ huynh ký.',
      uyquyen: 'Giấy ủy quyền phù hợp việc đơn giản (nhận hồ sơ, nhận lương, nộp giấy tờ). Việc liên quan nhà đất, xe, tài sản lớn thường phải lập hợp đồng ủy quyền có công chứng – hỏi trước nơi tiếp nhận.',
      emailcv: 'Tiêu đề email nên ghi rõ: [Ứng tuyển] Vị trí – Họ tên. Đính kèm CV dạng PDF, đặt tên file không dấu.'
    };
    const LABELS: Record<string, [string, string, string]> = {
      nghiviec: ['Chức vụ', 'Bộ phận', 'Nghỉ từ ngày'], xinviec: ['Vị trí ứng tuyển', 'Kinh nghiệm', 'Có thể bắt đầu'],
      nghiphep: ['Chức vụ', 'Bộ phận', 'Từ ngày'], nghihoc: ['Lớp', 'Trường', 'Từ ngày'],
      uyquyen: ['Người được ủy quyền', 'CCCD người được ủy quyền', 'Hiệu lực từ ngày'], emailcv: ['Vị trí ứng tuyển', 'Tên công ty', 'Có thể bắt đầu']
    };
    const draw = () => {
      const v = Object.fromEntries(new FormData(form)) as Record<string, string>;
      const k = v.kind;
      const [lr, ld, lf] = LABELS[k];
      root.querySelector('[data-l="role"]')!.textContent = lr;
      root.querySelector('[data-l="dept"]')!.textContent = ld;
      root.querySelector('[data-l="from"]')!.textContent = lf;
      tip.textContent = TIPS[k];
      const now = new Date();
      const title = { nghiviec: 'ĐƠN XIN NGHỈ VIỆC', xinviec: 'ĐƠN XIN VIỆC', nghiphep: 'ĐƠN XIN NGHỈ PHÉP', nghihoc: 'ĐƠN XIN NGHỈ HỌC', uyquyen: 'GIẤY ỦY QUYỀN', emailcv: '' }[k];
      const me = k === 'nghihoc' ? 'Em' : 'Tôi';
      const body: Record<string, string> = {
        nghiviec: `${me} hiện đang làm việc tại vị trí ${dot(v.role)}, bộ phận ${dot(v.dept)}. Nay ${me.toLowerCase()} làm đơn này xin được nghỉ việc kể từ ngày ${dot(vd(v.from))}.</p><p>Lý do: ${dot(v.reason, 40)}.</p><p>${me} sẽ bàn giao đầy đủ công việc, tài liệu và tài sản cho ${dot(v.handover)} trước ngày nghỉ. Kính mong Ban Giám đốc xem xét, chấp thuận.`,
        xinviec: `Qua thông tin tuyển dụng, ${me.toLowerCase()} được biết Quý Công ty đang cần tuyển vị trí ${dot(v.role)}. ${me} có kinh nghiệm: ${dot(v.dept, 30)}.</p><p>${dot(v.reason, 40)}</p><p>${me} có thể bắt đầu làm việc từ ngày ${dot(vd(v.from))}. Kèm theo đơn là CV và các giấy tờ liên quan. Rất mong có cơ hội được phỏng vấn.`,
        nghiphep: `${me} là nhân viên vị trí ${dot(v.role)}, bộ phận ${dot(v.dept)}. Nay ${me.toLowerCase()} làm đơn xin nghỉ phép từ ngày ${dot(vd(v.from))} đến ngày ${dot(vd(v.until))}.</p><p>Lý do: ${dot(v.reason, 40)}.</p><p>Trong thời gian nghỉ, công việc được bàn giao cho ${dot(v.handover)}. Kính mong được chấp thuận.`,
        nghihoc: `${me} là học sinh/sinh viên lớp ${dot(v.role)}, trường ${dot(v.dept)}. ${me} xin phép được nghỉ học từ ngày ${dot(vd(v.from))} đến ngày ${dot(vd(v.until))}.</p><p>Lý do: ${dot(v.reason, 40)}.</p><p>${me} xin hứa sẽ chép bài và hoàn thành bài tập đầy đủ. Kính mong thầy/cô chấp thuận.`,
        uyquyen: `${me} ủy quyền cho ông/bà ${dot(v.role)}, số CCCD ${dot(v.dept)}, được thay mặt ${me.toLowerCase()} thực hiện công việc sau: ${dot(v.reason, 40)}.</p><p>Thời hạn ủy quyền: từ ngày ${dot(vd(v.from))} đến ngày ${dot(vd(v.until))}.</p><p>${me} chịu trách nhiệm về nội dung ủy quyền này. ${v.handover ? esc(v.handover) : ''}`
      };
      if (k === 'emailcv') {
        doc.innerHTML = `<p><b>Tiêu đề:</b> [Ứng tuyển] ${dot(v.role)} – ${dot(v.name)}</p><hr class="my-3"><p>Kính gửi ${dot(v.to, 30)},</p><p class="mt-2">Tôi là ${dot(v.name)}, xin ứng tuyển vị trí ${dot(v.role)} tại ${dot(v.dept)}.</p><p class="mt-2">${dot(v.reason, 40)}</p><p class="mt-2">Tôi có thể bắt đầu từ ngày ${dot(vd(v.from))}. CV chi tiết được đính kèm trong email này. Rất mong được trao đổi thêm với Quý Công ty trong buổi phỏng vấn.</p><p class="mt-4">Trân trọng,<br>${dot(v.name)}${v.handover ? `<br>${esc(v.handover)}` : ''}</p>`;
        return;
      }
      doc.innerHTML = `
        <p class="text-center font-bold">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</p>
        <p class="text-center font-bold underline underline-offset-4">Độc lập – Tự do – Hạnh phúc</p>
        <p class="mt-6 text-center text-xl font-bold">${title}</p>
        <p class="mt-4 text-center">Kính gửi: ${dot(v.to, 30)}</p>
        <p class="mt-4">${me} tên là: ${dot(v.name)}${v.dob ? `, sinh ngày ${esc(v.dob)}` : ''}.</p>
        <p class="mt-2">${body[k]}</p>
        <p class="mt-2">${me} xin chân thành cảm ơn!</p>
        <div class="mt-8 ml-auto w-64 text-center"><i>${esc(v.place || '')}, ngày ${now.getDate()} tháng ${now.getMonth() + 1} năm ${now.getFullYear()}</i><br><b>${k === 'uyquyen' ? 'Người ủy quyền' : 'Người làm đơn'}</b><br><i>(Ký, ghi rõ họ tên)</i><div class="h-16"></div><b>${esc(v.name || '')}</b></div>`;
    };
    root.querySelectorAll<HTMLButtonElement>('[data-kind]').forEach((b) => b.addEventListener('click', () => {
      kindIn.value = b.dataset.kind!;
      root.querySelectorAll('[data-kind]').forEach((x) => { x.classList.toggle('is-on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
      draw();
    }));
    form.addEventListener('input', draw);
    root.querySelector('[data-copy]')!.addEventListener('click', () => navigator.clipboard?.writeText(doc.innerText));
    root.querySelector('[data-print]')!.addEventListener('click', () => gate(() => {
      // Print from a hidden iframe without allow-scripts: even if markup slipped through escaping, nothing in it can run.
      const f = document.createElement('iframe');
      f.setAttribute('sandbox', 'allow-modals allow-same-origin');
      f.style.cssText = 'position:fixed;width:0;height:0;border:0;visibility:hidden';
      f.srcdoc = `<!doctype html><meta charset="utf-8"><title>Don</title><style>body{font:16px/1.7 "Times New Roman",serif;max-width:720px;margin:40px auto;padding:0 24px}.text-center{text-align:center}.font-bold,b{font-weight:700}.text-xl{font-size:20px}.underline{text-decoration:underline}.mt-2{margin-top:8px}.mt-4{margin-top:16px}.mt-6{margin-top:24px}.mt-8{margin-top:32px}.ml-auto{margin-left:auto}.w-64{width:280px}.h-16{height:64px}</style>${doc.innerHTML}`;
      f.onload = () => { f.contentWindow?.print(); setTimeout(() => f.remove(), 60000); };
      document.body.appendChild(f);
    }));
    draw();
  });
</script>
