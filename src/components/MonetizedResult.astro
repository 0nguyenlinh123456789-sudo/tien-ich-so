---
/**
 * MonetizedResult – the result & revenue frame used by tools.
 * Dynamic calculation results sit inside [data-monetized] (hidden until calculated if visible=false),
 * while Affiliate Offers, Self-Serve VIP Studio Packages (199k/499k/990k), and VietQR Support are ALWAYS visible!
 */
import AffiliateCards from './AffiliateCards.astro';
import AdSlot from './AdSlot.astro';
import ShareBox from './ShareBox.astro';
import DonateBox from './DonateBox.astro';
import { MONETIZATION, hasSmartLink } from '../lib/monetize.js';
import { t } from '../i18n/ui.js';

interface Props {
  context: 'finance' | 'destiny' | 'tools';
  lang?: 'vi' | 'en';
  title?: string;
  visible?: boolean;
  share?: boolean;
  tool?: string;
}
const { context, lang = 'vi', title, visible = false, share = true, tool } = Astro.props;
const vi = lang === 'vi';
const L = t(lang);
const smart = hasSmartLink();
const supportHref = vi ? '/ung-ho' : '/en/support';
const vipTiers = [
  {
    icon: '🌐',
    price: vi ? '199.000đ' : '$9 (199k)',
    title: vi ? 'Gắn Tên Miền Riêng (.com/.vn) & SSL Cho Portfolio' : 'Custom Domain (.com/.design) & Lifetime SSL Setup',
    cta: vi ? 'Đặt gói ngay (VietQR)' : 'Book Domain Setup',
    href: supportHref
  },
  {
    icon: '🎨',
    price: vi ? '499.000đ' : '$22 (499k)',
    title: vi ? 'Thiết Kế & Tinh Chỉnh Độc Bản Portfolio + CV 1-1' : '1-on-1 Bespoke Portfolio & ATS Resume Polish',
    cta: vi ? 'Đặt thiết kế VIP 1-1' : 'Book 1-on-1 Design',
    href: supportHref
  },
  {
    icon: '📣',
    price: vi ? '990.000đ/tháng' : '$45 / month',
    title: vi ? 'Đặt Vị Trí Tài Trợ / Quảng Bá Dịch Vụ Trên Trang' : 'Sponsored Tool Placement / Brand Feature',
    cta: vi ? 'Đặt vị trí tài trợ' : 'Book Sponsor Slot',
    href: supportHref
  }
];
---
<section data-monetized hidden={!visible} class="mt-6 scroll-mt-24">
  <div class="card">
    <h2 class="mb-4 text-xl font-bold">{title || L.result}</h2>
    <slot />
    <slot name="bottom" />
  </div>
</section>

<div class="mt-6 space-y-5 print:hidden">
  <AffiliateCards context={context} lang={lang} tool={tool} limit={2} />
  <AdSlot lang={lang} />

  <div class="rounded-2xl border border-slate-200 bg-gradient-to-br from-slate-900 via-slate-900 to-indigo-950 p-4 text-white shadow-md">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <div>
        <span class="inline-block rounded-full bg-amber-400/20 px-2.5 py-0.5 text-[10px] font-extrabold tracking-wider text-amber-300 uppercase">
          💎 {vi ? 'DỊCH VỤ VIP & HỢP TÁC TỰ ĐỘNG 24/7' : '24/7 SELF-SERVE VIP STUDIO & SPONSORSHIP'}
        </span>
        <h3 class="mt-0.5 text-sm font-extrabold text-white">
          {vi ? '⚡ Nâng cấp Hồ sơ VIP, Gắn Tên Miền Riêng hoặc Đặt Tài Trợ (Quét QR Chốt Ngay)' : '⚡ Upgrade Your Portfolio, Connect a Custom Domain, or Sponsor This Tool'}
        </h3>
      </div>
    </div>
    <div class="grid gap-2.5 sm:grid-cols-3">
      {vipTiers.map((tier) => (
        <a href={tier.href} class="group flex flex-col justify-between rounded-xl border border-white/15 bg-white/5 p-3 transition hover:border-amber-300/60 hover:bg-white/10">
          <div>
            <div class="flex items-center justify-between gap-1">
              <span class="text-xl">{tier.icon}</span>
              <span class="rounded-full bg-emerald-400/20 px-2 py-0.5 text-[10px] font-bold text-emerald-300">{tier.price}</span>
            </div>
            <div class="mt-1.5 text-xs font-extrabold text-white group-hover:text-amber-200">{tier.title}</div>
          </div>
          <div class="mt-2.5 text-[11px] font-bold text-amber-300">{tier.cta} →</div>
        </a>
      ))}
    </div>
  </div>

  {smart && (
    <div class="flex justify-center">
      <a href={MONETIZATION.smartLinkUrl} target="_blank" rel="sponsored noopener nofollow"
        class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-slate-50 px-4 py-2 text-sm text-slate-700 hover:bg-slate-100">
        <span class="rounded bg-slate-200 px-1.5 py-0.5 text-[10px] font-semibold uppercase">{L.ad}</span>
        {MONETIZATION.smartLinkLabel?.[lang] || L.sponsored}
      </a>
    </div>
  )}

  {share && <ShareBox lang={lang} />}
  <DonateBox lang={lang} compact={false} />
</div>
