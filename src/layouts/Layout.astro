---
import '../styles/fonts.css';
import '../styles/global.css';
// Self-hosted fonts: preload the regular weight (latin + vietnamese subsets). Same asset Vite emits for fonts.css.
import fontLatin400 from '@fontsource/be-vietnam-pro/files/be-vietnam-pro-latin-400-normal.woff2?url';
import fontVi400 from '@fontsource/be-vietnam-pro/files/be-vietnam-pro-vietnamese-400-normal.woff2?url';
import site from '../config/site.json';
import { donateInfo, offersFor, MONETIZATION } from '../lib/monetize.js';
import { t } from '../i18n/ui.js';
import { SECTIONS, sectionUrl, toolUrl, homeUrl } from '../data/tools.js';

interface Props {
  title: string;
  description: string;
  lang?: 'vi' | 'en';
  alternate?: string | null;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | null;
  noindex?: boolean;
}

const { title, description, lang = 'vi', alternate = null, jsonLd = null, noindex = false } = Astro.props;
const L = t(lang);
const siteName = lang === 'en' ? site.siteNameEn : site.siteName;
// build.format 'file' gives pathnames ending in .html, but the host 307-redirects those to clean URLs —
// canonical/hreflang/og:url must point at the clean URL the sitemap lists, or Google won't index.
const clean = (p: string) => p.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonical = new URL(clean(Astro.url.pathname), site.siteUrl).href;
const altLang = lang === 'en' ? 'vi' : 'en';
const altHref = alternate ? new URL(clean(alternate), site.siteUrl).href : null;
// Skip the brand suffix when it would push the title past ~60 chars (Google truncates).
const fullTitle = title.includes(siteName) || title.length + siteName.length + 3 > 62 ? title : `${title} | ${siteName}`;
const dlAd = (MONETIZATION.downloadAdHtml || '').trim();
const stickyAd = (MONETIZATION.stickyAdHtml || '').trim();
const bannerAttrs = MONETIZATION.bannerScriptAttributes || {};
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
// Never publish an empty or placeholder (example.com) address.
const email = (site.contactEmail || '').trim();
const showEmail = !!email && !/example\.com/i.test(email);
const donateUrl = (MONETIZATION.donateUrl || "").startsWith("https://") ? MONETIZATION.donateUrl : "";
const dGate = donateInfo();
const topOffer: any = offersFor('tools', lang, 1)[0];
const hasDonate = Boolean(donateUrl || dGate);
const zaloUrl = String((MONETIZATION as any).zaloUrl || '').startsWith('https://zalo.me/') ? (MONETIZATION as any).zaloUrl : '';
const pfHref = toolUrl('portfolio', lang);
const cvHref = toolUrl('documents', lang);
const supportHref = lang === 'en' ? '/en/support' : '/ung-ho';
// Organization markup on the home pages only.
const isHome = ['/', '/en', '/en/'].includes(clean(Astro.url.pathname));
if (isHome) ld.push({ '@context': 'https://schema.org', '@type': 'Organization', name: site.siteName, url: site.siteUrl, logo: new URL('/favicon.svg', site.siteUrl).href, sameAs: [] });
const fmtAmt = (n: number) => {
  const s = n.toLocaleString('vi-VN') + 'đ';
  if (n <= 10000) return `☕ ${s}`;
  if (n <= 20000) return `💛 ${s}`;
  if (n <= 50000) return `⚡ ${s} (Server)`;
  return `🚀 ${s} (VIP)`;
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="LBrjPSqoMMD7yIZr7KesS0MEdZ9d1XSJwz7ZF4UGXx0" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="alternate" hreflang={lang} href={canonical} />
    {altHref && <link rel="alternate" hreflang={altLang} href={altHref} />}
    <link rel="alternate" hreflang="x-default" href={lang === 'vi' ? canonical : (altHref || canonical)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
    <meta property="og:image" content={new URL('/og.png', site.siteUrl).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1f55e6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={fontLatin400} as="font" type="font/woff2" crossorigin />
    {lang === 'vi' && <link rel="preload" href={fontVi400} as="font" type="font/woff2" crossorigin />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj).replace(/</g, '\\u003c')} />)}
    {MONETIZATION.bannerScriptUrl && (
      <script is:inline async data-cfasync="false" src={MONETIZATION.bannerScriptUrl} {...bannerAttrs}></script>
    )}
    <!-- Cloudflare Web Analytics (free, cookieless) -->
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "4343af725375427a853c13ed23b30011"}'></script>
  </head>
  <body class={stickyAd ? 'min-h-screen pb-[72px] md:pb-0' : 'min-h-screen'}>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[70] focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:font-semibold focus:text-brand-700 focus:shadow-lg">{lang === 'en' ? 'Skip to content' : 'Bỏ qua tới nội dung'}</a>
    <header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/80 backdrop-blur-lg">
      <div class="mx-auto flex max-w-7xl items-center gap-2 px-4 py-2.5 overflow-x-auto no-scrollbar">
        <a href={homeUrl(lang)} class="flex shrink-0 items-center gap-2 whitespace-nowrap text-base font-extrabold text-brand-700">
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand-600 text-white">⚡</span>
          <span>{siteName}</span>
        </a>
        <nav class="ml-auto hidden shrink-0 items-center gap-1 whitespace-nowrap md:flex">
          <a href={pfHref} class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap rounded-full bg-gradient-to-r from-rose-600 to-amber-600 px-2.5 py-1 text-xs font-extrabold text-white shadow-xs transition hover:brightness-110">
            🎨 {lang === 'en' ? 'Portfolios' : 'Portfolio'}
          </a>
          <a href={cvHref} class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap rounded-full bg-slate-900 px-2.5 py-1 text-xs font-extrabold text-white shadow-xs transition hover:bg-slate-800">
            📄 {lang === 'en' ? 'CV & Docs' : 'CV & Hợp đồng'}
          </a>
          {Object.values(SECTIONS).map((s) => (
            <a href={sectionUrl(s.id, lang)} class="shrink-0 whitespace-nowrap rounded-full px-2.5 py-1.5 text-xs font-semibold text-slate-600 transition hover:bg-slate-100 hover:text-slate-900">
              {s.icon} {s.name[lang]}
            </a>
          ))}
          {hasDonate && (
            <a href={supportHref} class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap rounded-full border border-emerald-300 bg-emerald-50 px-2.5 py-1 text-xs font-extrabold text-emerald-800 transition hover:bg-emerald-100">
              💎 {lang === 'en' ? 'VIP / Support' : 'Ủng hộ / VIP'}
            </a>
          )}
        </nav>
        {altHref ? (
          <a href={alternate} hreflang={altLang} class="ml-auto shrink-0 whitespace-nowrap rounded-lg border border-slate-300 px-2.5 py-1 text-xs font-semibold md:ml-1">{L.langName}</a>
        ) : (
          <a href={homeUrl(altLang)} hreflang={altLang} class="ml-auto shrink-0 whitespace-nowrap rounded-lg border border-slate-300 px-2.5 py-1 text-xs font-semibold md:ml-1">{L.langName}</a>
        )}
      </div>
      <nav class="flex items-center gap-1.5 overflow-x-auto border-t border-slate-100 px-2 py-1.5 md:hidden">
        <a href={pfHref} class="inline-flex shrink-0 items-center gap-1 rounded-full bg-gradient-to-r from-rose-600 to-amber-600 px-2.5 py-1 text-xs font-extrabold whitespace-nowrap text-white">🎨 Portfolio</a>
        <a href={cvHref} class="inline-flex shrink-0 items-center gap-1 rounded-full bg-slate-900 px-2.5 py-1 text-xs font-extrabold whitespace-nowrap text-white">📄 {lang === 'en' ? 'CV & Docs' : 'CV & HĐ'}</a>
        {hasDonate && (
          <a href={supportHref} class="inline-flex shrink-0 items-center gap-1 rounded-full border border-emerald-300 bg-emerald-50 px-2.5 py-1 text-xs font-extrabold whitespace-nowrap text-emerald-800">💎 VIP</a>
        )}
        {Object.values(SECTIONS).map((s) => (
          <a href={sectionUrl(s.id, lang)} class="inline-flex items-center rounded-lg px-2.5 py-1 text-xs font-semibold whitespace-nowrap text-slate-600">{s.icon} {s.name[lang]}</a>
        ))}
      </nav>
    </header>

    {(dlAd || dGate) && (
      <div id="dl-gate" hidden data-seconds={dlAd ? (MONETIZATION.downloadAdSeconds || 5) : 0} class="fixed inset-0 z-[60] grid place-items-center bg-slate-900/70 backdrop-blur-xs p-4">
        <div class="card relative w-full max-w-lg text-left shadow-2xl">
          <button type="button" data-dl-close class="absolute top-2 right-2 grid h-9 w-9 place-items-center rounded-full text-xl text-slate-500 hover:bg-slate-100" aria-label={lang === 'en' ? 'Close' : 'Đóng'}>×</button>
          <div class="text-base font-extrabold text-slate-900">✨ {lang === 'vi' ? 'Bản thiết kế của bạn đã sẵn sàng!' : 'Your file is ready to export!'}</div>
          <button type="button" data-dl-go data-label={lang === 'vi' ? '⬇ Tải / Xuất bản ngay (Miễn phí 100%)' : '⬇ Download / Export Now (100% Free)'} class="btn-primary mt-3 w-full py-3 text-base shadow-md"></button>

          {dlAd && (
            <div class="mt-3 flex min-h-[180px] items-center justify-center overflow-hidden rounded-xl bg-slate-100" set:html={dlAd} />
          )}

          {dGate && (
            <div class="mt-4 rounded-2xl border border-emerald-200 bg-gradient-to-br from-emerald-50/90 to-amber-50/70 p-3.5">
              <div class="flex flex-wrap items-center gap-3.5">
                <div class="w-28 shrink-0 rounded-xl bg-white p-1.5 shadow-xs ring-1 ring-emerald-200" data-dl-qr set:html={dGate.amountSvgs?.[1]?.svg || dGate.svg} />
                <div class="min-w-0 flex-1">
                  <div class="text-xs font-extrabold uppercase tracking-wider text-emerald-800">☕ {lang === 'vi' ? 'Ủng hộ tác giả / Đặt Gói Thiết Kế VIP' : 'Buy the creator a coffee / Book VIP Setup'}</div>
                  <p class="mt-0.5 text-xs text-slate-600">{lang === 'vi' ? 'Quét VietQR ủng hộ phí duy trì Server hoặc đặt gắn Tên Miền Riêng (.com/.vn) cho Portfolio:' : 'Scan VietQR to support server costs or request custom domain setup:'}</p>
                  <div class="mt-1.5 flex flex-wrap items-center gap-1.5 text-xs text-slate-800">
                    <span class="font-bold">{dGate.bankName}:</span>
                    <b class="font-mono text-sm text-emerald-950 select-all">{dGate.account}</b>
                    <button type="button" data-dl-copy-acc data-acc={dGate.account} class="rounded-full border border-emerald-400 bg-white px-2 py-0.5 text-[11px] font-bold text-emerald-800 hover:bg-emerald-100">📋 {lang === 'vi' ? 'Chép STK' : 'Copy'}</button>
                  </div>
                  <div class="mt-2 flex flex-wrap gap-1.5">
                    {dGate.amountSvgs.map((a, idx) => (
                      <button type="button" data-dl-qr-amt data-svg={a.svg} class={`rounded-lg border border-slate-300 bg-white px-2 py-1 text-[11px] font-bold text-slate-800 hover:border-emerald-500 ${idx === 1 ? 'ring-2 ring-emerald-500 bg-emerald-50' : ''}`}>
                        {fmtAmt(a.amount)}
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          )}

          {topOffer && (
            <a href={topOffer.href || topOffer.url} target="_blank" rel="sponsored noopener nofollow" class="mt-3 flex items-center justify-between gap-3 rounded-xl border border-amber-200 bg-amber-50/70 px-3.5 py-2.5 text-xs transition hover:border-amber-400 hover:bg-amber-100/70">
              <div class="min-w-0 flex-1">
                <span class="rounded bg-amber-200/80 px-1.5 py-0.5 text-[10px] font-extrabold text-amber-900">{topOffer.icon || '🎁'} HOT</span>
                <b class="ml-1.5 text-slate-900">{typeof topOffer.title === 'string' ? topOffer.title : topOffer.title?.[lang]}</b>
              </div>
              <span class="shrink-0 font-extrabold text-brand-700">{typeof topOffer.cta === 'string' ? topOffer.cta : topOffer.cta?.[lang]} →</span>
            </a>
          )}
        </div>
      </div>
    )}
    {stickyAd && (
      <div id="sticky-ad" class="fixed inset-x-0 bottom-0 z-50 flex justify-center border-t border-slate-200 bg-white/95 md:hidden">
        <button type="button" class="absolute -top-11 right-1 grid h-11 w-11 place-items-center rounded-t-lg border border-b-0 border-slate-200 bg-white text-lg text-slate-600" onclick="document.body.classList.remove('pb-[72px]');this.parentElement.remove()" aria-label={lang === 'en' ? 'Close' : 'Đóng'}>×</button>
        <div class="max-h-[60px] overflow-hidden" set:html={stickyAd} />
      </div>
    )}
    <main id="main" tabindex="-1" class="outline-none mx-auto max-w-6xl px-4 py-6 md:py-10">
      <slot />
    </main>

    {hasDonate && (
      <a href={supportHref} class="fixed right-4 bottom-4 z-40 inline-flex items-center gap-1.5 rounded-full border border-emerald-400/80 bg-slate-900/95 px-3.5 py-2 text-xs font-extrabold text-white shadow-xl backdrop-blur-xs transition hover:-translate-y-0.5 hover:bg-emerald-700 print:hidden">
        <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>💎 {lang === 'en' ? 'VIP Studio & QR' : 'Gói VIP & Ủng hộ QR'}</span>
      </a>
    )}

    <footer class="mt-12 border-t border-slate-200 bg-white print:hidden">
      <div class="mx-auto grid max-w-6xl gap-6 px-4 py-8 text-sm text-slate-600 md:grid-cols-5">
        <div class="md:col-span-1">
          <div class="font-bold text-slate-900">{siteName}</div>
          <p class="mt-2">{L.disclaimer}</p>
        </div>
        {Object.values(SECTIONS).map((s) => (
          <div>
            <a href={sectionUrl(s.id, lang)} class="font-semibold text-slate-900">{s.icon} {s.name[lang]}</a>
            <p class="mt-2">{s.desc[lang]}</p>
          </div>
        ))}
      </div>
      <div class="border-t border-slate-100 py-4 text-center text-xs text-slate-500">
        © {new Date().getFullYear()} {siteName} ·
        <a class="underline" href={lang === 'en' ? '/en/privacy' : '/chinh-sach-bao-mat'}>{L.privacy}</a> ·
        <a class="underline" href={lang === 'en' ? '/en/terms' : '/dieu-khoan'}>{lang === 'en' ? 'Terms' : 'Điều khoản'}</a> ·
        {lang === 'vi' && <><a class="underline" href="/van-ban-moi">Văn bản pháp luật mới</a> · <a class="underline" href="/bieu-mau-nha-nuoc">Biểu mẫu nhà nước</a> ·</>}
        <a class="underline" href={lang === 'en' ? '/en/about' : '/gioi-thieu'}>{lang === 'en' ? 'About' : 'Giới thiệu'}</a> ·
        <a class="underline" href={lang === 'en' ? '/en/contact' : '/lien-he'}>{lang === 'en' ? 'Contact' : 'Liên hệ'}</a>
        {showEmail && <> · <a class="underline" href={`mailto:${email}`}>{email}</a></>}
        {zaloUrl && <> · <a class="underline" href={zaloUrl} target="_blank" rel="noopener nofollow">Zalo</a></>}
        {hasDonate && <> · <a class="font-semibold text-brand-700 underline" href={supportHref}>{lang === 'en' ? '☕ Support & VIP' : '☕ Ủng hộ & Dịch vụ VIP'}</a></>}
      </div>
    </footer>
  </body>
</html>
