---
import Layout from '../layouts/Layout.astro';
import catalog from '../data/official-forms.json';
import legal from '../data/legal-updates.json';

const forms = catalog.forms || [];
const verified = forms.filter((f: any) => f.status === 'verified');
const pending = forms.filter((f: any) => f.status !== 'verified');
const checked = new Date(catalog.verifiedAt + 'T00:00:00').toLocaleDateString('vi-VN');
// Newest documents the daily watcher tagged as forms/procedures – a hint that a form may have changed.
const formNews = (legal.items || []).filter((i: any) => i.topics.includes('bieumau')).slice(0, 5);
const host = (u: string) => { try { return new URL(u).hostname; } catch { return u; } };
---
<Layout title="Biểu mẫu nhà nước mới nhất – đã đối chiếu nguồn chính thống" description="Mẫu đơn, tờ khai hành chính đang áp dụng: trợ cấp thất nghiệp, đăng ký hộ kinh doanh, cư trú, quyết toán thuế TNCN, kết hôn – kèm căn cứ pháp lý và link cổng .gov.vn." lang="vi">
  <nav class="mb-3 text-sm text-slate-500"><a href="/" class="hover:text-brand-700">Trang chủ</a> / Biểu mẫu nhà nước</nav>
  <h1 class="text-3xl font-black md:text-4xl">Biểu mẫu nhà nước đang áp dụng</h1>
  <p class="mt-2 max-w-3xl text-slate-600">Mỗi mẫu được đối chiếu trên cổng thông tin chính thức (.gov.vn). Mẫu nào các nguồn còn mâu thuẫn sẽ <b>không ghi số hiệu</b> mà dẫn thẳng tới trang thủ tục chính thức – nơi luôn cung cấp đúng mẫu đang dùng.</p>
  <p class="mt-1 text-xs text-slate-500">Kiểm tra lần gần nhất: {checked}</p>

  {formNews.length > 0 && (
    <div class="mt-5 rounded-xl bg-amber-50 p-4 text-sm text-amber-900 ring-1 ring-amber-200">
      <b>Văn bản mới về thủ tục, biểu mẫu:</b>
      <ul class="mt-1 list-disc pl-5">{formNews.map((i: any) => <li><a class="underline" href={i.url} target="_blank" rel="noopener">{i.code}</a> – {i.title}</li>)}</ul>
    </div>
  )}

  <h2 class="mt-8 text-xl font-bold">✅ Đã xác minh</h2>
  <div class="mt-3 grid gap-4 md:grid-cols-2">
    {verified.map((f: any) => (
      <article class="card">
        <div class="text-xs font-semibold tracking-wide text-slate-500 uppercase">{f.category}</div>
        <h3 class="mt-1 text-lg font-bold text-slate-900">{f.name}</h3>
        <div class="mt-2 flex flex-wrap gap-2 text-xs">
          <span class="rounded-md bg-emerald-600 px-2 py-0.5 font-semibold text-white">{f.code}</span>
          {f.effective && <span class="rounded-md bg-slate-100 px-2 py-0.5 text-slate-700">Áp dụng từ {f.effective}</span>}
        </div>
        <p class="mt-2 text-sm"><b>Căn cứ:</b> {f.basis}</p>
        <p class="mt-1 text-sm text-slate-600">{f.note}</p>
        <a href={f.officialUrl} target="_blank" rel="noopener" class="btn-primary mt-3 py-2 text-sm">Mở trang chính thức ({host(f.officialUrl)}) →</a>
        <p class="mt-2 text-xs text-slate-500">Nguồn đối chiếu: {f.sources.map((s: string, n: number) => <><a class="underline" href={s} target="_blank" rel="noopener">{host(s)}</a>{n < f.sources.length - 1 ? ', ' : ''}</>)}</p>
      </article>
    ))}
  </div>

  <h2 class="mt-10 text-xl font-bold">🔎 Đang xác minh – dùng trang thủ tục chính thức</h2>
  <div class="mt-3 grid gap-4 md:grid-cols-2">
    {pending.map((f: any) => (
      <article class="card">
        <div class="text-xs font-semibold tracking-wide text-slate-500 uppercase">{f.category}</div>
        <h3 class="mt-1 text-lg font-bold text-slate-900">{f.name}</h3>
        <p class="mt-2 text-sm text-amber-800">{f.basis}</p>
        <p class="mt-1 text-sm text-slate-600">{f.note}</p>
        <a href={f.officialUrl} target="_blank" rel="noopener" class="btn-ghost mt-3 py-2 text-sm">Lấy mẫu tại {host(f.officialUrl)} →</a>
      </article>
    ))}
  </div>

  <p class="mt-8 text-xs text-slate-500">Thông tin tra cứu nhanh, không thay thế văn bản gốc. Trước khi nộp hồ sơ, hãy xem hướng dẫn trên trang thủ tục hoặc hỏi cơ quan tiếp nhận. Xem thêm <a class="underline" href="/van-ban-moi">văn bản pháp luật mới</a>.</p>
</Layout>
